{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],
  "timezone": "America/New_York",
  "schedule": ["before 9am on monday"],
  "semanticCommits": "enabled",
  "minimumReleaseAge": "10 days",
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)home/\\.chezmoiexternal\\.toml\\.tmpl$/"
      ],
      "matchStrings": [
        "url = \"https://github\\.com/(?<packageName>[^/]+/[^/]+)/archive/(?<currentValue>v?\\d[^/]+)\\.tar\\.gz\"",
        "url = \"https://raw\\.githubusercontent\\.com/(?<packageName>[^/]+/[^/]+)/(?<currentValue>v?\\d[^/]+)/[^\"]+\"",
        "# renovate: datasource=(?<datasource>github-releases) depName=(?<depName>[^\\s]+)[\\s\\S]*?:= \"(?<currentValue>v?\\d[^\"]+)\"",
        "url = \"https://github\\.com/(?<packageName>[^/]+/[^/]+)/releases/download/(?<currentValue>v?\\d[^/]+)\\.zip\""
      ],
      "datasourceTemplate": "github-tags"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)home/dot_pi/agent/modify_settings\\.json$/"
      ],
      "matchStrings": [
        "npm:(?<packageName>(?:@[^/]+/)?[^@\\s\"]+)@(?<currentValue>[0-9][^\\s\",]+)"
      ],
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)home/\\.chezmoidata/(darwin|linux)/packages\\.yaml$/"
      ],
      "matchStrings": [
        "- \"?(?<packageName>(?:@[^/\\s\"]+/)?[^@\\s\"]+)@(?<currentValue>[0-9][^\\s\",\\n]+)\"?"
      ],
      "datasourceTemplate": "npm"
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["home/.chezmoiexternal.toml.tmpl"],
      "groupName": "chezmoi externals",
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["home/dot_pi/agent/modify_settings.json"],
      "groupName": "pi packages"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchFileNames": [
        "home/.chezmoidata/darwin/packages.yaml",
        "home/.chezmoidata/linux/packages.yaml"
      ],
      "groupName": "pnpm global packages",
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash"
    }
  ]
}
