#!/usr/bin/env bash
# bootstrap-op-connect-token — provision a 1Password Connect token for this machine,
# store it in Keychain, and optionally run chezmoi init.
#
# Token lifecycle (all via account-mode op, Connect env vars unset):
#   Keychain hit                       → reuse (fast path)
#   Active token in Connect + no Keychain → revoke old, create fresh 7-day token
#   No active token                    → create fresh 7-day token
#
# macOS:    token stored in Keychain; ~/.zprofile reads it at login (never on disk).
# Headless: token exported as OP_CONNECT_TOKEN for the current session.
#
# Usage:
#   bootstrap-op-connect-token (--personal | --work) [--apply] [--headless]
#
#   --personal   Provision the 'personal' Connect token
#   --work       Provision the 'work' Connect token
#   --apply      Run 'chezmoi init --apply nlopez' after storing the token
#   --headless   Export token as OP_CONNECT_TOKEN instead of writing to Keychain

set -euo pipefail

KEYCHAIN_SERVICE="chezmoi-op-connect"
KEYCHAIN_ACCOUNT="token"
CONNECT_SERVER="k8s_home"
CONNECT_VAULT="evjh25ux2mnoufaut6qhvm2pdi"
TOKEN_EXPIRY="7d"
OP_ACCOUNT_HOST="my.1password.com"

info() { printf "✓  %s\n" "$*"; }
warn() { printf "ℹ  %s\n" "$*" >&2; }
err()  { printf "❌ %s\n" "$*" >&2; exit 1; }

# ── Arg parsing ───────────────────────────────────────────────────────────────
TOKEN_NAME=""
HEADLESS=false
APPLY=false

for arg in "$@"; do
  case "$arg" in
    --personal) TOKEN_NAME="personal" ;;
    --work)     TOKEN_NAME="work"     ;;
    --headless) HEADLESS=true         ;;
    --apply)    APPLY=true            ;;
    *) err "Unknown argument: $arg"   ;;
  esac
done

[[ -n "$TOKEN_NAME" ]] || err "Must specify --personal or --work."

# ── Preflight ─────────────────────────────────────────────────────────────────
command -v op &>/dev/null \
  || err "1Password CLI (op) not found. Install it: https://1password.com/downloads/command-line/"

# Always invoke op in account mode — never Connect mode.
op_acct() { env -u OP_CONNECT_HOST -u OP_CONNECT_TOKEN OP_ACCOUNT="$OP_ACCOUNT_HOST" op "$@"; }

op_acct account get &>/dev/null \
  || err "Not signed in to 1Password ($OP_ACCOUNT_HOST). Run: op signin --account $OP_ACCOUNT_HOST"

# ── 1. Keychain fast path ─────────────────────────────────────────────────────
TOKEN=""
if command -v security &>/dev/null; then
  TOKEN=$(security find-generic-password -s "$KEYCHAIN_SERVICE" -a "$KEYCHAIN_ACCOUNT" -w 2>/dev/null) || true
fi

if [[ -n "$TOKEN" ]]; then
  info "Token loaded from macOS Keychain."
else
  # ── 2. Check Connect for an existing active token ─────────────────────────
  # The JWT is only available at creation time — if it is not in Keychain it is
  # unrecoverable. Revoke any active stale entry so the list stays clean, then
  # create a new one.
  existing_id=$(
    op_acct connect token list --format json \
      | python3 -c "
import json, sys
tokens = json.load(sys.stdin)
name = sys.argv[1]
active = sorted(
    [t for t in tokens if t['name'] == name and t['state'] == 'ACTIVE'],
    key=lambda t: t.get('created_at', ''),
    reverse=True,
)
print(active[0]['id'] if active else '', end='')
" "$TOKEN_NAME"
  ) || true

  if [[ -n "$existing_id" ]]; then
    warn "Active '$TOKEN_NAME' token (id: $existing_id) found but not in Keychain — revoking."
    op_acct connect token delete "$existing_id"
    info "Stale token revoked."
  fi

  # ── 3. Create a fresh token ───────────────────────────────────────────────
  info "Creating '$TOKEN_NAME' Connect token (expires in ${TOKEN_EXPIRY})…"
  TOKEN=$(op_acct connect token create "$TOKEN_NAME" \
    --server     "$CONNECT_SERVER" \
    --vault      "$CONNECT_VAULT"  \
    --expires-in "$TOKEN_EXPIRY")

  [[ -n "$TOKEN" ]] || err "op connect token create returned an empty value."
  info "Token created."
fi

# ── 4. Persist ────────────────────────────────────────────────────────────────
if command -v security &>/dev/null; then
  security delete-generic-password -s "$KEYCHAIN_SERVICE" -a "$KEYCHAIN_ACCOUNT" 2>/dev/null || true
  security add-generic-password \
    -s "$KEYCHAIN_SERVICE" \
    -a "$KEYCHAIN_ACCOUNT" \
    -w "$TOKEN"            \
    -l "Chezmoi – 1Password Connect Token"
  info "Token stored in macOS Keychain."
fi

if [[ "$HEADLESS" == true ]]; then
  export OP_CONNECT_TOKEN="$TOKEN"
fi

# ── 5. Run chezmoi ────────────────────────────────────────────────────────────
if [[ "$APPLY" == true ]]; then
  echo ""
  info "Running chezmoi init --apply…"
  chezmoi init --apply nlopez
  info "Done! chezmoi is bootstrapped."
else
  printf "\nTo finish, run:\n    chezmoi init --apply nlopez\n"
fi
