{{- /* .chezmoiignore is always interpreted as a template — no .tmpl suffix needed. */ -}}

# ── Work-only files ────────────────────────────────────────────────────────────
{{- if or (not .work) .headless }}
.zshrc_local
.finicky.js
{{ end -}}

# ── oh-my-zsh: keep only tracked plugins; ignore caches and generated files ───
!.local/share/oh-my-zsh/plugins
{{ range .zshPlugins -}}
!.local/share/oh-my-zsh/plugins/{{ . }}
!.local/share/oh-my-zsh/plugins/{{ . }}/**
{{ end -}}
.local/share/oh-my-zsh/cache/**
.local/share/oh-my-zsh/plugins/**
.local/share/oh-my-zsh/templates/**
.local/share/oh-my-zsh/custom/themes/powerlevel10k/**/*.zwc

# ── OMLX: darwin personal-only ───────────────────────────────────────────────
{{ if or (ne .chezmoi.os "darwin") .work -}}
.omlx/**
{{ else -}}
.omlx/cache/**
.omlx/logs/**
.omlx/stats.json
{{ end -}}
{{ if .work -}}
.chezmoiscripts/darwin/run_after_omlx-chat-template.sh
.chezmoiscripts/darwin/run_once_after_01-omlx-models.sh
{{ end -}}
# models are now in ~/.local/share/omlx/models (redirected via settings.json)
.local/share/omlx/models/**
.local/share/omlx/**

# ── OS-specific scripts ────────────────────────────────────────────────────────
{{ if ne .chezmoi.os "darwin" -}}
.chezmoiscripts/darwin/**
Library/Application Support/espanso/**
Library/Fonts
Library/Preferences/com.knollsoft.Rectangle.plist
{{ end -}}
{{ if eq .chezmoi.os "darwin" -}}
.local/share/fonts
{{ end -}}
{{ if or (eq .chezmoi.os "darwin") (eq .chezmoi.osRelease.id "aurora") -}}
.chezmoiscripts/linux-debian/**
{{ end -}}
{{ if or (eq .chezmoi.os "darwin") (ne .chezmoi.osRelease.id "aurora") -}}
.chezmoiscripts/linux/**
{{ end -}}

# ── Headless machines: no GUI config ──────────────────────────────────────────
{{ if .headless -}}
.config/zed
.config/ghostty
{{ end -}}

# ── Workspace environments: skip git config so the host identity is preserved ─
{{ if env "IN_WORKSPACES" -}}
.config/git/config
.config/git/config_nlopez
.config/git/allowed_signers
{{ end -}}

# ── Personal-only files ────────────────────────────────────────────────────────
{{ if not .personal -}}
.config/rclone/rclone.conf
{{ end -}}

# ── Work-only files ────────────────────────────────────────────────────────────
{{ if not .work -}}
.pi/agent/mcp.json
{{ end -}}

# ── Age encryption: exclude the other machine class's secrets directory ────────
{{ if not .work -}}
.config/work-secrets
.config/git/config_work
.config/git/config_work_id
{{ end -}}
{{ if not .personal -}}
.config/personal-secrets
{{ end -}}

# ── ~/.local/bin: conditional scripts ─────────────────────────────────────────
{{ if or (not .work) (ne .chezmoi.os "darwin") -}}
.local/bin/brew
{{ end -}}
{{ if ne .chezmoi.os "darwin" -}}
.local/bin/gitcache
{{ end -}}
{{ if not (lookPath "podman") -}}
.local/bin/docker
{{ end -}}
.local/bin/zed

# ── XDG: generated/runtime files at new locations ────────────────────────────────
# Homebrew lock file (regenerated by brew bundle; not source-controlled)
.config/brew/Brewfile.lock.json
# Terraform data dir: checkpoint cache, plugins — not chezmoi-managed, leave untouched
.terraform.d/**

# ── Git bookkeeping: empty-dir markers — never deployed ───────────────────────
**/.gitkeep
home/dot_config/zsh/*.bak
home/dot_config/rclone/*.bak
home/dot_omlx/*.bak
