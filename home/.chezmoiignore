{{- /* .chezmoiignore is always interpreted as a template — no .tmpl suffix needed. */ -}}

# ── Python bytecode ────────────────────────────────────────────────────────────
# Importing a source module (tests, linters) writes __pycache__ next to it.
**/__pycache__
**/__pycache__/**

# ── Work-only files ────────────────────────────────────────────────────────────
{{- if or (not .work) .headless }}
.zshrc_local
.finicky.js
{{ end -}}

# ── OMLX: darwin personal-only ───────────────────────────────────────────────
{{ if or (ne .chezmoi.os "darwin") .work -}}
.omlx/**
{{ else -}}
.omlx/cache/**
.omlx/logs/**
.omlx/stats.json
{{ end -}}
# models live in ~/.local/share/omlx/models (redirected via settings.json)
.local/share/omlx/**

# ── OS-specific scripts ────────────────────────────────────────────────────────
{{ if ne .chezmoi.os "darwin" -}}
.chezmoiscripts/darwin/**
Library/Application Support/espanso/**
Library/Preferences/com.knollsoft.Rectangle.plist
{{ end -}}
{{ if eq .chezmoi.os "darwin" -}}
# ── Library: ignore everything except explicitly managed subdirs ──────────────
# (`Library/**` would also match `Library` itself and ignore the whole tree.)
Library/*
!Library/LaunchAgents
!Library/Application Support
!Library/Preferences
{{ end -}}
{{ if eq .chezmoi.os "darwin" -}}
.chezmoiscripts/linux/**
{{ end -}}

# ── Headless machines: no GUI config ──────────────────────────────────────────
{{ if .headless -}}
.config/zed
.config/ghostty
.config/1Password
.config/alacritty
.config/BraveSoftware
.config/brave-origin-flags.conf
.config/environment.d
# age is not configured on headless machines (no 1Password to fetch the
# identity), so encrypted sources must be ignored or chezmoi errors on them.
.config/work-secrets
.config/git/config_work
.config/git/config_work_id
# without encryption configured chezmoi keeps the .age suffix in target names
.zshrc_local.age
.finicky.js.age
.config/git/config_work.age
.config/git/config_work_id.age
{{ end -}}

# ── Linux desktop-only: Hyprland + niri + Noctalia ───────────────────────────
{{ if or (ne .chezmoi.os "linux") .headless -}}
.config/hypr
.config/niri
.config/noctalia
.local/state/noctalia
.config/BraveSoftware/Brave-Origin/NativeMessagingHosts
{{ end -}}

# ── Work machines and workspaces: ~/.gitconfig owns identity and signing
#    (and, on workspaces, credentials). config.tmpl still deploys (defaults + aliases) but drops its
#    identity includes, so the identity files below are skipped. ─────────────
{{ if .externalgit -}}
.config/git/config_nlopez
.config/git/allowed_signers
{{ end -}}
{{ if .workspace -}}
# ssh config + keys are generated by Workspaces (agent forwarding, secrets)
.ssh
{{ end -}}

# ── Personal-only files ────────────────────────────────────────────────────────
{{ if not .personal -}}
.config/rclone/rclone.conf
{{ end -}}
# Engram Cloud client config: personal, non-headless (1Password token)
{{ if or (not .personal) .headless -}}
.local/share/engram/cloud.json
{{ end -}}

# ── Fast iteration: CHEZMOI_SKIP_SECRETS=1 skips files built entirely from
#    1Password reads so routine applies don't pay the `op` CLI cost ──────────
{{ if env "CHEZMOI_SKIP_SECRETS" -}}
.config/rclone/rclone.conf
.local/share/engram/cloud.json
# age-encrypted files: the identity may not be on disk when 1Password is skipped
.zshrc_local
.finicky.js
.config/work-secrets
.config/git/config_work
.config/git/config_work_id
{{ end -}}

# ── Age encryption: exclude the other machine class's secrets directory ────────
{{ if not .work -}}
.config/work-secrets
.config/git/config_work
.config/git/config_work_id
{{ end -}}
{{ if not .personal -}}
.config/personal-secrets
{{ end -}}

# ── ~/.local/bin: conditional scripts ─────────────────────────────────────────
{{ if or (not .work) (ne .chezmoi.os "darwin") -}}
.local/bin/brew
.local/bin/shims/open
{{ end -}}
{{ if and .work (eq .chezmoi.os "darwin") -}}
# Work macOS machines use the work package manager's /opt/*/shims/bin/gh instead
.local/bin/shims/gh
{{ end -}}
{{ if ne .chezmoi.os "darwin" -}}
.local/bin/gitcache
{{ end -}}
.local/bin/zed

# ── XDG: generated/runtime files at new locations ────────────────────────────────
# Homebrew lock file (regenerated by brew bundle; not source-controlled)
.config/brew/Brewfile.lock.json
# Terraform data dir: checkpoint cache, plugins — not chezmoi-managed, leave untouched
.terraform.d/**

# ── Git bookkeeping and editor backups — never deployed ───────────────────────
**/.gitkeep
**/*.bak
