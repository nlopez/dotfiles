{{/* boolean feature tags */}}
{{- $personal := false -}}{{/* true if this machine is for fun */}}
{{- $work := false -}}{{/* true if this machine is for pay */}}
{{- $wsl := false -}}{{/* true if we're running inside wsl */}}
{{- $headless := false -}}{{/* true if we're without a graphical display */}}

{{/* work around unreliable hostname on darwin */}}
{{- $hostname := .chezmoi.hostname -}}
{{- if eq .chezmoi.os "darwin" -}}
{{-   $hostname := output "scutil" "--get" "LocalHostName" | trim -}}
{{- end -}}

{{/* detect windows subsystem for linux */}}
{{- if and (eq .chezmoi.os "linux") (contains "microsoft" (.chezmoi.kernel.osrelease | lower)) -}}
{{-   $wsl = true -}}
{{- end -}}

{{- $personalHosts := list "raphael" "intelol" "wassail" "akane" }}
{{- if has $hostname $personalHosts -}}
{{-   $personal = true -}}
{{- end -}}

{{- if eq $hostname "wassail" -}}
{{-   $headless = true -}}
{{- end -}}

{{- if eq $hostname "COMP-P20H4J4Q12" -}}
{{-   $work = true -}}
{{- end -}}

