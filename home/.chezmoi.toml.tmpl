{{/* boolean feature tags — set once at chezmoi init, persisted in local config */}}
{{- $personal        := promptBoolOnce   . "personal"        "Is this a personal machine?"    -}}
{{- $work            := promptBoolOnce   . "work"            "Is this a work machine?"        -}}
{{- $headless        := promptBoolOnce   . "headless"        "Is this a headless machine?"    -}}

{{/* work-specific identifiers — stored in local config, never in source tree */}}
{{- $workemail := "" -}}
{{- if $work -}}
{{-   $workemail = promptStringOnce . "workemail" "Work email (for LLM observability tagging, e.g. you@datadoghq.com)" -}}
{{- end -}}


{{- $ephemeral := false -}}{{/* true if this machine is ephemeral, e.g.: a cloud or VM instance */}}

{{- $osID := .chezmoi.os -}}
{{- if (and (eq .chezmoi.os "linux") (hasKey .chezmoi.osRelease "id")) -}}
{{-   $osID = printf "%s-%s" .chezmoi.os .chezmoi.osRelease.id -}}
{{- end -}}


{{/* work around unreliable hostname on darwin */}}
{{- $hostname := .chezmoi.hostname -}}
{{- if eq .chezmoi.os "darwin" -}}
{{-   $hostname = output "scutil" "--get" "LocalHostName" | trim -}}
{{- end -}}




# ---------------------------------------------------------------------------
# age post-quantum encryption
# ---------------------------------------------------------------------------
# useBuiltinAge = false forces use of the external age binary (v1.3+) which
# has native ML-KEM-768 + X25519 hybrid (PQ) support.
# Skipped on headless — no 1Password to fetch the identity key.
{{- if not $headless }}
encryption    = "age"
useBuiltinAge = false

[age]
  identity = "{{ .chezmoi.homeDir }}/.local/share/chezmoi-age/identity.txt"
{{- if $work }}
  recipientsFile = "{{ .chezmoi.homeDir }}/.local/share/chezmoi-age/work-recipient.txt"
{{- else if $personal }}
  recipientsFile = "{{ .chezmoi.homeDir }}/.local/share/chezmoi-age/personal-recipient.txt"
{{- end }}
{{- end }}

{{- if not $headless }}
[onepassword]
  mode = "account"

[scriptEnv]
# AGE_KEY_OP_URI is injected into the read-source-state.pre hook (fetch-age-key.sh)
# so the age private key is on disk before chezmoi decrypts any source files.
{{- if $personal }}
  AGE_KEY_OP_URI = "op://evjh25ux2mnoufaut6qhvm2pdi/xrueqtieq2hj6qydr5m3urcoey/private-key"
{{- else if $work }}
  AGE_KEY_OP_URI = "op://ed52wahww5txzax6reg4me3bl4/fgtjfmintxb2nptvgsbspom7va/private-key"
{{- end }}
{{- end }}

# Editor — use VS Code with --new-window so --wait actually blocks until the file is closed.
# On headless machines fall back to $EDITOR / vi.
{{- if not $headless }}
[edit]
  command = "code"
  args    = ["--new-window", "--wait"]
{{- end }}

{{- if not $headless }}
# Fetch the age identity from 1Password before chezmoi reads (decrypts) source state.
[hooks.read-source-state.pre]
  command = "bash"
  args    = ["{{ .chezmoi.workingTree }}/scripts/fetch-age-key.sh"]
{{- end }}

