personal = {{ $personal }}
work = {{ $work }}
wsl = {{ $wsl }}
ephemeral = {{ $ephemeral }}
headless = {{ $headless }}

zshPlugins = [
  # fzf-tab must load before widget-wrapping plugins (zsh-autosuggestions, zsh-syntax-highlighting)
  "fzf-tab",
  "zsh-autosuggestions",
  "fzf",
  "direnv",
  "eza",
  "zsh-syntax-highlighting",
  "pure",
]

{{- if eq .chezmoi.os "windows" }}
[cd]
command = "powershell.exe"

[interpreters.json]
command = "python"
{{- end }}
