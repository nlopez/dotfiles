{{- /* Renders empty (chezmoi skips it) when every user-scope MCP server in
   ~/.claude.json is declared. Otherwise the plan shows in `chezmoi diff`.
   Declared: engram (run_after_10), kagi (30), playwright (31), the private
   servers on work machines (32) and 1password (33). Keep the conditions here
   in step with those scripts. */ -}}
{{- $keep := list "engram" "playwright" -}}
{{- if or (not .headless) .workspace }}{{ $keep = append $keep "kagi" }}{{ end -}}
{{- if not .headless }}{{ $keep = append $keep "1password" }}{{ end -}}
{{- if .work }}{{ $keep = concat $keep (keys (includeTemplate "private-mcp-servers" . | fromJson)) }}{{ end -}}
{{- $claudeJson := joinPath .chezmoi.homeDir ".claude.json" -}}
{{- $remove := list -}}
{{- if stat $claudeJson -}}
{{-   range $name, $_ := (include $claudeJson | fromJson).mcpServers | default dict -}}
{{-     if not (has $name $keep) }}{{ $remove = append $remove $name }}{{ end -}}
{{-   end -}}
{{- end -}}
{{- if $remove -}}
#!/bin/bash

# Removes every user-scope Claude Code MCP server that isn't declared.
# Declare a server in its own run_*-claude.sh.tmpl script and in the keep
# list at the top of this template to keep it.
#
# Pending changes:
{{- range $remove }}
#   remove mcp server {{ . }}
{{- end }}

set -eufo pipefail

export PATH="{{ includeTemplate "agent-path" . }}:$PATH"

command -v claude >/dev/null 2>&1 || { echo "claude not found, skipping" >&2; exit 0; }
{{ range $remove }}
claude mcp remove {{ . | squote }} --scope user
{{- end }}
{{ end -}}
