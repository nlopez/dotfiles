{{- $p := includeTemplate "private-data" . | fromYaml -}}
{{- if and .work (not .headless) (not .workspace) (not (env "CHEZMOI_SKIP_SECRETS")) $p.workspace_secrets.aws_vault_passphrase -}}
#!/bin/bash

# Push secrets from 1Password into the workspaces secret store as
# exportable secrets, so every workspace shell gets them as env vars.
# Workspaces are headless (no `op`), so this laptop is their only source.
# Re-runs whenever a secret value changes, then syncs running workspaces.

set -euo pipefail

# The workspaces CLI comes with the work package manager under /opt.
WORKSPACES=$(PATH="$PATH:$(printf '%s:' /opt/*/bin)" command -v workspaces) || {
  echo "workspace-secrets: workspaces CLI not found, skipping" >&2
  exit 0
}

printf '%s' {{ onepasswordRead "op://ed52wahww5txzax6reg4me3bl4/a5js4oov33t6qfybetuc5jypfi/credential" $p.onepassword_account | squote }} \
  | "$WORKSPACES" secrets set --export KAGI_API_KEY=-

# Passphrase for aws-vault's file backend (AWS_VAULT_BACKEND=file on workspaces).
printf '%s' {{ onepasswordRead $p.workspace_secrets.aws_vault_passphrase $p.onepassword_account | squote }} \
  | "$WORKSPACES" secrets set --export AWS_VAULT_FILE_PASSPHRASE=-

# Atuin sync credentials for workspaces (read from /run/user/$UID/secrets/ATUIN_*).
printf '%s' {{ onepasswordRead "op://ed52wahww5txzax6reg4me3bl4/j47y4ltfvf3k7pkyxrxvhd3ize/username" $p.onepassword_account | squote }} \
  | "$WORKSPACES" secrets set ATUIN_USERNAME=-
printf '%s' {{ onepasswordRead "op://ed52wahww5txzax6reg4me3bl4/j47y4ltfvf3k7pkyxrxvhd3ize/password" $p.onepassword_account | squote }} \
  | "$WORKSPACES" secrets set ATUIN_PASSWORD=-
printf '%s' {{ onepasswordRead "op://ed52wahww5txzax6reg4me3bl4/j47y4ltfvf3k7pkyxrxvhd3ize/atuin_key" $p.onepassword_account | squote }} \
  | "$WORKSPACES" secrets set ATUIN_KEY=-

# Work age identity, so workspaces can decrypt the work private data. Not
# exported: workspaces read it from /run/user/$UID/secrets/CHEZMOI_AGE_IDENTITY
# (see .chezmoi.toml.tmpl). Read from the Keychain through varlock, as chezmoi
# does (scripts/age-keychain.sh). Re-sent when the identity changes:
# {{ output "security" "find-generic-password" "-s" "chezmoi-age-identity" "-w" | sha256sum }}
"${XDG_DATA_HOME:-$HOME/.local/share}/mise/shims/varlock" run \
  -p {{ joinPath .chezmoi.workingTree "scripts/chezmoi-age.env" | squote }} \
  --filter CHEZMOI_AGE_IDENTITY --inject vars --no-redact-stdout -- \
  sh -c 'printf "%s\n" "$CHEZMOI_AGE_IDENTITY" | "$1" secrets set CHEZMOI_AGE_IDENTITY=-' sh "$WORKSPACES"

# No running workspace is not an error; new workspaces pick secrets up at creation.
"$WORKSPACES" secrets sync || echo "workspace-secrets: sync skipped (no running workspace?)" >&2
{{- end }}
