#!/bin/bash
{{- $nixBin := printf "%s/bin" (includeTemplate "nix-profile" .) }}
{{- $removals := "" }}
{{- if .packages.darwin.brew.cleanup }}
{{-   $removals = output "sh" "-c" "PATH=\"$2:$PATH\" HOMEBREW_NO_AUTO_UPDATE=1; export PATH HOMEBREW_NO_AUTO_UPDATE; printf '%s' \"$1\" | \"$3\" bundle cleanup --file=- 2>/dev/null | awk '/^Would .brew cleanup/{exit} /^Would /{p=1} p'" "sh" (includeTemplate "Brewfile" .) $nixBin (printf "%s/bin/brew" .packages.brew_prefix) | trim }}
{{- end }}
{{- if $removals }}

# brew.cleanup is on: this apply UNINSTALLS everything listed below (output of
# `brew bundle cleanup`). To keep one, declare it in
# .chezmoidata/darwin/packages.yaml. The list is part of this script, so the
# script reruns whenever something undeclared is installed.
#
{{- range splitList "\n" $removals }}
{{-   if hasPrefix "Would " . }}
# {{ . }}
{{-   else }}
#     - {{ . }}
{{-   end }}
{{- end }}
{{- end }}

# Checksum to trigger when brew packages change
# {{ .packages.darwin | toJson | sha256sum }}

# run_onchange: triggers brew bundle only when packages.yaml brew section changes
# Removes undeclared packages only when packages.darwin.brew.cleanup is true;
# otherwise installed packages are preserved (preview with `brew-cleanup`).
#
# Trust is handled declaratively via `trusted: true` in the Brewfile itself
# (Brew Bundle format: https://docs.brew.sh/Brew-Bundle-and-Brewfile#trusted).
# No imperative `brew trust` calls are needed here.

set -eufo pipefail

# `mas` and `uv` (for the Brewfile's mas/uv entries) come from the Nix profile;
# put it first so brew bundle doesn't install its own copies.
export PATH="{{ $nixBin }}:$PATH"

# HOMEBREW_BUNDLE_FILE is exported in .zprofile → ~/.config/brew/Brewfile
BREWFILE="${HOMEBREW_BUNDLE_FILE:-{{ .chezmoi.homeDir }}/.config/brew/Brewfile}"
brew bundle{{ if .packages.darwin.brew.cleanup }} --cleanup --force{{ end }} --file="${BREWFILE}"
