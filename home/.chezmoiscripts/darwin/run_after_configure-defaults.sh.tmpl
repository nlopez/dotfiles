{{- /* Renders empty (chezmoi skips it) when every key in
   .chezmoidata/darwin/defaults.yaml already has its declared value.
   Otherwise the drift shows in `chezmoi diff`. */ -}}
{{- $script := joinPath .chezmoi.workingTree "scripts/macos-plan.py" }}
{{- $defaults := deepCopy .macos.defaults }}
{{- $_ := set (index $defaults "com.knollsoft.Rectangle") "launchOnLogin" (not .headless) }}
{{- $declared := $defaults | toJson }}
{{- $plan := output "python3" $script "defaults" "plan" $declared | trim }}
{{- if $plan -}}
#!/bin/bash

# Writes the macOS defaults that differ from .chezmoidata/darwin/defaults.yaml,
# then restarts Dock, Finder or SystemUIServer as needed.
#
# Pending changes:
{{- range splitList "\n" $plan }}
#   {{ . }}
{{- end }}

set -eufo pipefail

python3 {{ $script | quote }} defaults apply <<'JSON'
{{ $declared }}
JSON
{{- end }}
