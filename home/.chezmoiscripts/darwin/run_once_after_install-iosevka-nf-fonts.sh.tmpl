#!/bin/bash
# Merge Iosevka Nerd Font subdirectories into the system font directory
# run_once: after all external sources are installed

set -eufo pipefail

{{- if eq .chezmoi.os "darwin" }}
FONT_DIR="{{ .chezmoi.homeDir }}/Library/Fonts"
{{- else if eq .chezmoi.os "linux" }}
FONT_DIR="{{ .chezmoi.homeDir }}/.local/share/fonts"
{{- end }}

# Merge Iosevka Nerd Font files
if [ -d "$FONT_DIR/iosevka-nf" ]; then
  cp "$FONT_DIR/iosevka-nf"/*.ttf "$FONT_DIR/" 2>/dev/null || true
  rm -rf "$FONT_DIR/iosevka-nf"
fi

# Merge Iosevka Term Nerd Font files
if [ -d "$FONT_DIR/iosevka-term-nf" ]; then
  cp "$FONT_DIR/iosevka-term-nf"/*.ttf "$FONT_DIR/" 2>/dev/null || true
  rm -rf "$FONT_DIR/iosevka-term-nf"
fi

echo "iosevka-nf-fonts: fonts installed to $FONT_DIR"
