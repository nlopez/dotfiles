#!/bin/bash
# Reloads tmux config, zsh panes, and any running Pi sessions after chezmoi apply.
#
# Re-runs on changes to:
#     - tmux.conf
#     - dot_zshrc.tmpl
#     - dot_zprofile.tmpl
#     - dot_zshenv.tmpl
#     - dot_oh-my-zsh/.../00_custom.zsh.tmpl

set -eo pipefail

command -v tmux >/dev/null 2>&1 || { echo "tmux: not installed, skipping."; exit 0; }
tmux ls >/dev/null 2>&1 || { echo "tmux: no server running, skipping."; exit 0; }

# ── Reload a single pane: C-c → flush → /reload ────────────────────────────────
_reload_pane() {
   local pane_id="$1"
   echo "pi: reloading pane $pane_id."
   tmux send-keys -t "$pane_id" C-c 2>/dev/null || true
   sleep 0.1
   tmux send-keys -t "$pane_id" '/reload' Enter 2>/dev/null || true
}

# ── Check pane's process tree for "pi" executable ────────────────────────────────
#   pane_pid → pane root comm == "pi"?     → yes
#   pane_pid → child comm == "pi"?        → yes
#   pane_pid → grand child comm == "pi"?  → yes
#   No pipes/subshells — return codes propagate.
_check_pane_tree() {
   local pane_pid="$1"
   local pane_comm
   pane_comm=$(ps -p "$pane_pid" -o comm= 2>/dev/null) || return 1

      [[ "$pane_comm" == "pi" ]] && return 0

   local children
   children=$(ps -o pid= -P "$pane_pid" 2>/dev/null | tr -d $'\n\r ') || children=""
       [[ -n "$children" ]] || return 1

   for c in $children; do
     local c_comm
     c_comm=$(ps -p "$c" -o comm= 2>/dev/null) || continue
          [[ "$c_comm" == "pi" ]] && return 0
   done

   for c in $children; do
     local grandchildren
     grandchildren=$(ps -o pid= -P "$c" 2>/dev/null | tr -d $'\n\r ') || continue
      [[ -n "$grandchildren" ]] || continue
      for g in $grandchildren; do
        local gc_comm
        gc_comm=$(ps -p "$g" -o comm= 2>/dev/null) || continue
           [[ "$gc_comm" == "pi" ]] && return 0
      done
   done

   return 1
}

# ── Reload ALL tmux panes with "pi" in their process tree ────────────────────────
#   Iterates ALL panes. Even when pi IS the pane root, it gets caught.
_reload_pi_sessions() {
   local found=false
   local panes
     panes=$(tmux list-panes -a -F '#{pane_id} #{pane_pid}') || panes=""
     local pane_id pane_pid
     while read -r pane_id pane_pid; do
          pane_id=${pane_id:-}
         pane_id=$(printf "%s" "$pane_id" | awk '{print $1}')
         pane_id=${pane_id:-}
         pane_pid=${pane_pid:-}
         pane_pid=$(printf "%s" "$pane_pid" | awk '{print $1}')
         pane_pid=${pane_pid:-}

            [[ -n "$pane_pid" ]] || continue
            [[ "$pane_pid" =~ ^[0-9]+$ ]] || continue

            if _check_pane_tree "$pane_pid"; then
               found=true
              _reload_pane "$pane_id"
            fi
      done <<< "$panes"

      [[ "$found" == "true" ]] || echo "pi: no running Pi sessions found in tmux."
}

# ── Check if any Pi-related files changed recently ───────────────────────────
PI_CHANGED=false
if [[ -d "$HOME/.pi/agent" ]]; then
      RECENT=$(find "$HOME/.pi" -mmin -2 -type f 2>/dev/null | head -5)
      if [[ -n "$RECENT" ]]; then
        PI_CHANGED=true
        echo "pi config modified recently — will reload Pi sessions"
      fi
fi

# ── 1. Reload tmux config ──────────────────────────────────────────────────
tmux source-file ~/.config/tmux/tmux.conf
echo "tmux: config reloaded."

# ── 2. Reload or queue zsh panes ───────────────────────────────────────────────
readonly RELOAD_CMD='exec env -i PATH=$PATH TERMINFO=$TERMINFO TERM=$TERM USER=$USER HOME=$HOME SHELL=$SHELL TMUX=$TMUX TMUX_PANE=$TMUX_PANE zsh --login'

reloaded=0
queued=0
skipped=0

while IFS=' ' read -r pane_id pane_pid current_cmd in_mode; do
   root_cmd=$(ps -p "$pane_pid" -o comm= 2>/dev/null | sed 's/^-//' | tr -d ' ' || echo "")

   if [[ "$root_cmd" != "zsh" ]]; then
      skipped=$((skipped + 1))
      continue
   fi

   if [[ "$current_cmd" == "zsh" && "$in_mode" == "0" ]]; then
      tmux send-keys -t "$pane_id" "$RELOAD_CMD" Enter
       reloaded=$((reloaded + 1))
   else
     tmux set-option -p -t "$pane_id" @chezmoi_reload 1
       queued=$((queued + 1))
   fi
done < <(tmux list-panes -a -F '#{pane_id} #{pane_pid} #{pane_current_command} #{pane_in_mode}')

echo "shells: ${reloaded} reloaded immediately, ${queued} queued for next prompt, ${skipped} non-zsh skipped."

# ── 3. If Pi-related files changed, reload any running Pi sessions ───────────
   if [[ "$PI_CHANGED" == "true" ]]; then
         _reload_pi_sessions
   fi
   exit 0
