{{- if .personal -}}
#!/bin/bash

# RustDesk reads its options only at startup, so restart its server after the
# modify script changes them: {{ include "Library/Preferences/com.carriez.RustDesk/modify_private_RustDesk2.toml" | sha256sum }}

set -euo pipefail

launchctl kickstart -k "gui/$(id -u)/com.carriez.RustDesk_server" 2>/dev/null || true
{{- end }}
