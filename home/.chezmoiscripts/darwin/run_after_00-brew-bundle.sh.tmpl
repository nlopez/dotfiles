{{- /* Renders empty (chezmoi skips it) when nothing declared in
   .chezmoidata/darwin/packages.yaml is missing and, with brew.cleanup on,
   nothing undeclared is installed. Otherwise the plan shows in `chezmoi diff`. */ -}}
{{- $nixBin := printf "%s/bin" (includeTemplate "nix-profile" .) }}
{{- $cleanup := .packages.darwin.brew.cleanup | toString }}
{{- $plan := output "sh" "-c" "PATH=\"$1:$PATH\"; printf '%s' \"$5\" | python3 \"$2\" brew \"$3\" \"$4\"" "sh" $nixBin (joinPath .chezmoi.workingTree "scripts/package-plan.py") (printf "%s/bin/brew" .packages.brew_prefix) $cleanup (includeTemplate "Brewfile" .) | trim }}
{{- if $plan -}}
#!/bin/bash

# Installs everything in ~/.config/brew/Brewfile. With brew.cleanup on, also
# uninstalls anything undeclared (--cleanup --force); preview with `brew-cleanup`.
#
# Pending changes:
{{- range splitList "\n" $plan }}
#   {{ . }}
{{- end }}
#
# Trust is handled declaratively via `trusted: true` in the Brewfile itself
# (Brew Bundle format: https://docs.brew.sh/Brew-Bundle-and-Brewfile#trusted).

set -eufo pipefail

# `mas` and `uv` (for the Brewfile's mas/uv entries) come from the Nix profile;
# put it first so brew bundle doesn't install its own copies.
export PATH="{{ $nixBin }}:$PATH"

# HOMEBREW_BUNDLE_FILE is exported in .zprofile → ~/.config/brew/Brewfile
BREWFILE="${HOMEBREW_BUNDLE_FILE:-{{ .chezmoi.homeDir }}/.config/brew/Brewfile}"
brew bundle{{ if .packages.darwin.brew.cleanup }} --cleanup --force{{ end }} --file="${BREWFILE}"
{{- end }}
