#!/bin/bash
# Regenerate rclone mount scripts + launchd plists whenever mounts.yaml changes.
#
# Trigger hash (run_onchange — reruns when mounts.yaml content changes):
# {{ include "dot_config/rclone-mounts/mounts.yaml" | sha256sum }}

set -euo pipefail

RCLONE_MOUNTS="${HOME}/.local/bin/rclone-mounts"

if [[ ! -x "${RCLONE_MOUNTS}" ]]; then
    echo "rclone-mounts not found at ${RCLONE_MOUNTS}, skipping generate" >&2
    exit 0
fi

echo "→ rclone-mounts: regenerating scripts and plists..."
"${RCLONE_MOUNTS}" generate

# Reload any mounts that are already registered with launchd so config changes
# take effect immediately without requiring a logout/login.
CONFIG="${XDG_CONFIG_HOME:-${HOME}/.config}/rclone-mounts/mounts.yaml"
for remote in $(yq '.mounts | keys | .[]' "${CONFIG}" 2>/dev/null); do
    label="localuser.rclone-${remote}.mount"
    if launchctl list "${label}" &>/dev/null; then
        echo "→ rclone-mounts: reloading ${label}"
        launchctl kickstart -k "gui/$(id -u)/${label}" 2>/dev/null || true
    fi
done

# Refresh directory listings on all RC-enabled mounts so they pick up remote
# file changes without waiting for dir_cache_time to expire.
if [[ -x "${RCLONE_MOUNTS}" ]]; then
    echo "→ rclone-mounts: refreshing RC mount listings…"
    "${RCLONE_MOUNTS}" refresh || true
fi
