{{- /* Renders only while shields-up is on, so a correct machine adds no diff noise. */ -}}
{{- $shieldsUp := false -}}
{{- if and .personal (not .work) (lookPath "tailscale") -}}
{{- /* Empty when no daemon is reachable yet (tailscaled starts later in the apply). */ -}}
{{-   $prefs := output "sh" "-c" "tailscale debug prefs 2>/dev/null || true" | trim -}}
{{-   if $prefs -}}
{{-     $shieldsUp = ($prefs | fromJson).ShieldsUp -}}
{{-   end -}}
{{- end -}}
{{- if $shieldsUp -}}
#!/bin/bash

# Allow incoming tailnet connections (Screen Sharing, SSH) on personal Macs;
# the tailnet policy decides who may connect.

set -euo pipefail

tailscale set --shields-up=false
{{- end }}
