#!/bin/bash
# Clear the macOS quarantine attribute on the gitcache bundle so Gatekeeper
# doesn't kill the binary on first launch. Re-runs whenever the version below
# changes — keep in sync with .chezmoiexternal.toml.tmpl.
#
# gitcache version: v1.0.33

set -eufo pipefail

if [ -d "${HOME}/.local/share/gitcache" ]; then
  xattr -cr "${HOME}/.local/share/gitcache"
fi
