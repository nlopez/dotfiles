#!/bin/bash
# Loads (or reloads) the dark-notify LaunchAgent that switches the tmux theme
# when macOS appearance changes.
#
# Re-runs when the plist changes:
# {{ include (joinPath .chezmoi.sourceDir "Library/LaunchAgents/com.user.dark-notify-tmux.plist.tmpl") | sha256sum }}

set -euo pipefail

LABEL="com.user.dark-notify-tmux"
PLIST="$HOME/Library/LaunchAgents/${LABEL}.plist"

# Require dark-notify to be installed first.
if ! command -v dark-notify >/dev/null 2>&1; then
  echo "dark-notify: not installed yet — skipping agent load (will run after brew install)."
  exit 0
fi

if launchctl list "$LABEL" &>/dev/null; then
  echo "dark-notify: reloading LaunchAgent..."
  launchctl unload "$PLIST" 2>/dev/null || true
fi

launchctl load "$PLIST"
echo "dark-notify: LaunchAgent loaded."
