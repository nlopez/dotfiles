#!/usr/bin/env python3
"""Reconcile installed Pi packages with the packages declared in settings.json.

chezmoi writes the declared packages to settings.json (modify_settings.json.tmpl).
Pi installs declared packages itself, but never removes undeclared ones, so this
script:

1. Uninstalls npm packages that Pi installed but settings.json no longer declares,
   with the same `npm uninstall --prefix <npm dir>` command `pi remove` runs.
2. Runs `pi update --extensions` so Pi installs or updates every declared package
   (npm and git) now instead of at the next Pi start.

Hash trigger (chezmoi run_onchange):
{{ .pi.packages | toJson | sha256sum }}
{{ .pi.git_packages | toJson | sha256sum }}
{{ .pi.personal_only_packages | toJson | sha256sum }}
{{ .pi.work_packages | toJson | sha256sum }}
{{ .work }}
"""
import json
import os
import shutil
import subprocess
import sys

# Declared npm packages (injected by chezmoi template from .chezmoidata/pi.yaml).
# personal_only_packages are excluded on work machines.
DECLARED = [
{{- range .pi.packages }}
    "{{ . }}",
{{- end }}
{{- if not .work }}
{{- range .pi.personal_only_packages }}
    "{{ . }}",
{{- end }}
{{- end }}
{{- if .work }}
{{- range .pi.work_packages }}
    "{{ . }}",
{{- end }}
{{- range ((includeTemplate "private-data" . | fromYaml).pi | default dict).packages }}
    "{{ . }}",
{{- end }}
{{- end }}
]

AGENT_DIR = os.environ.get("PI_CODING_AGENT_DIR") or os.path.join(
    os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "pi", "agent"
)
NPM_DIR = os.path.join(AGENT_DIR, "npm")


def npm_name(spec: str) -> str | None:
    """'npm:[@scope/]name@version' → '[@scope/]name'; None for non-npm sources."""
    if not spec.startswith("npm:"):
        return None
    s = spec[4:]
    at = s.rfind("@")
    return s[:at] if at > 0 else s


# pi and npm come from the Nix profile; make them visible to this script.
os.environ["PATH"] = (
    "{{ includeTemplate "nix-profile" . }}/bin" + os.pathsep + os.environ["PATH"]
)
os.environ["PI_CODING_AGENT_DIR"] = AGENT_DIR

if not shutil.which("pi") or not shutil.which("npm"):
    print("pi or npm not found, skipping Pi package reconciliation", file=sys.stderr)
    sys.exit(0)

declared = {n for n in map(npm_name, DECLARED) if n}

installed: set[str] = set()
try:
    with open(os.path.join(NPM_DIR, "package.json")) as f:
        installed = set(json.load(f).get("dependencies", {}))
except (OSError, ValueError):
    pass

undeclared = sorted(installed - declared)
if undeclared:
    for name in undeclared:
        print(f"  - {name}")
    result = subprocess.run(["npm", "uninstall", "--prefix", NPM_DIR, *undeclared])
    if result.returncode != 0:
        print("Pi packages: npm uninstall failed", file=sys.stderr)
        sys.exit(1)

# Run from $HOME so Pi does not read project-local settings of the current directory.
result = subprocess.run(
    ["pi", "update", "--extensions", "--no-approve"], cwd=os.path.expanduser("~")
)
if result.returncode != 0:
    print("Pi packages: pi update --extensions failed", file=sys.stderr)
    sys.exit(1)

print(f"Pi packages: {len(undeclared)} removed, declared packages reconciled ✓")
