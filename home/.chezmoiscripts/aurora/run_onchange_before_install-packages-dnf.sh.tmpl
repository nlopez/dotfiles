#!/bin/bash

{{- $dnfConfig := index .packages "linux-aurora" "dnf" -}}
{{- $packages := index $dnfConfig "packages" "base" -}}

{{- if .personal -}}
{{-   $personal := index .packages "linux-aurora" "dnf" "packages" "personal" -}}
{{-   if $personal -}}
{{-     $packages = concat $packages $personal -}}
{{-   end -}}
{{- end -}}

{{- if .work -}}
{{-   $work := index .packages "linux-aurora" "dnf" "packages" "work" -}}
{{-   if $work -}}
{{-     $packages = concat $packages $work -}}
{{-   end -}}
{{- end -}}

set -eufo pipefail

# Separate 1password-cli (requires --enablerepo=1password) from other packages
{{- $has1ppackage := has "1password-cli" $packages -}}
{{- $otherPackages := without $packages "1password-cli" -}}

# Install 1password-cli with --enablerepo=1password
{{- if $has1ppackage -}}
sudo dnf install -y --enablerepo=1password 1password-cli
{{- end -}}

# Install other packages without --enablerepo flag
{{- if $otherPackages -}}
sudo dnf install -y {{ $otherPackages | sortAlpha | uniq | join " " }}
{{- end -}}
