{{- if eq .chezmoi.os "darwin" -}}
#!/bin/bash

# Remove Homebrew copies of tools now provided by mise
# (.chezmoitemplates/mise/*.toml). Runs after 02-mise-install; each copy is
# only removed once mise has the binary.
# {{ includeTemplate "mise-tools" . | sha256sum }}

set -eufo pipefail

export PATH="{{ includeTemplate "nix-profile" . }}/bin:$PATH"
MISE="{{ .chezmoi.homeDir }}/.local/bin/mise"
[ -x "$MISE" ] || { echo "mise not installed yet, skipping" >&2; exit 0; }

has() { "$MISE" which "$1" &>/dev/null; }

# brew formula:binary now from mise.
if command -v brew >/dev/null; then
  for entry in engram:engram; do
    formula="${entry%%:*}"
    bin="${entry#*:}"
    brew list --formula "$formula" &>/dev/null || continue
    has "$bin" || { echo "mise has no $bin, keeping brew $formula" >&2; continue; }
    brew uninstall "$formula" || echo "kept brew $formula (still required by another formula)" >&2
  done
  brew tap | grep -qx gentleman-programming/tap && brew untap gentleman-programming/tap || true
fi

# `uv tool` installs (from the Brewfile's uv entries) now from mise, as tool:binary.
if command -v uv >/dev/null; then
  for entry in unique-namer:namer osxphotos:osxphotos; do
    tool="${entry%%:*}"
    bin="${entry#*:}"
    uv tool list 2>/dev/null | grep -q "^$tool " || continue
    has "$bin" || { echo "mise has no $bin, keeping uv tool $tool" >&2; continue; }
    uv tool uninstall "$tool"
  done
fi
{{- end }}
