#!/bin/sh
# Clone ddoghq-sandbox/datadog-pi-packages for Pi coding agent (work-only).
# Provides the /refresh-models command and other internal Pi packages.
# run_once: clones once; pull manually or re-apply after deleting chezmoi state.
{{- if .work }}

REPO_DIR="$HOME/dd/datadog-pi-packages"
REPO_URL="git@github.com:ddoghq-sandbox/datadog-pi-packages.git"

if [ ! -d "$REPO_DIR/.git" ]; then
  echo "Pi: cloning datadog-pi-packages…"
  mkdir -p "$HOME/dd"
  git clone "$REPO_URL" "$REPO_DIR"
  echo "Pi: datadog-pi-packages cloned ✓"
else
  echo "Pi: datadog-pi-packages already present ✓"
fi
{{- else }}
# Not a work machine — nothing to do.
{{- end }}
