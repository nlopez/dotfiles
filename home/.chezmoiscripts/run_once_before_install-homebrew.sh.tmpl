#!/bin/bash
# Install Homebrew (Linuxbrew) if not already installed.
# https://brew.sh
{{- if ne .chezmoi.os "linux" }}
exit 0
{{- end }}

set -eufo pipefail

# Check the real binary, not just PATH — a wrapper/shim could satisfy command -v
# without Linuxbrew actually being installed.
if [ -x "{{ .packages.linux.brew_prefix }}/bin/brew" ]; then
  echo "Homebrew already installed, skipping."
  exit 0
fi

NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
