#!/bin/bash

# Installs the worktrunk agent integrations (activity markers in `wt list`, plus
# worktree isolation and skills for Claude Code). Worktrunk itself comes from mise.
#   - Claude: marketplace add + plugin install (user scope) via `wt config plugins claude`.
#   - Pi: writes $PI_CODING_AGENT_DIR/extensions/worktrunk.ts. The extension is
#     generated by the wt binary, so it's installed here rather than stored in the
#     source tree where it would go stale on wt upgrades.
# Both subcommands are idempotent, so this runs on every apply.

set -eufo pipefail

export CLAUDE_CONFIG_DIR="${XDG_CONFIG_HOME:-{{ .chezmoi.homeDir }}/.config}/claude"
export PI_CODING_AGENT_DIR="${XDG_CONFIG_HOME:-{{ .chezmoi.homeDir }}/.config}/pi/agent"

export PATH="{{ .chezmoi.homeDir }}/.local/share/mise/shims:{{ .chezmoi.homeDir }}/.local/bin:$PATH"

command -v wt >/dev/null 2>&1 || { echo "wt not found, skipping" >&2; exit 0; }

if command -v claude >/dev/null 2>&1; then
  wt config plugins claude install --yes
else
  echo "claude not found, skipping worktrunk Claude plugin" >&2
fi

wt config plugins pi install --yes
