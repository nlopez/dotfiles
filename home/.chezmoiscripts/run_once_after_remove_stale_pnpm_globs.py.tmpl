#!/usr/bin/env python3
"""Remove pnpm globals that have been removed from the manifest."""

import json
import os
import subprocess
import sys

# --- Manifest: extract base package names (strip @version) ---
def base_spec(spec):
    """Get the package name without version: '@scope/pkg@1.2.3' -> '@scope/pkg'."""
    # Unscoped: pkg@version -> pkg
    if not spec.startswith("@"):
        return spec.rsplit("@", 1)[0]
    # Scoped: @scope/pkg@version -> @scope/pkg
    # The scope is always the first part before /, the name is the part between / and @version
    idx = spec.index("/")  # first / after @scope
    name_start = idx + 1
    # Find the last @ to separate version
    ver_idx = spec.rfind("@", name_start)
    if ver_idx == -1:
        return spec  # no version
    return spec[:ver_idx]

MANIFEST = [
{{- range .pnpm.base }}
    "{{ . }}",
{{- end }}
{{- if .personal }}
{{- range .pnpm.personal }}
    "{{ . }}",
{{- end }}
{{- end }}
{{- if .work }}
{{- range .pnpm.work }}
    "{{ . }}",
{{- end }}
{{- end }}
]

manifest_set = {base_spec(s) for s in MANIFEST}

# --- Get currently installed packages ---
result = subprocess.run(
    ["pnpm", "list", "-g", "--json"],
    capture_output=True,
    text=True,
    env={**dict(os.environ), "CI": "true"},
)
if result.returncode != 0 or not result.stdout.strip():
    print("✅ No stale pnpm globals found.")
    sys.exit(0)

installed = json.loads(result.stdout)
installed_names = set()
for entry in installed:
    installed_names.update(entry.get("dependencies", {}).keys())

# --- Remove stale packages ---
stale = installed_names - manifest_set
if not stale:
    print("✅ No stale pnpm globals found.")
    sys.exit(0)

for pkg in sorted(stale):
    print(f"🗑️  Uninstalling stale global: {pkg}")
    subprocess.run(
        ["pnpm", "uninstall", "-g", pkg],
        capture_output=True,
        env={**dict(os.environ), "CI": "true"},
    )

print(f"🧹 Removed {len(stale)} stale package(s).")
