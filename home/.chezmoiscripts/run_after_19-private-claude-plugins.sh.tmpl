{{- $p := includeTemplate "private-data" . | fromYaml -}}
{{- if and .personal (not .work) (not .headless) $p.claude.plugins -}}
#!/bin/bash

# Installs the Claude Code plugins listed in the private data (claude.plugins)
# at user scope on personal machines. A manually registered MCP server can
# conflict with a plugin that ships the same server, so the user-scope servers
# in claude.remove_mcp are removed first. Work machines register their MCP
# servers in run_onchange_after_32-work-mcp-claude.sh.tmpl.
# Idempotent: only installs plugins that are missing.

set -eufo pipefail

export CLAUDE_CONFIG_DIR="{{ includeTemplate "claude-config-dir" . }}"

export PATH="{{ includeTemplate "agent-path" . }}:$PATH"

command -v claude >/dev/null 2>&1 || { echo "claude not found, skipping" >&2; exit 0; }
{{ range ($p.claude.remove_mcp | default list) }}
claude mcp remove {{ . | squote }} --scope user >/dev/null 2>&1 || true
{{- end }}

plugins="$(claude plugin list 2>/dev/null || true)"
{{- range ($p.claude.plugins | default list) }}
if ! printf '%s\n' "$plugins" | grep -qF {{ . | squote }}; then
  claude plugin install {{ . | squote }} --scope user
fi
{{- end }}
{{- end }}
