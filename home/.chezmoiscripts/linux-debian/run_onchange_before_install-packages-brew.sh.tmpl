#!/bin/bash
# Install node and pnpm via Linuxbrew on headless Debian/Ubuntu machines.

# Ensure brew is in PATH when running immediately after install-homebrew runs
# on a fresh machine where zprofile has not yet been sourced.
export PATH="{{ .packages.brew_prefix }}/bin:$PATH"

set -eufo pipefail

brew bundle --file=/dev/stdin <<'EOF'
brew "node"
brew "pnpm"
EOF
