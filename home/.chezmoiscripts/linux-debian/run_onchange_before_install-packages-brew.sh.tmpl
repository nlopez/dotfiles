#!/bin/bash
# Install node and pnpm via Linuxbrew on headless Debian/Ubuntu machines.

# Ensure brew is in PATH when running immediately after install-homebrew runs
# on a fresh machine where zprofile has not yet been sourced.
export PATH="{{ .packages.linux.brew_prefix }}/bin:$PATH"

export HOMEBREW_NO_AUTO_UPDATE=1  # Don't auto-update brew — just install from Brewfile
export HOMEBREW_NO_ASK=1  # Do not ask for confirmation before installing
export HOMEBREW_BUNDLE_FORCE_INSTALL_CLEANUP=1  # Perform cleanup without asking
set -eufo pipefail

brew bundle --file=/dev/stdin <<'EOF'
brew "atuin"
brew "eza"
brew "node"
brew "pnpm"
brew "zoxide"
EOF
