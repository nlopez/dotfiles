{{- /* Renders empty (chezmoi skips it) when the hooks are already installed:
   the same check as the early exit below. */ -}}
{{- $hooksDir := joinPath .chezmoi.workingTree ".git/hooks" }}
{{- $hookFile := joinPath $hooksDir "pre-commit" }}
{{- $hooksPath := output "sh" "-c" `git -C "$1" config --local --get core.hooksPath || true` "sh" .chezmoi.workingTree | trim }}
{{- if not (and (eq $hooksPath $hooksDir) (stat $hookFile) (contains "pre-commit" (include $hookFile))) -}}
#!/usr/bin/env bash
# Install this repo's pre-commit hooks (gitleaks, private-patterns, ...) into the
# source checkout. A clone does not carry .git/hooks, so check on every apply.
# The repo opts out of any system-wide core.hooksPath (workspaces set one) so
# its own hooks run; pre-commit refuses to install while core.hooksPath is set.
set -euo pipefail

repo={{ .chezmoi.workingTree | quote }}
command -v pre-commit >/dev/null 2>&1 || exit 0
[[ -f "$repo/.pre-commit-config.yaml" ]] || exit 0

hooks="$repo/.git/hooks"
[[ "$(git -C "$repo" config --local --get core.hooksPath || true)" == "$hooks" ]] \
  && grep -q "pre-commit" "$hooks/pre-commit" 2>/dev/null && exit 0

cd "$repo"
git config --local core.hooksPath ""
pre-commit install --install-hooks
git config --local core.hooksPath "$hooks"
{{ end -}}
