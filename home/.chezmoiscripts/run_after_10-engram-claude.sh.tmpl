#!/bin/bash

# Installs/updates the Engram plugin and user-level MCP server for Claude Code
# (user scope). Pi gets Engram from the gentle-engram package in pi.yaml.
#
# `engram setup claude-code` registers the *resolved* binary path
# (e.g. .../engram/<version>/engram) with Claude, which goes stale when mise
# upgrades engram. So this runs every apply but only
# calls setup when the plugin is missing or the registered path no longer
# matches the installed binary.

set -eufo pipefail

export CLAUDE_CONFIG_DIR="{{ includeTemplate "claude-config-dir" . }}"

export PATH="{{ includeTemplate "nix-profile" . }}/bin:{{ .chezmoi.homeDir }}/.local/share/mise/shims:{{ .chezmoi.homeDir }}/.local/bin:$PATH"
export ENGRAM_DATA_DIR="${XDG_DATA_HOME:-{{ .chezmoi.homeDir }}/.local/share}/engram"

command -v engram >/dev/null 2>&1 || { echo "engram not found, skipping" >&2; exit 0; }
command -v claude >/dev/null 2>&1 || { echo "claude not found, skipping" >&2; exit 0; }

engram_path="$(command -v engram)"
# A mise shim is a symlink to the mise binary, so readlink -f would resolve to
# mise itself; ask mise for the real install path instead.
engram_real="$(mise which engram 2>/dev/null || readlink -f "$engram_path")"

plugins="$(claude plugin list 2>/dev/null || true)"
mcp="$(claude mcp get engram 2>/dev/null || true)"

# `engram setup` registers the unresolved path (e.g. /opt/homebrew/bin/engram),
# so accept either that or the fully resolved one.
if printf '%s\n' "$plugins" | grep -q 'engram@engram' &&
  { printf '%s\n' "$mcp" | grep -qxF "  Command: $engram_path" ||
    printf '%s\n' "$mcp" | grep -qxF "  Command: $engram_real"; }; then
  exit 0
fi

# `engram setup` refuses to overwrite a registration pointing at a different
# binary (e.g. a removed mise install), so drop the stale one first.
if [ -n "$mcp" ]; then
  claude mcp remove engram --scope user || true
fi

# `engram setup` asks interactively whether to add the engram tools to the
# settings.json permissions allowlist (so Claude Code does not prompt on every
# memory call). Answer `y` on stdin — same choice as made interactively before;
# setup has no non-interactive flag. The duplicate mcp__plugin_engram_engram__*
# entries it adds alongside the real mcp__engram__* ones are removed by
# dot_config/claude/modify_settings.json.tmpl on the next apply.
printf 'y\n' | engram setup claude-code
