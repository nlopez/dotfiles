#!/usr/bin/env python3
"""Install all pnpm global packages from the manifest in a single batch."""

import subprocess
import sys

MANIFEST = [
{{- range .pnpm.base }}
    "{{ . }}",
{{- end }}
{{- if .personal }}
{{- range .pnpm.personal }}
    "{{ . }}",
{{- end }}
{{- end }}
{{- if .work }}
{{- range .pnpm.work }}
    "{{ . }}",
{{- end }}
{{- end }}
]

if not MANIFEST:
    sys.exit(0)

env = {**dict(__import__("os").environ), "CI": "true"}
result = subprocess.run(
    ["pnpm", "add", "-g", "--reporter=append-only"] + MANIFEST,
    env=env,
)
sys.exit(result.returncode)
