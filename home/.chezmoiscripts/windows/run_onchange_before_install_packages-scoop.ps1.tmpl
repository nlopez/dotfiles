{{ $scoopConfig := .packages.windows.scoop -}}
{{ $buckets := $scoopConfig.buckets.base -}}
{{ $packages := $scoopConfig.packages.base -}}

{{ if .personal -}}
{{   $buckets = concat $buckets $scoopConfig.buckets.personal -}}
{{   $packages = concat $packages $scoopConfig.packages.personal -}}
{{ end -}}

{{ if .work -}}
{{   $buckets = concat $buckets $scoopConfig.buckets.work -}}
{{   $packages = concat $packages $scoopConfig.packages.work -}}
{{ end -}}

$desiredBuckets = @(
{{- range $bucket := $buckets }}
     [ordered]@{
          Name = "{{ $bucket.name }}"
{{- if $bucket.url }}
          Source = "{{ $bucket.url }}"
{{- end }}
     }
{{- end }}
)

$desiredPackages = @(
{{- range ($packages | sortAlpha | uniq) }}
     "{{ . }}"
{{- end }}
)

$desiredState = [ordered]@{
     buckets = @($desiredBuckets | Sort-Object Name -Unique)
     apps = @(
          $desiredPackages | ForEach-Object {
               # Scoop import expects Source; setting it to the app token installs by app name.
               [ordered]@{ Name = $_; Source = $_ }
          }
     )
}

$scoopfileState = [ordered]@{
     buckets = $desiredState.buckets
     apps = $desiredState.apps
}

$scoopfilePath = Join-Path $env:TEMP ("chezmoi-scoopfile-{0}.json" -f [guid]::NewGuid())

try {
     $scoopfileState | ConvertTo-Json -Depth 8 | Set-Content -Path $scoopfilePath -Encoding utf8
     # Scoop can emit messages on warning/information streams; merge all streams for filtering.
     $importOutput = & scoop import $scoopfilePath *>&1
     $suppressPattern = '(?i)already exists|already installed'

     foreach ($line in $importOutput) {
          $text = $line.ToString()
          if ($text -notmatch $suppressPattern) {
               Write-Host $text
          }
     }

     if ($LASTEXITCODE -ne 0) {
          throw "scoop import failed with exit code $LASTEXITCODE"
     }
}
finally {
     Remove-Item -Path $scoopfilePath -ErrorAction SilentlyContinue
}
