#!/bin/bash

# Keeps Claude Code close to stock: uninstalls every user-scope plugin except
# engram, context-mode, worktrunk and i-have-adhd (see run_after_10-engram-claude.sh.tmpl,
# run_after_15-context-mode-claude.sh.tmpl, run_after_17-worktrunk-plugins.sh.tmpl and
# run_after_18-i-have-adhd-claude.sh.tmpl) and removes the
# third-party ECC and Cloudflare marketplaces.
# Re-run by bumping the revision below.
# plugins-removal-revision: 2

set -eufo pipefail

export CLAUDE_CONFIG_DIR="${XDG_CONFIG_HOME:-{{ .chezmoi.homeDir }}/.config}/claude"

export PATH="{{ .chezmoi.homeDir }}/.local/share/mise/shims:{{ .chezmoi.homeDir }}/.local/bin:$PATH"

command -v claude >/dev/null 2>&1 || { echo "claude not found, skipping" >&2; exit 0; }

installed="$(claude plugin list 2>/dev/null || true)"
for plugin in ecc@ecc gopls-lsp@claude-plugins-official pr-review-toolkit@claude-plugins-official frontend-design@claude-plugins-official; do
  if printf '%s\n' "$installed" | grep -q "$plugin"; then
    claude plugin uninstall "$plugin" --scope user
  fi
done

marketplaces="$(claude plugin marketplace list 2>/dev/null || true)"
for marketplace in ecc cloudflare; do
  if printf '%s\n' "$marketplaces" | grep -qE "^\s*❯ $marketplace\s*$"; then
    claude plugin marketplace remove "$marketplace"
  fi
done
