#!/bin/bash

# Keeps Claude Code close to stock: uninstalls every user-scope plugin except
# engram, worktrunk and the ones in .chezmoidata/claude.yaml (see
# run_after_10-engram-claude.sh.tmpl, run_after_19-worktrunk-plugins.sh.tmpl and
# run_onchange_after_18-claude-plugins.sh.tmpl) and removes the third-party ECC,
# Cloudflare and Dogpark marketplaces.
# Re-run by bumping the revision below.
# plugins-removal-revision: 4

set -eufo pipefail

export PATH="{{ includeTemplate "agent-path" . }}:$PATH"

command -v claude >/dev/null 2>&1 || { echo "claude not found, skipping" >&2; exit 0; }

installed="$(claude plugin list 2>/dev/null || true)"
for plugin in ecc@ecc gopls-lsp@claude-plugins-official pr-review-toolkit@claude-plugins-official frontend-design@claude-plugins-official slack-relay@dogpark; do
  if printf '%s\n' "$installed" | grep -q "$plugin"; then
    claude plugin uninstall "$plugin" --scope user
  fi
done

marketplaces="$(claude plugin marketplace list 2>/dev/null || true)"
for marketplace in ecc cloudflare dogpark; do
  if printf '%s\n' "$marketplaces" | grep -qE "^\s*❯ $marketplace\s*$"; then
    claude plugin marketplace remove "$marketplace"
  fi
done
