#!/bin/bash

{{- $dnfConfig := index .packages "linux-aurora" "dnf" -}}
{{- $packages := index $dnfConfig "packages" "base" -}}

{{- if .personal -}}
{{-   $personal := index .packages "linux-aurora" "dnf" "packages" "personal" -}}
{{-   if $personal -}}
{{-     $packages = concat $packages $personal -}}
{{-   end -}}
{{- end -}}

{{- if .work -}}
{{-   $work := index .packages "linux-aurora" "dnf" "packages" "work" -}}
{{-   if $work -}}
{{-     $packages = concat $packages $work -}}
{{-   end -}}
{{- end -}}

set -eufo pipefail

# 1password-cli is installed via the 1password repo configured in 00-install-packages-dnf.sh
# so it can be installed along with all other packages
dnf install -y {{ $packages | sortAlpha | uniq | join " " }}
