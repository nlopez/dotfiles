#!/bin/bash

# Checksum to trigger when pnpm global packages change
# {{ index .packages "linux-aurora" "pnpm" | toJson | sha256sum }}

set -eufo pipefail

export PNPM_HOME="${XDG_DATA_HOME:-$HOME/.local/share}/pnpm"
export PATH="$PNPM_HOME/bin:$PATH"
export CI=true

# Supply chain protection: skip install if a package was recently installed
# to let time pass for malicious releases to be reported and yanked.
SUPPLY_CHAIN_DELAY_DAYS={{ .supplyChainDelayDays }}
INSTALLED_PKG_STATE_DIR="$HOME/.local/share/pi-installed"  # per-orchestration tracking
mkdir -p "$INSTALLED_PKG_STATE_DIR"

install_if_healthy() {
    local pkg="$1"
    local pkg_dir
    pkg_dir="$(pnpm root -g 2>/dev/null || echo "$PNPM_HOME/lib/node_modules")/$pkg"
    local last_installed=""

    # Read last install timestamp for this package
    if [[ -f "$INSTALLED_PKG_STATE_DIR/$pkg" ]]; then
        last_installed="$(cat "$INSTALLED_PKG_STATE_DIR/$pkg")"
    fi

    # Check if package is already installed at the desired version
    local current_version=""
    if command -v node >/dev/null 2>&1; then
        current_version="$(node -e "try { console.log(require('$pkg_dir/package.json').version) } catch(e) {}" 2>/dev/null || echo "")"
    fi

    local desired_version=""
    if [[ "$pkg" == *"@"*"@"* ]]; then
        desired_version="${pkg##*@}"
    elif [[ "$pkg" == "@"*"@"* ]]; then
        desired_version="${pkg##*@}"
    fi

    # If version matches and it was recently installed, skip
    if [[ -n "$current_version" && -n "$desired_version" && "$current_version" == "$desired_version" ]]; then
        if [[ -n "$last_installed" ]]; then
            local now
            now="$(date +%s)"
            local age_days=$(( (now - last_installed) / 86400 ))
            if [[ $age_days -lt $SUPPLY_CHAIN_DELAY_DAYS ]]; then
                echo "⏳ Skipping $pkg@$desired_version (installed ${age_days}d ago, delay=${SUPPLY_CHAIN_DELAY_DAYS}d)"
                return 0
            fi
        fi
    fi

    # Install/upgrade the package
    echo "📦 Installing $pkg"
    pnpm add -g --reporter=append-only "$pkg" || {
        echo "❌ Failed to install $pkg, retrying without cache..."
        pnpm add -g --reporter=append-only --prefer-offline "$pkg"
    }

    # Record install timestamp (sanitize package name for filesystem safety)
    local pkg_id
    pkg_id="${pkg//\//__}"
    pkg_id="${pkg_id//\@/_at_}"
    pkg_id="${pkg_id//\./_dot_}"
    date +%s > "$INSTALLED_PKG_STATE_DIR/$pkg_id"
}

{{ $pnpmConfig := index .packages "linux-aurora" "pnpm" -}}

{{- range $pnpmConfig.base }}
install_if_healthy "{{ . }}"
{{- end }}

{{- if .personal }}
{{- range $pnpmConfig.personal }}
install_if_healthy "{{ . }}"
{{- end }}
{{- end }}

{{- if .work }}
{{- range $pnpmConfig.work }}
install_if_healthy "{{ . }}"
{{- end }}
{{- end }}

# Ensure pnpm global packages hoist their dependencies so TypeScript runtimes
# (like pi's extension loader) can resolve modules via standard Node.js paths.
GLOBAL_WS="$PNPM_HOME/global/v11/pnpm-workspace.yaml"
if [[ -f "$GLOBAL_WS" ]] && ! grep -q "shamefullyHoist" "$GLOBAL_WS"; then
    echo "" >> "$GLOBAL_WS"
    echo "shamefullyHoist: true" >> "$GLOBAL_WS"
    echo "✅ Added shamefullyHoist to global pnpm-workspace.yaml"
fi
