#!/bin/bash
# run_once: after all external sources are installed

set -eufo pipefail

{{- if .headless }}
exit 0  # headless: no display server; fonts not needed
{{- end }}

{{- $home := .chezmoi.homeDir }}
{{- $fd := .platform.font_dir }}
{{- if eq .chezmoi.os "linux" }}
mkdir -p "{{ $home }}/{{ $fd }}"
FONT_DIR="{{ $home }}/{{ $fd }}"

# Rebuild font cache
if command -v fc-cache &>/dev/null; then
  fc-cache -fv "$FONT_DIR" 2>&1 || true
fi
{{- end }}

echo "iosevka-nf-fonts: fonts installed"
