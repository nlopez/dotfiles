#!/bin/bash

# Installs the dd-pup pi extension (the pup CLI as pi tools) with pup's own
# installer. The extension ships inside the pup binary, so this needs no
# network and no auth. Re-runs when the pup version in mise/base.toml changes;
# `pup skills install` is idempotent. pi.yaml covers npm/git packages only.
# {{ index (includeTemplate "mise-tools" . | fromJson) "github:DataDog/pup" | sha256sum }}

set -eufo pipefail

export PATH="{{ includeTemplate "agent-path" . }}:$PATH"

command -v pi >/dev/null 2>&1 || { echo "pi not found, skipping" >&2; exit 0; }

# pup is a mise tool, so it is not on agent-path on macOS; ask mise for the path.
pup="$(mise which pup 2>/dev/null)" || { echo "pup not found, skipping" >&2; exit 0; }

"$pup" skills install pi --name=dd-pup-pi --yes >/dev/null
