#!/bin/bash

# Installs the worktrunk agent integrations (activity markers in `wt list`, plus
# worktree isolation and skills for Claude Code). Worktrunk itself comes from Nix.
#   - Claude: marketplace add (pinned to the wt binary's release tag) + plugin
#     install (user scope).
#   - Codex: same, via `codex plugin marketplace add` (pinned) + `codex plugin add`.
#   - Pi: writes ~/.pi/agent/extensions/worktrunk.ts. The extension is
#     generated by the wt binary, so it's installed here rather than stored in the
#     source tree where it would go stale on wt upgrades.
# Every step is idempotent. run_onchange: reruns when the wt version, the agent
# CLIs on PATH, or the installed plugin state below changes.
{{- $wt := lookPath "wt" }}
{{- $known := joinPath .chezmoi.homeDir ".claude/plugins/known_marketplaces.json" }}
{{- $installed := joinPath .chezmoi.homeDir ".claude/plugins/installed_plugins.json" }}
{{- $codexConfig := joinPath (env "CODEX_HOME" | default (joinPath .chezmoi.homeDir ".codex")) "config.toml" }}
{{- $piExt := joinPath .chezmoi.homeDir ".pi/agent/extensions/worktrunk.ts" }}
# wt: {{ if $wt }}{{ output $wt "--version" | trim }}{{ else }}none{{ end }}
# claude: {{ lookPath "claude" | default "none" }}, codex: {{ lookPath "codex" | default "none" }}
# claude marketplace ref: {{ if stat $known }}{{ dig "worktrunk" "source" "ref" "none" (include $known | fromJson) }}{{ else }}none{{ end }}
# claude plugin installed: {{ if stat $installed }}{{ hasKey ((include $installed | fromJson).plugins | default dict) "worktrunk@worktrunk" }}{{ else }}false{{ end }}
# codex config: {{ if stat $codexConfig }}{{ include $codexConfig | sha256sum }}{{ else }}none{{ end }}
# pi extension: {{ if stat $piExt }}{{ include $piExt | sha256sum }}{{ else }}none{{ end }}

set -eufo pipefail

export PATH="{{ includeTemplate "agent-path" . }}:$PATH"

command -v wt >/dev/null 2>&1 || { echo "wt not found, skipping" >&2; exit 0; }

if command -v claude >/dev/null 2>&1; then
  # Pin the marketplace to the tag matching the installed wt. `wt config plugins
  # claude install` tracks the repo's default branch, whose hooks can call
  # subcommands the (older, nixpkgs) binary lacks — e.g. plugin 0.81 calls
  # `wt config plugins claude hook`, absent in wt 0.80, breaking `claude -w`.
  want="v$(wt --version | awk '{print $2}')"
  known="$HOME/.claude/plugins/known_marketplaces.json"
  have="$(jq -r '.worktrunk.source.ref // empty' "$known" 2>/dev/null || true)"
  if [ "$have" != "$want" ]; then
    claude plugin uninstall worktrunk@worktrunk >/dev/null 2>&1 || true
    claude plugin marketplace remove worktrunk >/dev/null 2>&1 || true
    claude plugin marketplace add "max-sixty/worktrunk#$want"
  fi
  claude plugin list 2>/dev/null | grep -q 'worktrunk@worktrunk' \
    || claude plugin install worktrunk@worktrunk

  # Plugin <= 0.80's WorktreeCreate hook always runs `wt switch --create`, which
  # fails when the branch exists (e.g. `claude --worktree X --resume ...`). Drop
  # --create for existing branches; `wt switch` then reuses or creates the
  # branch's worktree. Newer plugins route through `wt config plugins claude
  # hook` instead, so the match below no longer applies to them.
  installed="$HOME/.claude/plugins/installed_plugins.json"
  jq -r '.plugins["worktrunk@worktrunk"][]?.installPath' "$installed" 2>/dev/null | sort -u |
    while IFS= read -r root; do
      hooks="$root/hooks/hooks.json"
      grep -q 'switch --create \\"\$name\\"' "$hooks" 2>/dev/null || continue
      tmp="$(mktemp)"
      jq '(.hooks.WorktreeCreate[].hooks[].command) |= sub(
            "switch --create \"\\$name\""; "switch $create \"$name\"")
          | (.hooks.WorktreeCreate[].hooks[].command) |= sub(
            "bash \"\\$CLAUDE_PLUGIN_ROOT/hooks/wt.sh\" switch";
            "create=--create; git show-ref --verify --quiet \"refs/heads/$name\" \u0026\u0026 create=; bash \"$CLAUDE_PLUGIN_ROOT/hooks/wt.sh\" switch")' \
        "$hooks" >"$tmp" && mv "$tmp" "$hooks"
    done
else
  echo "claude not found, skipping worktrunk Claude plugin" >&2
fi

if command -v codex >/dev/null 2>&1; then
  # Pinned to the wt release tag for the same reason as the Claude marketplace.
  want="v$(wt --version | awk '{print $2}')"
  # `codex plugin marketplace list --json` omits the ref; read it from config.toml.
  have="$(awk '/^\[/{s=($0=="[marketplaces.worktrunk]")} s&&/^ref *=/{gsub(/[" ]/,"");sub(/^ref=/,"");print}' \
    "${CODEX_HOME:-$HOME/.codex}/config.toml" 2>/dev/null || true)"
  if [ "$have" != "$want" ]; then
    codex plugin remove worktrunk@worktrunk >/dev/null 2>&1 || true
    codex plugin marketplace remove worktrunk >/dev/null 2>&1 || true
    codex plugin marketplace add max-sixty/worktrunk --ref "$want"
  fi
  codex plugin list 2>/dev/null | grep -q '^worktrunk@worktrunk  *installed' \
    || codex plugin add worktrunk@worktrunk
else
  echo "codex not found, skipping worktrunk Codex plugin" >&2
fi

wt config plugins pi install --yes
