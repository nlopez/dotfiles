#!/bin/bash

{{ $brewConfig := index .packages "linux" "brew" -}}
{{ $brews := $brewConfig.brews.base -}}

{{ if .personal -}}
{{   $brews = concat $brews $brewConfig.brews.personal -}}
{{ end -}}

{{ if .work -}}
{{   $brews = concat $brews $brewConfig.brews.work -}}
{{ end -}}

{{/* headless: skip all casks (fonts, GUI apps) */}}
{{ $casks := list -}}
{{ if not .headless -}}
{{   $casks = $brewConfig.casks.base -}}
{{   if .personal -}}
{{     $casks = concat $casks $brewConfig.casks.personal -}}
{{   end -}}
{{   if .work -}}
{{     $casks = concat $casks $brewConfig.casks.work -}}
{{   end -}}
{{ end -}}

# Ensure brew is in PATH when running immediately after install-homebrew.sh on a
# fresh machine where zprofile has not yet been sourced.
export PATH="{{ .packages.brew_prefix }}/bin:$PATH"

export HOMEBREW_NO_AUTO_UPDATE=1  # Don't auto-update brew — just install from Brewfile
set -eufo pipefail

brew bundle --file=/dev/stdin --cleanup <<EOF
{{ range ($brews | sortAlpha | uniq ) -}}
brew {{ . | quote }}
{{ end -}}
{{ range ($casks | sortAlpha | uniq ) -}}
cask {{ . | quote }}
{{ end -}}
EOF
