#!/bin/bash
# Install 1Password CLI on Ubuntu/Debian machines via scripts/install-op.sh, the
# same installer the age-key hook uses before source state is read.
#
# Uses run_once_before_ so op is available during template rendering
# (onepasswordRead calls) for the rest of chezmoi apply.
# Only installs 1password-cli — no desktop app needed on a headless server.
#
# Skipped on: headless machines, workspace environments.

set -eufo pipefail

{{ if .headless -}}
echo "Headless machine detected, skipping 1Password CLI install."
exit 0
{{- end }}

if [[ -n "${IN_WORKSPACE:-}" ]]; then
  echo "Workspace environment detected (IN_WORKSPACE=${IN_WORKSPACE}), skipping 1Password CLI install."
  exit 0
fi

if command -v op &>/dev/null; then
  echo "1password-cli already installed, skipping."
  exit 0
fi

bash "{{ .chezmoi.sourceDir }}/scripts/install-op.sh"
