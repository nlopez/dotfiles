{{- if .workspace -}}
#!/bin/bash
# Installs the Rex server pinned in .chezmoidata/rex.yaml as ~/.local/bin/rex
# and starts it through ~/.local/share/workspaces-rex/ensure (chezmoi-managed),
# which also adds the crontab entry that keeps it running. No root needed.
#
# A running server keeps its version until it stops, because stopping it ends
# its sessions. To switch now: rex --autostart=false server stop && ~/.local/share/workspaces-rex/ensure
#
# ensure: {{ include "dot_local/share/workspaces-rex/executable_ensure.tmpl" | sha256sum }}
set -euo pipefail
umask 022

version={{ .rex.version | quote }}
url={{ printf "https://blob.superlogical.com/download/rex/%s/%s/rex-linux-%s.tar.gz" .rex.channel .rex.commit .chezmoi.arch | quote }}
sha256={{ index .rex.sha256 .chezmoi.arch | quote }}
bin="$HOME/.local/bin/rex"
share="$HOME/.local/share/workspaces-rex"

installed=$("$bin" version 2>/dev/null | awk 'NR == 1 { print $2 }') || installed=
if [ "$installed" != "$version" ]; then
	mkdir -p "$(dirname "$bin")"
	tmp=$(mktemp -d)
	trap 'rm -rf "$tmp"' EXIT
	curl -fsSL --retry 3 --connect-timeout 20 -o "$tmp/rex.tar.gz" "$url"
	printf '%s  %s\n' "$sha256" "$tmp/rex.tar.gz" | sha256sum -c --status ||
		{ echo "rex: $url does not match the pinned sha256" >&2; exit 1; }
	tar -xzf "$tmp/rex.tar.gz" -C "$tmp" rex
	# Fail before replacing anything when the new binary cannot run here.
	"$tmp/rex" version >/dev/null
	install -m 0755 "$tmp/rex" "$bin.new"
	mv -f "$bin.new" "$bin"
	"$bin" terminfo setup >/dev/null 2>&1 ||
		echo "rex: 'rex terminfo setup' failed; curses programs in Rex terminals may not work" >&2
fi

# Written by the retired per-workspace installer; the pin replaces it.
rm -f "$share/release"
"$share/ensure" >/dev/null
{{- end }}
