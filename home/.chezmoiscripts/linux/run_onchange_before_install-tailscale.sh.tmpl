#!/bin/bash

set -eufo pipefail

{{- if lookPath "tailscale" }}
echo "tailscale is already installed, skipping installation"
exit 0
{{- end }}

{{ $sudo := "sudo " -}}
{{ if eq .chezmoi.username "root" -}}
{{   $sudo = "" -}}
{{ end -}}

curl -fsSL https://pkgs.tailscale.com/stable/{{ .chezmoi.osRelease.id }}/{{ .chezmoi.osRelease.ubuntuCodename }}.noarmor.gpg | {{ $sudo }}tee /usr/share/keyrings/tailscale-archive-keyring.gpg >/dev/null
curl -fsSL https://pkgs.tailscale.com/stable/{{ .chezmoi.osRelease.id }}/{{ .chezmoi.osRelease.ubuntuCodename }}.tailscale-keyring.list | {{ $sudo }}tee /etc/apt/sources.list.d/tailscale.list

{{ $sudo }}apt-get update
{{ $sudo }}apt-get install -y tailscale
