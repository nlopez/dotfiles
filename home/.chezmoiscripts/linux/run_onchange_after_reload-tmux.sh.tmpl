#!/bin/bash
# Reloads the tmux config and zsh panes after chezmoi apply.
#
# Re-runs whenever any of these source files change:
# {{ include "dot_config/tmux/tmux.conf" | sha256sum }}
# {{ include "dot_zshrc.tmpl" | sha256sum }}
# {{ include "dot_zprofile.tmpl" | sha256sum }}
# {{ include "exact_dot_oh-my-zsh/exact_custom/00_custom.zsh.tmpl" | sha256sum }}

set -eufo pipefail

command -v tmux >/dev/null 2>&1 || { echo "tmux: not installed, skipping."; exit 0; }
tmux ls >/dev/null 2>&1        || { echo "tmux: no server running, skipping."; exit 0; }

# ── 1. Reload tmux config ────────────────────────────────────────────────────
tmux source-file ~/.config/tmux/tmux.conf
echo "tmux: config reloaded."

# ── 2. Reload or queue zsh panes ─────────────────────────────────────────────
# Single-quoted so $PATH etc. are expanded by the *target* shell, not here.
# TMUX_PANE is preserved so the queued-reload precmd hook works after exec.
# shellcheck disable=SC2016
readonly RELOAD_CMD='exec env -i PATH=$PATH TERMINFO=$TERMINFO TERM=$TERM USER=$USER HOME=$HOME SHELL=$SHELL TMUX=$TMUX TMUX_PANE=$TMUX_PANE zsh --login'

reloaded=0
queued=0
skipped=0

while IFS=' ' read -r pane_id pane_pid current_cmd in_mode; do
  # Determine whether this pane's root process is a zsh shell.
  # Strip a leading '-' that login shells report on some systems (e.g. '-zsh').
  root_cmd=$(ps -p "$pane_pid" -o comm= 2>/dev/null | sed 's/^-//' | tr -d ' ' || echo "")
  if [[ "$root_cmd" != "zsh" ]]; then
    skipped=$((skipped + 1))
    continue
  fi

  if [[ "$current_cmd" == "zsh" && "$in_mode" == "0" ]]; then
    # Idle at prompt — send reload immediately.
    tmux send-keys -t "$pane_id" "$RELOAD_CMD" Enter
    reloaded=$((reloaded + 1))
  else
    # Busy (running a child) or in copy/scroll mode — set a pane user option;
    # the _chezmoi_reload_precmd hook in zshrc picks it up on the next prompt.
    tmux set-option -p -t "$pane_id" @chezmoi_reload 1
    queued=$((queued + 1))
  fi
done < <(tmux list-panes -a -F '#{pane_id} #{pane_pid} #{pane_current_command} #{pane_in_mode}')

echo "shells: ${reloaded} reloaded immediately, ${queued} queued for next prompt, ${skipped} non-zsh skipped."
