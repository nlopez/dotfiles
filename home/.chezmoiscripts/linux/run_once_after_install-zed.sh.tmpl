#!/bin/bash
# Download and install Zed from the official tarball.
# Based on: https://zed.dev/install.sh
# On Fedora Silverblue (Aurora), Zed is not available as an RPM,
# so we download the official tarball and link it to ~/.local/bin/.
# Per-machine overrides: .chezmoidata/linux/zed_data-linux.yaml

set -eufo pipefail

ZED_VERSION="{{ .ZED_VERSION | default "latest" }}"
ZED_CHANNEL="{{ .ZED_CHANNEL | default "stable" }}"
ZED_ARCH="$(uname -m)"

case "$ZED_ARCH" in
    aarch64|arm64) ZED_ARCH="aarch64" ;;
    x86_64|i686)   ZED_ARCH="x86_64" ;;
    *) echo "Unsupported architecture: $ZED_ARCH" >&2; exit 1 ;;
esac

if [ "$ZED_CHANNEL" != "stable" ]; then
    ZED_SUFFIX="-$ZED_CHANNEL"
else
    ZED_SUFFIX=""
fi

echo "Downloading Zed version: $ZED_VERSION (channel: $ZED_CHANNEL, arch: $ZED_ARCH)"

TEMP="$(mktemp -d /tmp/zed-XXXXXX)"
curl -fL "https://cloud.zed.dev/releases/$ZED_CHANNEL/$ZED_VERSION/download?asset=zed&arch=$ZED_ARCH&os=linux&source=chezmoi" \
    > "$TEMP/zed-linux-$ZED_ARCH.tar.gz"

# Unpack to ~/.local
rm -rf "$HOME/.local/zed${ZED_SUFFIX}.app"
mkdir -p "$HOME/.local/zed${ZED_SUFFIX}.app"
tar -xzf "$TEMP/zed-linux-$ZED_ARCH.tar.gz" -C "$HOME/.local/zed${ZED_SUFFIX}.app/" --strip-components=1

# Setup ~/.local/bin
mkdir -p "$HOME/.local/bin"

# Link the binary (newer versions use 'zed', older used 'cli')
if [ -f "$HOME/.local/zed${ZED_SUFFIX}.app/bin/zed" ]; then
    ln -sf "$HOME/.local/zed${ZED_SUFFIX}.app/bin/zed" "$HOME/.local/bin/zed"
else
    ln -sf "$HOME/.local/zed${ZED_SUFFIX}.app/bin/cli" "$HOME/.local/bin/zed"
fi

# Copy .desktop file for XDG desktop integration
APPID="dev.zed.Zed"
if [ "$ZED_CHANNEL" != "stable" ]; then
    APPID="dev.zed.Zed-${ZED_CHANNEL^}"
fi

mkdir -p "$HOME/.local/share/applications"
if [ -f "$HOME/.local/zed${ZED_SUFFIX}.app/share/applications/${APPID}.desktop" ]; then
    cp "$HOME/.local/zed${ZED_SUFFIX}.app/share/applications/${APPID}.desktop" \
       "$HOME/.local/share/applications/${APPID}.desktop"
else
    # Fallback for older tarballs
    cp "$HOME/.local/zed${ZED_SUFFIX}.app/share/applications/zed${ZED_SUFFIX}.desktop" \
       "$HOME/.local/share/applications/${APPID}.desktop"
fi

# Fix paths in .desktop file
ICON_PATH="$HOME/.local/zed${ZED_SUFFIX}.app/share/icons/hicolor/512x512/apps/zed.png"
EXEC_PATH="$HOME/.local/zed${ZED_SUFFIX}.app/bin/zed"
sed -i "s|Icon=zed|Icon=$ICON_PATH|g" "$HOME/.local/share/applications/${APPID}.desktop"
sed -i "s|Exec=zed|Exec=$EXEC_PATH|g" "$HOME/.local/share/applications/${APPID}.desktop"

rm -rf "$TEMP"

echo "Zed has been installed. Run with 'zed'"
