{{- if not .headless -}}
#!/bin/bash

# Registers the 1Password Environments MCP server (1password-mcp) with Claude
# Code at user scope. Pi gets the same server from dot_pi/agent/modify_mcp.json.tmpl.
# Requires the 1Password desktop app with Settings > Developer > Integrate with
# MCP clients enabled.

set -eufo pipefail

export PATH="{{ includeTemplate "agent-path" . }}:$PATH"

command -v claude >/dev/null 2>&1 || { echo "claude not found, skipping" >&2; exit 0; }

claude mcp remove 1password --scope user >/dev/null 2>&1 || true
claude mcp add-json 1password --scope user '{
  "type": "stdio",
  "command": "1password-mcp"
}'
{{- end }}
