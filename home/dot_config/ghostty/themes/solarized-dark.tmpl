{{- $s := .solarized -}}
# Solarized Dark — https://ethanschoonover.com/solarized/
#
# ANSI palette (spec TERMCOL mapping, identical across light & dark)
# Slots 0-7  : normal colors
# Slots 8-15 : bright colors

# normal
palette = 0={{ $s.base02 }}
palette = 1={{ $s.red }}
palette = 2={{ $s.green }}
palette = 3={{ $s.yellow }}
palette = 4={{ $s.blue }}
palette = 5={{ $s.magenta }}
palette = 6={{ $s.cyan }}
palette = 7={{ $s.base2 }}

# bright
palette = 8={{ $s.base03 }}
palette = 9={{ $s.orange }}
palette = 10={{ $s.base01 }}
palette = 11={{ $s.base00 }}
palette = 12={{ $s.base0 }}
palette = 13={{ $s.violet }}
palette = 14={{ $s.base1 }}
palette = 15={{ $s.base3 }}

# Dark-mode semantics (symmetric swap of light-mode)
# background  = base03 (darkest)
# foreground  = base0  (light content tone)
# highlights  = base02 (slightly lighter bg)
# secondary   = base1  (de-emphasized text)
background           = {{ $s.base03 }}
foreground           = {{ $s.base0 }}
cursor-color         = {{ $s.base0 }}
cursor-text          = {{ $s.base03 }}
selection-background = {{ $s.base02 }}
selection-foreground = {{ $s.base1 }}
