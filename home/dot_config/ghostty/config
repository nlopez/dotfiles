font-size = 16
font-family = ""
font-family = IosevkaTerm NFM
quit-after-last-window-closed = true
theme = light:iTerm2 Solarized Light,dark:Atom One Dark
window-padding-x = 0
window-padding-y = 0
window-padding-color = extend
# Disable ligatures
font-feature = -calt
macos-titlebar-style = hidden
confirm-close-surface = false

# https://github.com/ghostty-org/ghostty/discussions/3836#discussioncomment-11688264
# cursor-style = block
# cursor-style-blink = true
shell-integration-features = no-cursor
