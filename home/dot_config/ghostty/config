font-size = 12
font-family = ""
font-family = IosevkaTerm NFM
quit-after-last-window-closed = true
theme = noctalia

# Disable ligatures
font-feature = -calt
macos-titlebar-style = hidden
gtk-tabs-location = hidden

# https://github.com/ghostty-org/ghostty/discussions/3836#discussioncomment-11688264
cursor-style = block
cursor-style-blink = true
shell-integration-features = no-cursor

initial-command = /usr/bin/zsh --login -c 'tmux attach -t 0 || tmux new -s 0'

background-opacity-cells = true
background-blur = 20
background-opacity = 0.88
