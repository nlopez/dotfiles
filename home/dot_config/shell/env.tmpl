{{- /* ~/.config/shell/env
   Sourced by every shell type to set XDG env vars and other shared environment.
   path_helper-sensitive PATH mods (gnubin, keg-only brew) do NOT belong here —
   they go in zprofile so they land after macOS path_helper -s rebuilds PATH.
   Shell-agnostic tool dirs (~/.local/bin, cargo, go, pnpm) DO belong here so
   they reach non-login interactive shells too; zprofile re-prepends them on
   macOS after path_helper.
   Sourced by:
     • ~/.zshenv          → all zsh (login, interactive, non-interactive, scripts)
     • ~/.zprofile        → login zprofile (for XDG vars)
     • ~/.profile         → login bash and POSIX sh
     • $BASH_ENV          → every non-interactive bash subprocess
     • $ENV               → interactive sh subshells
   POSIX sh compatible — no bashisms, no zsh-isms.
*/ -}}
# Guard: skip if already loaded in this shell session.
[ -n "$_SHELL_ENV_LOADED" ] && return
_SHELL_ENV_LOADED=1

{{- if eq .chezmoi.os "darwin" }}
{{- $brewPrefixes := list "/opt/homebrew" "/usr/local" -}}
{{- $brewPrefix := "" -}}
{{- range $brewPrefixes -}}
  {{- if and (not $brewPrefix) (stat (printf "%s/bin/brew" .)) -}}
    {{- $brewPrefix = . -}}
  {{- end -}}
{{- end }}
{{- end }}

# ── XDG-redirected state ─────────────────────────────────────────────────────
# These move legacy ~/.<tool> state into XDG paths so xdg-ninja is clean.

# Bash history (sourced via BASH_ENV for non-interactive, ENV for sh subshells)
[ -n "${HISTFILE+x}" ] || HISTFILE="${XDG_STATE_HOME:-$HOME/.local/state}/bash/history"
export HISTFILE

# GnuPG data directory
[ -z "${GNUPGHOME}" ] && export GNUPGHOME="${XDG_DATA_HOME:-$HOME/.local/share}/gnupg"

# Cargo registry and local registry cache
[ -z "${CARGO_HOME}" ] && export CARGO_HOME="${XDG_DATA_HOME:-$HOME/.local/share}/cargo"

# Docker config (Docker Desktop ignores this, but CLI follows it)
[ -z "${DOCKER_CONFIG}" ] && export DOCKER_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/docker"

# Colima config directory (default ~/.colima ignored when COLIMA_HOME is set)
[ -z "${COLIMA_HOME}" ] && export COLIMA_HOME="${XDG_CONFIG_HOME:-$HOME/.config}/colima"

# Ansible runtime state
[ -z "${ANSIBLE_HOME}" ] && export ANSIBLE_HOME="${XDG_DATA_HOME:-$HOME/.local/share}/ansible"

# NCurses terminfo (curses-based tools)
[ -z "${TERMINFO}" ] && export TERMINFO="${XDG_DATA_HOME:-$HOME/.local/share}/terminfo"
[ -z "${TERMINFO_DIRS}" ] && export TERMINFO_DIRS="${XDG_DATA_HOME:-$HOME/.local/share}/terminfo:/usr/share/terminfo"

# npm cache and init module location
export NPM_CONFIG_CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/npm"
export NPM_CONFIG_INIT_MODULE="${XDG_CONFIG_HOME:-$HOME/.config}/npm/config/npm-init.js"
if [ -n "${XDG_RUNTIME_DIR}" ]; then
  export NPM_CONFIG_TMP="${XDG_RUNTIME_DIR}/npm"
fi

# Codex config
[ -z "${CODEX_HOME}" ] && export CODEX_HOME="${XDG_CONFIG_HOME:-$HOME/.config}/codex"

# Vim info/history (only matters if using vanilla vim, not Neovim)
[ -z "${VIMINFO:-}" ] && export VIMINFO="${XDG_STATE_HOME:-$HOME/.local/state}/vim/viminfo"

# Pi Coding Agent config directory
[ -z "${PI_CODING_AGENT_DIR}" ] && export PI_CODING_AGENT_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/pi/agent"

# Context-mode data directory (sessions + indexed content).
# Keeps context-mode state out of the config dir and under XDG state home.
[ -z "${CONTEXT_MODE_DIR}" ] && export CONTEXT_MODE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/pi/context-mode"

# ── Dynamic PATH additions ──────────────────────────────────────────────────
# Tool-install dirs that must be on PATH for EVERY shell type, not just login
# shells — otherwise mise, zabrze, cargo/go binaries, and ~/.local/bin shims
# are missing in non-login interactive shells (bare tmux panes, editor
# terminals, terminals not spawned from a login shell). Checked at each shell
# start so newly installed tools appear without a chezmoi apply. zprofile
# re-prepends the same dirs on macOS, after path_helper -s rebuilds PATH.
# Idempotent: a dir already on PATH is not added again. Last entry wins
# priority, so ~/.local/bin (shims) is prepended last.
export PNPM_HOME="${XDG_DATA_HOME:-$HOME/.local/share}/pnpm"
for _d in \
  "$HOME/go/bin" \
  "$HOME/.cargo/bin" \
  "$PNPM_HOME/bin" \
  "$HOME/.local/bin" \
; do
  [ -d "$_d" ] || continue
  case ":$PATH:" in
    *":$_d:"*) ;;
    *) PATH="$_d:$PATH" ;;
  esac
done
unset _d
export PATH
