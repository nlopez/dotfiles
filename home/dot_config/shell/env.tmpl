{{- /* ~/.config/shell/env
   Sourced by every shell type to set XDG env vars and other shared environment.
   path_helper-sensitive PATH mods (keg-only brew) do NOT belong here —
   they go in zprofile so they land after macOS path_helper -s rebuilds PATH.
   Shell-agnostic tool dirs (~/.local/bin, cargo, go, pnpm) DO belong here so
   they reach non-login interactive shells too; zprofile re-prepends them on
   macOS after path_helper.
   Sourced by:
     • ~/.zshenv          → all zsh (login, interactive, non-interactive, scripts)
     • ~/.zprofile        → login zprofile (for XDG vars)
     • ~/.profile         → login bash and POSIX sh
     • $BASH_ENV          → every non-interactive bash subprocess
     • $ENV               → interactive sh subshells
   POSIX sh compatible — no bashisms, no zsh-isms.
*/ -}}
# Guard: skip if already loaded in this shell session.
[ -n "$_SHELL_ENV_LOADED" ] && return
_SHELL_ENV_LOADED=1

{{- if eq .chezmoi.os "darwin" }}
{{- $brewPrefixes := list "/opt/homebrew" "/usr/local" -}}
{{- $brewPrefix := "" -}}
{{- range $brewPrefixes -}}
  {{- if and (not $brewPrefix) (stat (printf "%s/bin/brew" .)) -}}
    {{- $brewPrefix = . -}}
  {{- end -}}
{{- end }}
{{- end }}

# ── XDG-redirected state ─────────────────────────────────────────────────────
# These move legacy ~/.<tool> state into XDG paths so xdg-ninja is clean.

# Bash history (sourced via BASH_ENV for non-interactive, ENV for sh subshells)
[ -n "${HISTFILE+x}" ] || HISTFILE="${XDG_STATE_HOME:-$HOME/.local/state}/bash/history"
export HISTFILE

# GnuPG data directory
[ -z "${GNUPGHOME}" ] && export GNUPGHOME="${XDG_DATA_HOME:-$HOME/.local/share}/gnupg"

# Cargo registry and local registry cache
[ -z "${CARGO_HOME}" ] && export CARGO_HOME="${XDG_DATA_HOME:-$HOME/.local/share}/cargo"

# Docker config (Docker Desktop ignores this, but CLI follows it)
[ -z "${DOCKER_CONFIG}" ] && export DOCKER_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/docker"

# Colima config directory (default ~/.colima ignored when COLIMA_HOME is set)
[ -z "${COLIMA_HOME}" ] && export COLIMA_HOME="${XDG_CONFIG_HOME:-$HOME/.config}/colima"
# Colima keeps its Lima instances here; point limactl at them
[ -z "${LIMA_HOME}" ] && export LIMA_HOME="${COLIMA_HOME}/_lima"

# Ansible runtime state
[ -z "${ANSIBLE_HOME}" ] && export ANSIBLE_HOME="${XDG_DATA_HOME:-$HOME/.local/share}/ansible"

# NCurses terminfo (curses-based tools)
[ -z "${TERMINFO}" ] && export TERMINFO="${XDG_DATA_HOME:-$HOME/.local/share}/terminfo"
[ -z "${TERMINFO_DIRS}" ] && export TERMINFO_DIRS="${XDG_DATA_HOME:-$HOME/.local/share}/terminfo:/usr/share/terminfo"

# npm cache and init module location
export NPM_CONFIG_CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/npm"
export NPM_CONFIG_INIT_MODULE="${XDG_CONFIG_HOME:-$HOME/.config}/npm/config/npm-init.js"
if [ -n "${XDG_RUNTIME_DIR}" ]; then
  export NPM_CONFIG_TMP="${XDG_RUNTIME_DIR}/npm"
fi

# Codex config
[ -z "${CODEX_HOME}" ] && export CODEX_HOME="${XDG_CONFIG_HOME:-$HOME/.config}/codex"

# Vim info/history (only matters if using vanilla vim, not Neovim)
[ -z "${VIMINFO:-}" ] && export VIMINFO="${XDG_STATE_HOME:-$HOME/.local/state}/vim/viminfo"

# Engram persistent memory (SQLite DB); defaults to ~/.engram otherwise.
[ -z "${ENGRAM_DATA_DIR}" ] && export ENGRAM_DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/engram"
{{- if and .personal (not .headless) }}
# Engram Cloud autosync (opt-in). Server URL + token live in $ENGRAM_DATA_DIR/cloud.json.
export ENGRAM_CLOUD_AUTOSYNC=1
{{- end }}

# aws-vault: cross-process locking for parallel invocations (e.g. terraform
# with many credential_process calls). All concurrent callers must opt in.
export AWS_VAULT_PARALLEL_SAFE=true
{{- if .workspace }}
# Workspaces have no keychain or Secret Service; use the encrypted file backend.
export AWS_VAULT_BACKEND=file
{{- end }}

# ── Dynamic PATH additions ──────────────────────────────────────────────────
# Tool-install dirs that must be on PATH for EVERY shell type, not just login
# shells — otherwise Nix/mise tools, zabrze, cargo/go binaries, and ~/.local/bin shims
# are missing in non-login interactive shells (bare tmux panes, editor
# terminals, terminals not spawned from a login shell). Checked at each shell
# start so newly installed tools appear without a chezmoi apply. zprofile
# re-prepends the same dirs on macOS, after path_helper -s rebuilds PATH.
# Idempotent: a dir already on PATH is not added again. Last entry wins
# priority, so the work package manager's shims (/opt/*/shims/bin), then ~/.local/bin, then ~/.local/bin/shims (which wins), are prepended last.
export PNPM_HOME="${XDG_DATA_HOME:-$HOME/.local/share}/pnpm"
for _d in \
  "$HOME/go/bin" \
  "$HOME/.cargo/bin" \
  "$PNPM_HOME/bin" \
  "{{ includeTemplate "nix-profile" . }}/bin" \
  "${XDG_DATA_HOME:-$HOME/.local/share}/mise/shims" \
{{- if .work }}
  $(ls -d /opt/*/shims/bin 2>/dev/null) \
{{- end }}
  "$HOME/.local/bin" \
  "$HOME/.local/bin/shims" \
; do
  [ -d "$_d" ] || continue
  case ":$PATH:" in
    *":$_d:"*) ;;
    *) PATH="$_d:$PATH" ;;
  esac
done
unset _d
export PATH
{{- if .workspace }}

# Workspaces: yarn switch (provisioned into the stock ~/.zshrc / ~/.bashrc).
[ -f "$HOME/.yarn/switch/env" ] && . "$HOME/.yarn/switch/env"

# Workspaces: /etc/profile.d/00-workspace-env.sh sets BROWSER=xdg-open. The npm
# `open` package runs its bundled freedesktop xdg-open, which clears a bare
# BROWSER=xdg-open (self-recursion guard) and then finds no browser. A full path
# passes through to the workspaces helper that forwards URLs to the local host.
if [ "$BROWSER" = "xdg-open" ] && [ -x "$HOME/.local/bin/xdg-open" ]; then
  export BROWSER="$HOME/.local/bin/xdg-open"
fi

# Workspaces: Nix store lives in ~/.local/share/nix, bind-mounted onto /nix
# (see run_onchange_after_45-nix-workspace). No systemd, so re-mount on the
# first shell after a container start.
if [ -d "${XDG_DATA_HOME:-$HOME/.local/share}/nix/store" ]; then
  mountpoint -q /nix 2>/dev/null \
    || sudo -n mount --bind "${XDG_DATA_HOME:-$HOME/.local/share}/nix" /nix 2>/dev/null
  export NIX_CONFIG="experimental-features = nix-command flakes"
  [ -f "$HOME/.nix-profile/etc/profile.d/nix.sh" ] && . "$HOME/.nix-profile/etc/profile.d/nix.sh"
fi

# Workspaces: systemd --user manager (PID 1 is s6, no logind). Start it when
# its recorded PID is not alive, e.g. the first shell after a container start.
# Builtins only: this file is sourced by every shell.
export XDG_RUNTIME_DIR="/run/user/$(id -u)"
_sd_pid=
[ -r "$XDG_RUNTIME_DIR/systemd-user.pid" ] && read -r _sd_pid <"$XDG_RUNTIME_DIR/systemd-user.pid"
if { [ -z "$_sd_pid" ] || [ ! -d "/proc/$_sd_pid" ]; } && [ -x "$HOME/.local/bin/start-systemd-user" ]; then
  "$HOME/.local/bin/start-systemd-user" >/dev/null 2>&1 || true
fi
unset _sd_pid
{{- end }}
