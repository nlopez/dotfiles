// This config is in the KDL format: https://kdl.dev
// "/-" comments out the following node.
// Check the wiki for a full description of the configuration:
// https://niri-wm.github.io/niri/Configuration:-Introduction
//
// Split into cfg/*.kdl, mirroring the structure shipped in /etc/skel/.config/niri.

include "./cfg/animation.kdl"
include "./cfg/autostart.kdl"
include "./cfg/keybinds.kdl"
include "./cfg/input.kdl"
include "./cfg/display.kdl"
include "./cfg/layout.kdl"
include "./cfg/rules.kdl"
include "./cfg/misc.kdl"

// noctalia-shell writes theme colors here (layout/focus-ring/border/recent-windows
// colors); it's regenerated whenever the active palette changes, so it's not
// tracked by chezmoi. See ~/.config/niri/noctalia.kdl on disk.
include "noctalia.kdl"
