{{- if and (eq .chezmoi.os "darwin") (eq .chezmoi.arch "arm64") (not .headless) -}}
# Read-only AWS sandbox policy for OpenShell (paired with provider: aws-sso-ro).
# Never wildcard *.amazonaws.com here — portal.sso.* must stay governed solely by
# the aws-sso-ro provider profile's query rule (role_name=read-only).
# STS is omitted by default so sandboxes cannot call sts:AssumeRole.
version: 1

network_policies:
  aws_s3_ro:
    binaries:
      - { path: /usr/local/aws-cli/v2/current/dist/aws }
      - { path: /usr/local/bin/aws }
      - { path: /usr/bin/aws }
      - { path: /usr/local/bin/python3.12 }
      - { path: /usr/local/bin/python3 }
      - { path: /usr/bin/python3 }
      - { path: /usr/bin/curl }
    endpoints:
      - host: "*.s3.us-east-1.amazonaws.com"
        port: 443
        protocol: rest
        rules:
          - allow:
              method: GET
              path: "/**"
          - allow:
              method: HEAD
              path: "/**"
      - host: s3.us-east-1.amazonaws.com
        port: 443
        protocol: rest
        rules:
          - allow:
              method: GET
              path: "/**"
          - allow:
              method: HEAD
              path: "/**"

  aws_ec2:
    binaries:
      - { path: /usr/local/aws-cli/v2/current/dist/aws }
      - { path: /usr/local/bin/aws }
      - { path: /usr/bin/aws }
      - { path: /usr/local/bin/python3.12 }
      - { path: /usr/local/bin/python3 }
      - { path: /usr/bin/python3 }
    endpoints:
      - host: ec2.us-east-1.amazonaws.com
        port: 443
        protocol: rest
        access: full

  aws_eks:
    binaries:
      - { path: /usr/local/aws-cli/v2/current/dist/aws }
      - { path: /usr/local/bin/aws }
      - { path: /usr/bin/aws }
      - { path: /usr/local/bin/python3.12 }
      - { path: /usr/local/bin/python3 }
      - { path: /usr/bin/python3 }
    endpoints:
      - host: eks.us-east-1.amazonaws.com
        port: 443
        protocol: rest
        access: full

  aws_logs:
    binaries:
      - { path: /usr/local/aws-cli/v2/current/dist/aws }
      - { path: /usr/local/bin/aws }
      - { path: /usr/bin/aws }
      - { path: /usr/local/bin/python3.12 }
      - { path: /usr/local/bin/python3 }
      - { path: /usr/bin/python3 }
    endpoints:
      - host: logs.us-east-1.amazonaws.com
        port: 443
        protocol: rest
        access: full

  aws_iam:
    binaries:
      - { path: /usr/local/aws-cli/v2/current/dist/aws }
      - { path: /usr/local/bin/aws }
      - { path: /usr/bin/aws }
      - { path: /usr/local/bin/python3.12 }
      - { path: /usr/local/bin/python3 }
      - { path: /usr/bin/python3 }
    endpoints:
      - host: iam.amazonaws.com
        port: 443
        protocol: rest
        access: full
{{- end }}
