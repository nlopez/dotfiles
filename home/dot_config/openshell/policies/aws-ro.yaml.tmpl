{{- if or (and (eq .chezmoi.os "darwin") (eq .chezmoi.arch "arm64") (not .headless)) (and .workspace (eq .chezmoi.os "linux") (or (eq .chezmoi.arch "arm64") (eq .chezmoi.arch "amd64"))) -}}
# Read-only AWS & Terragrunt/OpenTofu sandbox policy (paired with provider: aws-sso-ro).
# Never wildcard *.amazonaws.com here — portal.sso.* must stay governed solely by
# the aws-sso-ro provider profile's query rule (role_name=read-only).
# Note: pass `-lock=false` to `tofu plan` / `terragrunt ... -- plan -lock=false`
# because S3 state lockfiles require PutObject/DeleteObject, which both this
# policy (GET/HEAD only) and read-only IAM roles intentionally disallow.
version: 1

network_policies:
  aws_s3_ro:
    binaries:
      - { path: /usr/local/aws-cli/v2/current/dist/aws }
      - { path: /usr/local/bin/aws }
      - { path: /usr/bin/aws }
      - { path: /**/tofu }
      - { path: /**/terragrunt }
      - { path: /**/terraform-provider-aws* }
      - { path: /usr/local/bin/python3.12 }
      - { path: /usr/local/bin/python3 }
      - { path: /usr/bin/python3 }
      - { path: /usr/bin/curl }
    endpoints:
      - host: "*.s3.*.amazonaws.com"
        port: 443
        protocol: rest
        rules:
          - allow:
              method: GET
              path: "/**"
          - allow:
              method: HEAD
              path: "/**"
      - host: "s3.*.amazonaws.com"
        port: 443
        protocol: rest
        rules:
          - allow:
              method: GET
              path: "/**"
          - allow:
              method: HEAD
              path: "/**"

  aws_plan_apis:
    binaries:
      - { path: /usr/local/aws-cli/v2/current/dist/aws }
      - { path: /usr/local/bin/aws }
      - { path: /usr/bin/aws }
      - { path: /**/tofu }
      - { path: /**/terragrunt }
      - { path: /**/terraform-provider-aws* }
      - { path: /usr/local/bin/python3.12 }
      - { path: /usr/local/bin/python3 }
      - { path: /usr/bin/python3 }
    endpoints:
      # Required by OpenTofu AWS provider for allowed_account_ids (sts:GetCallerIdentity).
      - host: "sts.*.amazonaws.com"
        port: 443
        protocol: rest
        access: full
      - host: sts.amazonaws.com
        port: 443
        protocol: rest
        access: full
      - host: "ec2.*.amazonaws.com"
        port: 443
        protocol: rest
        access: full
      - host: "elasticloadbalancing.*.amazonaws.com"
        port: 443
        protocol: rest
        access: full
      - host: route53.amazonaws.com
        port: 443
        protocol: rest
        access: full
      - host: route53domains.us-east-1.amazonaws.com
        port: 443
        protocol: rest
        access: full
      - host: iam.amazonaws.com
        port: 443
        protocol: rest
        access: full
      - host: "eks.*.amazonaws.com"
        port: 443
        protocol: rest
        access: full
      - host: "logs.*.amazonaws.com"
        port: 443
        protocol: rest
        access: full
{{- end }}
