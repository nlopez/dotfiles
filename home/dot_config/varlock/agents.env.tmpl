{{- if not .headless -}}
# Secrets for AI agent tools and CLIs. Never exported from a shell profile or
# injected into an agent: each MCP server or CLI shim that needs one is launched
# through `varlock run -p <this file> --filter <KEY>`, so only that process sees it.
#
# @plugin(@varlock/1password-plugin@2.0.7)
{{- if and .personal (not .work) (eq .chezmoi.os "darwin") }}
# @initOp(token=$OP_TOKEN, account=my.1password.com)
# ---

# Read-only service account for the Automation vault, from the Keychain, so
# launching an MCP server never prompts for app auth.
# @type=opServiceAccountToken @sensitive @internal
OP_TOKEN=exec("security find-generic-password -a {{ .chezmoi.username }} -s op-service-account-automation -w")
{{- else if .work }}
# @initOp(allowAppAuth=true, account={{ (includeTemplate "private-data" . | fromYaml).onepassword_account }})
# ---
{{- else }}
# @initOp(allowAppAuth=true, account=my.1password.com)
# ---
{{- end }}

