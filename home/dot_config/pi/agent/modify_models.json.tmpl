import json
import sys

current_raw = sys.stdin.read()
current = {}
try:
    if current_raw.strip():
        current = json.loads(current_raw)
except Exception:
    pass

current.setdefault("providers", {})

IS_WORK = {{ if .work }}True{{ else }}False{{ end }}
WORK_EMAIL = {{ .workemail | quote }}

if IS_WORK:
    # ---------------------------------------------------------------------------
    # AI Gateway providers — internal proxy for Anthropic, OpenAI, and Google.
    # Token is fetched at runtime via ddtool (short-lived SSO token, no secrets
    # stored here). Requires AppGate VPN.
    # ---------------------------------------------------------------------------
    AIGW_BASE = "https://ai-gateway.us1.prod.dog"
    AIGW_TOKEN_CMD = "!ddtool auth token rapid-ai-platform --datacenter us1.prod.dog"

    # Common headers — source identifies the caller; org-id is the internal
    # engineering org; force-redaction keeps prompts out of LLM Observability.
    common_headers = {
        "source": "pi",
        "org-id": "2",
        "x-llmo-force-redaction": "true",
        "x-dd-tag-ml_app": "pi",
    }
    if WORK_EMAIL:
        common_headers["x-dd-tag-dd.user_email"] = WORK_EMAIL

    work_providers = {
        # Anthropic (claude-sonnet-4, claude-opus-4, …)
        # Uses Anthropic's native messages API shape via AIGW.
        # compat flag disables eager_input_streaming to avoid 400s on Bedrock routing.
        "ai-gw-anthropic": {
            "baseUrl": AIGW_BASE,
            "api": "anthropic-messages",
            "apiKey": AIGW_TOKEN_CMD,
            "authHeader": True,
            "headers": {**common_headers, "provider": "anthropic"},
            "compat": {"supportsEagerToolInputStreaming": False},
            "models": [
                {"id": "anthropic/claude-sonnet-4-20250514", "name": "Claude Sonnet 4"},
                {"id": "anthropic/claude-opus-4-20250514", "name": "Claude Opus 4"},
                {"id": "anthropic/claude-3-7-sonnet-20250219", "name": "Claude 3.7 Sonnet"},
                {"id": "anthropic/claude-3-5-sonnet-20241022", "name": "Claude 3.5 Sonnet"},
                {"id": "anthropic/claude-3-5-haiku-20241022", "name": "Claude 3.5 Haiku"},
            ],
        },
        # OpenAI (gpt-4.1, o4-mini, o3, …)
        # Uses OpenAI responses API via AIGW.
        "ai-gw-openai": {
            "baseUrl": f"{AIGW_BASE}/v1",
            "api": "openai-responses",
            "apiKey": AIGW_TOKEN_CMD,
            "headers": common_headers,
            "models": [
                {"id": "openai/gpt-4.1", "name": "GPT-4.1"},
                {"id": "openai/gpt-4o", "name": "GPT-4o"},
                {"id": "openai/o4-mini", "name": "o4-mini"},
                {"id": "openai/o3", "name": "o3"},
            ],
        },
        # Google Gemini — uses /v1beta endpoint with google-generative-ai API.
        # Requires provider header and authHeader mode.
        "ai-gw-google": {
            "baseUrl": f"{AIGW_BASE}/v1beta",
            "api": "google-generative-ai",
            "apiKey": AIGW_TOKEN_CMD,
            "authHeader": True,
            "headers": {**common_headers, "provider": "google"},
            "models": [
                {"id": "gemini/models/gemini-2.5-pro-preview-05-06", "name": "Gemini 2.5 Pro"},
                {"id": "gemini/models/gemini-2.5-flash-preview-05-20", "name": "Gemini 2.5 Flash"},
            ],
        },
    }

    for provider_id, provider_config in work_providers.items():
        existing = current["providers"].get(provider_id, {})
        # Preserve model list refreshed by /refresh-models (non-empty wins).
        existing_models = existing.get("models", [])
        current["providers"][provider_id] = provider_config
        if existing_models:
            current["providers"][provider_id]["models"] = existing_models

print(json.dumps(current, indent=2))
