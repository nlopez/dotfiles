#!/bin/sh
# Merge chezmoi-managed keys into mcp.json, preserving runtime keys that pi
# writes itself (e.g. directTools). Uses jq's recursive-merge operator so the
# chezmoi overlay wins on conflicts, but unrecognised keys are kept as-is.

OVERLAY=$(cat << 'EOF'
{
  "settings": {
    "autoAuth": true
  },
  "mcpServers": {
    {{- if .work }}
    "datadog": {
      "url": "{{ onepasswordRead "op://ed52wahww5txzax6reg4me3bl4/mcp-datadog/url" }}",
      "auth": "oauth"
    },
    "ddstaging": {
      "url": "{{ onepasswordRead "op://ed52wahww5txzax6reg4me3bl4/mcp-ddstaging/url" }}",
      "auth": "oauth"
    },
    "atlassian": {
      "url": "{{ onepasswordRead "op://ed52wahww5txzax6reg4me3bl4/mcp-atlassian/url" }}",
      "auth": "oauth"
    },
    "slack": {
      "url": "{{ onepasswordRead "op://ed52wahww5txzax6reg4me3bl4/mcp-slack/url" }}",
      "auth": "oauth",
      "oauth": {
        "clientId": "{{ onepasswordRead "op://ed52wahww5txzax6reg4me3bl4/mcp-slack/client_id" }}"
      }
    },
    "datadog-google-workspace": {
      "type": "http",
      "url": "{{ onepasswordRead "op://ed52wahww5txzax6reg4me3bl4/mcp-datadog-google-workspace/url" }}"
    },
    "supportdog-mcp-us1": {
      "type": "http",
      "url": "{{ onepasswordRead "op://ed52wahww5txzax6reg4me3bl4/mcp-supportdog-us1/url" }}"
    },
    "ddci-mcp-prod": {
      "url": "{{ onepasswordRead "op://ed52wahww5txzax6reg4me3bl4/mcp-ddci-prod/url" }}",
      "auth": "oauth"
    }
    {{- end }}
  }
}
EOF
)

current=$(cat)

if [ -z "$current" ]; then
  printf '%s\n' "$OVERLAY"
else
  printf '%s\n' "$current" | jq --argjson overlay "$OVERLAY" '. * $overlay | del(.mcpServers.figma, .mcpServers["supportdog-mcp-staging"], .mcpServers["supportdog-mcp-us3"], .mcpServers["supportdog-mcp-us5"], .mcpServers["supportdog-mcp-eu1"], .mcpServers["supportdog-mcp-ap1"], .mcpServers["supportdog-mcp-ap2"])'
fi
