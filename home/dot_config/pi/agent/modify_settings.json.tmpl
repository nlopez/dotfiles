import json
import sys

current_raw = sys.stdin.read()
current = {}
try:
    if current_raw.strip():
        current = json.loads(current_raw)
except Exception:
    pass


# Theme: sensible default; auto-theme extension syncs with macOS appearance.
current.setdefault("theme", "solarized-light")

# Preserve defaultModel and defaultProvider if set interactively.
# These are NOT managed by chezmoi — whatever you set via Pi stays put.
# (If absent, Pi auto-selects the first available scoped model.)
