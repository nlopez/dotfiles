# Use npm for package operations. pnpm's strict linking breaks Pi's
# extension loader which resolves modules from the literal symlink path,
# not the realpath inside .pnpm/. npm hoists by default.
current["npmCommand"] = ["npm"]

# Hardware cursor — enabled on startup.
current["showHardwareCursor"] = True

# Declarative package list — exactly and only these packages.
# Source of truth: home/.chezmoidata/pi.yaml
# personal_only_packages are excluded on work machines.
# Work-only local packages (datadog-pi-packages) are appended below.
current["packages"] = [
{{- range .pi.packages }}
    "{{ . }}",
{{- end }}
{{- if not .work }}
{{- range .pi.personal_only_packages }}
    "{{ . }}",
{{- end }}
{{- end }}
{{- if .work }}
    # Local package from ddoghq-sandbox/datadog-pi-packages (cloned once by chezmoi).
    # Provides /refresh-models command to sync AI Gateway model inventory.
    "{{ .chezmoi.homeDir }}/dd/datadog-pi-packages/packages/refresh-models",
{{- end }}
]

# Compaction settings.
current.setdefault("compaction", {
    "enabled": True,
    "reserveTokens": 32768,
})

print(json.dumps(current, indent=2))
