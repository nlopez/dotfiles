#!/usr/bin/env python3
# Managed by chezmoi — source: home/dot_pi/agent/modify_settings.json.tmpl
# ⚠️  DO NOT EDIT ~/.pi/agent/settings.json directly. It is overwritten
#     by chezmoi on every `chezmoi apply`. Always edit the source tree.
#
# This is a chezmoi templated modify_ script. Chezmoi first renders the Go
# template (injecting the package list from .chezmoidata/pi.yaml), then
# executes the resulting Python script. The script receives the current
# settings.json contents on stdin and writes the replacement JSON to stdout.
#
# Configures: theme, npmCommand, showHardwareCursor, compaction,
#             and the declarative package list.
# Default model: anthropic / claude-sonnet-5-5 (Claude Sonnet 5.5).
import json
import sys

current_raw = sys.stdin.read()
current = {}
try:
    if current_raw.strip():
        current = json.loads(current_raw)
except Exception:
    pass


# Theme: sensible default; auto-theme extension syncs with macOS appearance.
current.setdefault("theme", "solarized-light")

# Default model — declared here so it is identical on every machine.
current["defaultProvider"] = "anthropic"
current["defaultModel"] = "claude-sonnet-5-5"

# Use npm for package operations. pnpm's strict linking breaks Pi's
# extension loader which resolves modules from the literal symlink path,
# not the realpath inside .pnpm/. npm hoists by default.
current["npmCommand"] = ["npm"]

# Hardware cursor — enabled on startup.
current["showHardwareCursor"] = True

# Regular TUI mode: use the terminal's normal scrollback instead of the
# fullscreen alternate screen, so tmux copy-mode search (prefix+[, then /)
# can find text from the pi transcript.
current["tuiMode"] = "regular"

# Declarative package list — exactly and only these packages.
# Source of truth: home/.chezmoidata/pi.yaml
# personal_only_packages are excluded on work machines.
# Work-only local packages (datadog-pi-packages) are appended below.
current["packages"] = [
{{- range .pi.packages }}
    "{{ . }}",
{{- end }}
{{- range .pi.git_packages }}
    "{{ . }}",
{{- end }}
{{- if not .work }}
{{- range .pi.personal_only_packages }}
    "{{ . }}",
{{- end }}
{{- end }}
{{- if .work }}
    # Local package from ddoghq-sandbox/datadog-pi-packages (cloned once by chezmoi).
    # Provides /refresh-models command to sync AI Gateway model inventory.
    "{{ .chezmoi.homeDir }}/dd/datadog-pi-packages/packages/refresh-models",
{{- end }}
]

# Skills discovery paths:
# - ~/.claude/skills: standard Claude Code skill location.
# - ~/.config/pi/agent/skills: XDG-compliant Pi skills (matches PI_CODING_AGENT_DIR).
skills = current.get("skills", [])
for path in ["~/.claude/skills", "~/.config/pi/agent/skills"]:
    if path not in skills:
        skills.append(path)
current["skills"] = skills

# Enable /skill: slash commands in Pi sessions.
current["enableSkillCommands"] = True

# Compaction settings.
current.setdefault("compaction", {
    "enabled": True,
    "reserveTokens": 32768,
})

print(json.dumps(current, indent=2))
