#!/usr/bin/env python3
# Managed by chezmoi — source: home/dot_config/claude/modify_settings.json
# ⚠️  DO NOT EDIT ~/.config/claude/settings.json for these keys; they are reset on
#     every `chezmoi apply`. All other keys are left untouched.
#
# Receives the current settings.json on stdin, writes the replacement to stdout.
#
# Configures: attribution (empty strings disable the Co-Authored-By trailer
#             on commits and the "Generated with Claude Code" line on PRs).
# Removes:    custom hooks, statusLine, ECC env, and all plugin/marketplace entries
#             except engram, context-mode and worktrunk (Claude is kept close to stock). Plugins themselves are
#             uninstalled by .chezmoiscripts/run_onchange_after_20-claude-plugins-remove.sh.tmpl.
import json
import os
import sys

current_raw = sys.stdin.read()
current = {}
try:
    if current_raw.strip():
        current = json.loads(current_raw)
except Exception:
    pass

current["attribution"] = {"commit": "", "pr": ""}

# Stock cleanup: drop leftovers from the removed ECC plugin and custom hooks/statusline.
for key in ("hooks", "statusLine"):
    current.pop(key, None)
for key in ("ECC_DISABLED_MCPS", "_ZO_DOCTOR"):
    current.get("env", {}).pop(key, None)
for plugin in (
    "ecc@ecc",
    "gopls-lsp@claude-plugins-official",
    "pr-review-toolkit@claude-plugins-official",
    "frontend-design@claude-plugins-official",
):
    current.get("enabledPlugins", {}).pop(plugin, None)
for marketplace in ("ecc", "cloudflare"):
    current.get("extraKnownMarketplaces", {}).pop(marketplace, None)

# Engram: pin one data dir so hooks and the MCP server never fall back to ~/.engram
# when Claude isn't launched from a shell that exports ENGRAM_DATA_DIR (see
# dot_config/shell/env.tmpl), and drop permissions for the nonexistent
# plugin-provided MCP server (`engram setup claude-code` registers a user-level
# `engram` server, so only mcp__engram__* is real).
xdg_data = os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share")
current.setdefault("env", {})["ENGRAM_DATA_DIR"] = os.path.join(xdg_data, "engram")

# Context-mode: Claude's own state dir (shell env.tmpl exports pi's CONTEXT_MODE_DIR,
# which Claude would otherwise inherit and share sessions/index with pi).
xdg_state = os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state")
current["env"]["CONTEXT_MODE_DIR"] = os.path.join(xdg_state, "claude", "context-mode")

permissions = current.get("permissions", {})
if "allow" in permissions:
    permissions["allow"] = [
        p for p in permissions["allow"] if not p.startswith("mcp__plugin_engram_engram__")
    ]

print(json.dumps(current, indent=2))
