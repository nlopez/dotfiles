{{- $arch := .chezmoi.arch -}}
{{- if eq $arch "amd64" }}{{ $arch = "x86_64" }}{{ else if eq $arch "arm64" }}{{ $arch = "aarch64" }}{{ end -}}
# Generated by chezmoi from .chezmoidata/nix.yaml — edit that file, not this one.
# Built into {{ includeTemplate "nix-profile" . }}
# by .chezmoiscripts/run_after_00-nix-packages.sh.tmpl.
{
  description = "Packages declared in the chezmoi dotfiles";

  inputs.nixpkgs.url = "github:NixOS/nixpkgs/{{ .nix.nixpkgs_rev }}";

  outputs =
    { nixpkgs, ... }:
    let
      system = "{{ $arch }}-{{ .chezmoi.os }}";
      inherit (nixpkgs) lib;
      pkgs = import nixpkgs {
        inherit system;
        config.allowUnfreePredicate =
          pkg:
          builtins.elem (lib.getName pkg) [
{{- range .nix.unfree }}
            {{ . | quote }}
{{- end }}
          ];
      };
      # Packages defined here rather than in nixpkgs, named `dotfiles.<attr>`
      # in .chezmoidata/nix.yaml.
      dotfiles = {
        # GNU sed and grep as gsed and ggrep, without shadowing the BSD tools.
        gnu-prefixed = pkgs.runCommand "gnu-prefixed" { } ''
          mkdir -p $out/bin
          ln -s ${pkgs.gnused}/bin/sed $out/bin/gsed
          ln -s ${pkgs.gnugrep}/bin/grep $out/bin/ggrep
        '';
      };
      manifest = {{ includeTemplate "nix-manifest" . | quote }};
      names = [
{{- range (includeTemplate "nix-packages" . | fromJson) }}
        {{ . | quote }}
{{- end }}
      ];
    in
    {
      packages.${system}.default = pkgs.buildEnv {
        name = "dotfiles-packages";
        paths = map (name: lib.getAttrFromPath (lib.splitString "." name) (pkgs // { inherit dotfiles; })) names;
        # Only link what a shell needs; each package still reads its own store
        # path for everything else. Keeps unrelated lib/ trees from colliding.
        pathsToLink = [
          "/bin"
          "/share/man"
          "/share/info"
          "/share/zsh"
          "/share/bash-completion"
          "/share/fish"
        ];
        extraOutputsToInstall = [ "man" ];
        # Read back by scripts/package-plan.py to diff declared vs installed.
        postBuild = ''
          cp ${builtins.toFile "dotfiles-manifest.json" manifest} $out/.dotfiles-manifest.json
        '';
      };
    };
}
