# Fish abbreviations — generated from chezmoi source.
# Simple abbrs share aliases.yaml with zabrze; complex snippets are adapted
# below for fish syntax (fish uses (...) not $(...) for subshells).

# ── From aliases.yaml ─────────────────────────────────────────────────────────
{{ range .aliases -}}
abbr --add{{ if index . "global" }} --position anywhere{{ end }}{{ if index . "cursor" }} --set-cursor={{ .cursor | squote }}{{ end }} {{ .name | squote }} {{ .cmd | squote }}
{{ end }}
# ── .1 ───────────────────────────────────────────────────────────────────────
abbr --add '.1' "awk '{print \$1}'"

# ── brewup ────────────────────────────────────────────────────────────────────
abbr --add brewup 'brew update && brew upgrade && brew cleanup'

# ── gcd (checkout default branch) ─────────────────────────────────────────────
abbr --add gcd 'git checkout (git remote show origin | sed -n "s/.*HEAD branch: \(.*\)/\1/p")'

# ── groot (repo root, expands anywhere on the line) ───────────────────────────
abbr --add --position anywhere groot '(git rev-parse --show-toplevel)'
