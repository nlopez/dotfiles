#!/usr/bin/env bash
# prepare-commit-msg: Automatically append Pi as a co-author on every commit.
#
# The co-author line includes the active Pi model read from settings, e.g.:
#   Co-authored-by: Pi (anthropic/claude-sonnet-4) <pi@earendil.works>
#
# Hook arguments:
#   $1  Path to the file containing the commit log message.
#   $2  Source of the message: message | template | merge | squash | commit
#   $3  Commit SHA-1 (only when amending).

COMMIT_MSG_FILE="$1"
COMMIT_SOURCE="$2"

# Skip merge commits — the commit message is generated automatically.
[ "$COMMIT_SOURCE" = "merge" ] && exit 0

# ---------------------------------------------------------------------------
# Resolve the active Pi model from ~/.pi/agent/settings.json
# ---------------------------------------------------------------------------
PI_SETTINGS="${HOME}/.pi/agent/settings.json"
PI_MODEL=""

if [ -f "$PI_SETTINGS" ]; then
  if command -v jq >/dev/null 2>&1; then
    provider=$(jq -r '.defaultProvider // empty' "$PI_SETTINGS" 2>/dev/null)
    model=$(jq -r '.defaultModel // empty'    "$PI_SETTINGS" 2>/dev/null)
  elif command -v python3 >/dev/null 2>&1; then
    pi_info=$(python3 -c "
import json, sys
try:
    d = json.load(open(sys.argv[1]))
    print(d.get('defaultProvider',''), d.get('defaultModel',''))
except Exception:
    pass
" "$PI_SETTINGS" 2>/dev/null)
    provider=$(echo "$pi_info" | cut -d' ' -f1)
    model=$(echo    "$pi_info" | cut -d' ' -f2-)
  fi

  [ -n "$provider" ] && [ -n "$model" ] && PI_MODEL="${provider}/${model}"
  [ -z "$PI_MODEL"  ] && [ -n "$model" ] && PI_MODEL="$model"
fi

if [ -n "$PI_MODEL" ]; then
  CO_AUTHOR="Co-authored-by: Pi (${PI_MODEL}) <pi@earendil.works>"
else
  CO_AUTHOR="Co-authored-by: Pi <pi@earendil.works>"
fi

# ---------------------------------------------------------------------------
# Idempotency: skip if any Pi co-author trailer is already present.
# Match broadly (any model variant) to avoid duplicates on amend.
# ---------------------------------------------------------------------------
if grep -q "^Co-authored-by: Pi" "$COMMIT_MSG_FILE"; then
  exit 0
fi

# Git trailers must be separated from the message body by a blank line.
printf '\n%s\n' "$CO_AUTHOR" >> "$COMMIT_MSG_FILE"
