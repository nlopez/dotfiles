#!/bin/sh
# pre-commit hook: refuse to commit in a repo's main worktree while it has
# linked worktrees. Repos worked through worktrees keep the main clone on its
# default branch, shared by every session; repos with no linked worktrees are
# not affected. Wired up globally via [hook "no-main-worktree-commit"] in
# ~/.config/git/config. Bypass for a one-off with `git commit --no-verify`.

[ "$(git rev-parse --git-dir)" = "$(git rev-parse --git-common-dir)" ] || exit 0
[ "$(git worktree list --porcelain | grep -c '^worktree ')" -gt 1 ] || exit 0

cat >&2 <<'EOF'
error: refusing to commit in the main worktree of a repo that uses linked worktrees
Other sessions share this checkout. Create a worktree for the change:
  wt switch --create <branch>
AI agents: do not bypass this; move your change to its own worktree.
EOF
exit 1
