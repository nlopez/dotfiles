#!/bin/sh
# pre-push hook: refuse to push commits that carry no signature (or a bad one).
# Wired up globally via [hook "require-signed-push"] in ~/.config/git/config,
# so it runs alongside any repo-local .git/hooks/pre-push.
#
# Only commits not already on some remote-tracking ref are checked, so
# pushing branches that contain other people's published (unsigned) history
# still works. Bypass for a one-off with `git push --no-verify`.

zero=$(git hash-object --stdin </dev/null | tr '0-9a-f' '0')
status=0

while read -r local_ref local_oid remote_ref remote_oid; do
  # Branch/tag deletion: nothing to check.
  [ "$local_oid" = "$zero" ] && continue

  # %G?: N = no signature, B = bad signature. Anything else (G/U/X/Y/R/E)
  # means the commit is signed, even if this host can't fully verify it.
  bad=$(git log --format='%G? %h %s' "$local_oid" --not --remotes 2>/dev/null |
    grep -E '^[NB] ')

  if [ -n "$bad" ]; then
    printf 'error: refusing to push unsigned commits to %s:\n' "$remote_ref" >&2
    printf '%s\n' "$bad" | sed 's/^N /  unsigned  /; s/^B /  bad sig   /' >&2
    status=1
  fi
done

if [ "$status" -ne 0 ]; then
  printf '\nSign them with: git rebase --force-rebase --gpg-sign <base>\n' >&2
fi
exit "$status"
