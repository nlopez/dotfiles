[user]
  useConfigOnly = true
  name = Anonymous
  email = noreply@example.org

[push]
  default = current
  autoSetupRemote = true

[core]
  quotepath = false
  autocrlf = input
  safecrlf = false
  symlinks = true
  editor = vim
  fsmonitor = true

[feature]
  manyFiles = true

[index]
  threads = true
  version = 4

[credential]
  helper = manager

[pull]
  rebase = true

[checkout]
  defaultRemote = origin

[worktree]
  guessRemote = true

; Per-identity SSH keys are selected via core.sshCommand in each identity
; include (see config_nlopez, config_nick-lopez_ddog, config_silentshout42).
; Remotes use natural github.com URLs — no insteadOf rewrites needed.

[init]
  defaultBranch = main

[diff]
  renameLimit = 10000

[commit]
  gpgsign = false

[tag]
  gpgsign = false

[gpg]
  format = ssh

[gpg "ssh"]
  allowedSignersFile = ~/.config/git/allowed_signers
  program = {{ .platform.gpg_op_path }}

[alias]
  # Current branch name (git 2.22+)
  name = branch --show-current
  current-branch = branch --show-current
  # Default branch ref on origin (e.g. origin/main). If this fails, run: git remote set-head origin --auto
  default-ref = rev-parse --abbrev-ref origin/HEAD
  # Merge base with an origin branch (defaults to origin/HEAD)
  mbase = "!f(){ git merge-base HEAD origin/${1:-HEAD}; }; f"
  # Squash current branch relative to default branch
  squash = "!f(){ git reset --soft $(git merge-base $(git default-ref) HEAD) && git commit -am \"${1}\"; }; f"
  # Safer force push: --force-if-includes (git 2.30+) refuses to clobber remote commits not in your reflog
  pushf = push --force-with-lease --force-if-includes
  # subtree add/update (branch defaults to main; override via 3rd arg)
  sba = "!f(){ git subtree add --prefix $2 $1 ${3:-main} --squash; }; f"
  sbu = "!f(){ git subtree pull --prefix $2 $1 ${3:-main} --squash; }; f"
  ls-subtrees = !git log | grep git-subtree-dir | awk '{ print $2 }' | sort -u
  # Switch to branch, creating if it doesn't exist (git 2.23+)
  cob = "!f(){ git switch \"$1\" 2>/dev/null || git switch -c \"$1\"; }; f"
  upstream = !git config --get branch.$(git branch --show-current).remote || echo origin
  hard-reset = !git reset --hard $(git upstream)/$(git branch --show-current)
  pprune = fetch --prune
  # Log/diff commits on current branch since diverging from default
  branchlog = !git log $(git default-ref)..HEAD
  branchdiff = !git diff $(git default-ref)...HEAD
  root = rev-parse --show-toplevel
  st = status --ignored
  fcommit = commit --no-verify
  default-branch = !gh repo view --json defaultBranchRef --jq '.defaultBranchRef.name'
  branches = for-each-ref --sort='-authordate:iso8601' --format='%(color:red)%(authordate:short)%(color:default) %(color:blue)%(authorname)%(color:default) %(color:green)%(refname:short)%(color:default)' refs/heads
  branchesr = for-each-ref --sort='-authordate:iso8601' --format='%(color:red)%(authordate:short)%(color:default) %(color:blue)%(authorname)%(color:default) %(color:green)%(refname:short)%(color:default)' refs/remotes
  prettylog = log --pretty=format:'%C(yellow)%h %Cred%ad %Cblue%an%Cgreen%d %Creset%s' --date=short
  whoami = "!\
    ssh_cmd=$(git config --get core.sshCommand 2>/dev/null); \
    printf 'name:       %s\\nemail:      %s\\nsigningkey: %s\\nssh:        ' \
      \"$(git config user.name)\" \
      \"$(git config user.email)\" \
      \"$(git config user.signingkey)\"; \
    ${ssh_cmd:-ssh} -T git@github.com 2>&1 | head -1 \
  "

; Automatically sign commits and tags (only active when an include sets
; gpgsign = true), and add a DCO signoff line.
[format]
  signoff = true

{{/* Per-identity includes go last so they override defaults above.       */}}
{{/* Primary: gitdir-based (covers all URL variants for a given clone).   */}}

; --- nlopez identity: DataDog + nlopez personal repos + chezmoi ---

[includeIf "gitdir/i:~/src/github.com/datadog/**"]
  path = config_nlopez

[includeIf "gitdir/i:~/src/github.com/nlopez/**"]
  path = config_nlopez

[includeIf "gitdir/i:~/.local/share/chezmoi/.git"]
  path = config_nlopez

[includeIf "gitdir/i:~/.local/share/chezmoi/.git/worktrees/**"]
  path = config_nlopez

; --- nick-lopez_ddog identity: ddoghq + ddoghq-sandbox org repos ---
{{- if .work }}

[includeIf "gitdir/i:~/src/github.com/ddoghq/**"]
  path = config_nick-lopez_ddog

[includeIf "gitdir/i:~/src/github.com/ddoghq-sandbox/**"]
  path = config_nick-lopez_ddog
{{- end }}

; --- silentshout42 identity: silentshout42 + kamotimestamps org repos ---
{{- if .personal }}

[includeIf "gitdir/i:~/src/github.com/silentshout42/**"]
  path = config_silentshout42

[includeIf "gitdir/i:~/src/github.com/kamotimestamps/**"]
  path = config_silentshout42
{{- end }}

{{/* Fallback: hasconfig catches repos cloned outside the canonical      */}}
{{/* directory tree. Case-insensitive via [Xx] character classes because  */}}
{{/* hasconfig globs are case-sensitive (unlike gitdir/i). Both HTTPS     */}}
{{/* and SSH SCP-style (git@host:path) URL formats are covered so that   */}}
{{/* credential.username and core.sshCommand resolve for either transport.*/}}

; --- nlopez identity fallbacks ---

[includeIf "hasconfig:remote.*.url:https://github.com/[Dd]ata[Dd]og/**"]
  path = config_nlopez

[includeIf "hasconfig:remote.*.url:git@github.com:[Dd]ata[Dd]og/**"]
  path = config_nlopez

[includeIf "hasconfig:remote.*.url:https://github.com/[Nn][Ll]opez/**"]
  path = config_nlopez

[includeIf "hasconfig:remote.*.url:git@github.com:[Nn][Ll]opez/**"]
  path = config_nlopez

; --- nick-lopez_ddog identity fallbacks ---
{{- if .work }}

[includeIf "hasconfig:remote.*.url:https://github.com/[Dd][Dd]oghq/**"]
  path = config_nick-lopez_ddog

[includeIf "hasconfig:remote.*.url:git@github.com:[Dd][Dd]oghq/**"]
  path = config_nick-lopez_ddog

[includeIf "hasconfig:remote.*.url:https://github.com/[Dd][Dd]oghq-[Ss]andbox/**"]
  path = config_nick-lopez_ddog

[includeIf "hasconfig:remote.*.url:git@github.com:[Dd][Dd]oghq-[Ss]andbox/**"]
  path = config_nick-lopez_ddog
{{- end }}

; --- silentshout42 identity fallbacks ---
{{- if .personal }}

[includeIf "hasconfig:remote.*.url:https://github.com/[Ss]ilent[Ss]hout42/**"]
  path = config_silentshout42

[includeIf "hasconfig:remote.*.url:git@github.com:[Ss]ilent[Ss]hout42/**"]
  path = config_silentshout42

[includeIf "hasconfig:remote.*.url:https://github.com/[Kk]amo[Tt]imestamps/**"]
  path = config_silentshout42

[includeIf "hasconfig:remote.*.url:git@github.com:[Kk]amo[Tt]imestamps/**"]
  path = config_silentshout42
{{- end }}
