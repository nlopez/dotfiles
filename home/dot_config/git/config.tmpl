[user]
  useConfigOnly = true
  name = Anonymous
  email = noreply@example.org

[push]
  default = current
  autoSetupRemote = true

[core]
  quotepath = false
  autocrlf = input
  safecrlf = false
  symlinks = true
  editor = vim
  fsmonitor = true
{{- if or .wsl (eq .chezmoi.os "windows") }}
  sshCommand = ssh.exe
{{- end }}

[feature]
  manyFiles = true

[index]
  threads = true
  version = 4

[credential]
{{- if or .wsl (eq .chezmoi.os "windows") }}
  helper = manager.exe
{{- else }}
  helper = manager
{{- end }}

[pull]
  rebase = true

[checkout]
  defaultRemote = origin

[worktree]
	guessRemote = true

; Default github.com is anonymous (no key). All org clones must be routed
; through a per-org SSH alias below. Longest-match wins for insteadOf, so the
; per-org rules override any generic https→ssh rewrite.

[url "git@github.com-nlopez:DataDog/"]
  insteadOf = git@github.com:DataDog/
  insteadOf = https://github.com/DataDog/

[url "git@github.com-nlopez:nlopez/"]
  insteadOf = git@github.com:nlopez/
  insteadOf = https://github.com/nlopez/
{{- if .work }}
[url "git@github.com-ddog:ddoghq/"]
  insteadOf = git@github.com:ddoghq/
  insteadOf = https://github.com/ddoghq/

[url "git@github.com-ddog:ddoghq-sandbox/"]
  insteadOf = git@github.com:ddoghq-sandbox/
  insteadOf = https://github.com/ddoghq-sandbox/
{{- end }}

{{- if .personal }}
[url "git@github.com-hobby:silentshout42/"]
  insteadOf = git@github.com:silentshout42/
  insteadOf = https://github.com/silentshout42/

[url "git@github.com-hobby:kamotimestamps/"]
  insteadOf = git@github.com:kamotimestamps/
  insteadOf = https://github.com/kamotimestamps/
{{- end }}

[init]
  defaultBranch = main

[diff]
  renameLimit = 10000

[log]
  showSignature = true

[commit]
  gpgsign = false

[tag]
  gpgsign = false

[gpg]
  format = ssh

[gpg "ssh"]
  allowedSignersFile = ~/.config/git/allowed_signers
{{- if .wsl }}
  program = op-ssh-sign-wsl.exe
{{- else if eq .chezmoi.os "windows" }}
  program = op-ssh-sign.exe
{{- end }}

[alias]
  # Current branch name (git 2.22+)
  name = branch --show-current
  current-branch = branch --show-current
  # Default branch ref on origin (e.g. origin/main). If this fails, run: git remote set-head origin --auto
  default-ref = rev-parse --abbrev-ref origin/HEAD
  # Merge base with an origin branch (defaults to origin/HEAD)
  mbase = "!f(){ git merge-base HEAD origin/${1:-HEAD}; }; f"
  # Squash current branch relative to default branch
  squash = "!f(){ git reset --soft $(git merge-base $(git default-ref) HEAD) && git commit -am \"${1}\"; }; f"
  # Safer force push: --force-if-includes (git 2.30+) refuses to clobber remote commits not in your reflog
  pushf = push --force-with-lease --force-if-includes
  # subtree add/update (branch defaults to main; override via 3rd arg)
  sba = "!f(){ git subtree add --prefix $2 $1 ${3:-main} --squash; }; f"
  sbu = "!f(){ git subtree pull --prefix $2 $1 ${3:-main} --squash; }; f"
  ls-subtrees = !git log | grep git-subtree-dir | awk '{ print $2 }' | sort -u
  # Switch to branch, creating if it doesn't exist (git 2.23+)
  cob = "!f(){ git switch \"$1\" 2>/dev/null || git switch -c \"$1\"; }; f"
  upstream = !git config --get branch.$(git branch --show-current).remote || echo origin
  hard-reset = !git reset --hard $(git upstream)/$(git branch --show-current)
  pprune = fetch --prune
  # Log/diff commits on current branch since diverging from default
  branchlog = !git log $(git default-ref)..HEAD
  branchdiff = !git diff $(git default-ref)...HEAD
  root = rev-parse --show-toplevel
  st = status --ignored
  fcommit = commit --no-verify
  default-branch = !gh repo view --json defaultBranchRef --jq '.defaultBranchRef.name'
  branches = for-each-ref --sort='-authordate:iso8601' --format='%(color:red)%(authordate:short)%(color:default) %(color:blue)%(authorname)%(color:default) %(color:green)%(refname:short)%(color:default)' refs/heads
  branchesr = for-each-ref --sort='-authordate:iso8601' --format='%(color:red)%(authordate:short)%(color:default) %(color:blue)%(authorname)%(color:default) %(color:green)%(refname:short)%(color:default)' refs/remotes
  prettylog = log --pretty=format:'%C(yellow)%h %Cred%ad %Cblue%an%Cgreen%d %Creset%s' --date=short
  whoami = "!\
    url=$(git ls-remote --get-url origin 2>/dev/null); \
    host=github.com; \
    case \"$url\" in \
      git@*:*) h=${url#git@}; host=${h%%:*} ;; \
      https://*) h=${url#https://}; host=${h%%/*} ;; \
    esac; \
    printf 'name:       %s\\nemail:      %s\\nsigningkey: %s\\nssh:        ' \
      \"$(git config user.name)\" \
      \"$(git config user.email)\" \
      \"$(git config user.signingkey)\"; \
    ssh -T git@$host 2>&1 | head -1 \
  "

{{- if eq .chezmoi.os "windows" }}
[safe]
  directory = %(prefix)///wsl.localhost/Ubuntu/home/localuser/.local/share/chezmoi
{{- end -}}

{{/* Last values win -- keep identity related includes last so they override defaults set earlier */}}

; Match on the remote URL — works immediately after `git clone` regardless of
; local path, and survives moving the worktree. Requires git 2.36+.
; `hasconfig` matches the URL stored in .git/config (the form the user typed
; at clone time), not the insteadOf-rewritten form — so we list every variant.

[includeIf "hasconfig:remote.*.url:git@github.com:DataDog/**"]
  path = config_nlopez
[includeIf "hasconfig:remote.*.url:https://github.com/DataDog/**"]
  path = config_nlopez
[includeIf "hasconfig:remote.*.url:git@github.com-nlopez:DataDog/**"]
  path = config_nlopez
[includeIf "hasconfig:remote.*.url:git@github.com:nlopez/**"]
  path = config_nlopez
[includeIf "hasconfig:remote.*.url:https://github.com/nlopez/**"]
  path = config_nlopez
[includeIf "hasconfig:remote.*.url:git@github.com-nlopez:nlopez/**"]
  path = config_nlopez

[includeIf "hasconfig:remote.*.url:git@github.com:ddoghq/**"]
  path = config_datadog
[includeIf "hasconfig:remote.*.url:https://github.com/ddoghq/**"]
  path = config_datadog
[includeIf "hasconfig:remote.*.url:git@github.com-ddog:ddoghq/**"]
  path = config_datadog

[includeIf "hasconfig:remote.*.url:git@github.com:ddoghq-sandbox/**"]
  path = config_datadog
[includeIf "hasconfig:remote.*.url:https://github.com/ddoghq-sandbox/**"]
  path = config_datadog
[includeIf "hasconfig:remote.*.url:git@github.com-ddog:ddoghq-sandbox/**"]
  path = config_datadog

{{- if .personal }}
[includeIf "hasconfig:remote.*.url:git@github.com:silentshout42/**"]
  path = config_hobby
[includeIf "hasconfig:remote.*.url:https://github.com/silentshout42/**"]
  path = config_hobby
[includeIf "hasconfig:remote.*.url:git@github.com-hobby:silentshout42/**"]
  path = config_hobby

[includeIf "hasconfig:remote.*.url:git@github.com:kamotimestamps/**"]
  path = config_hobby
[includeIf "hasconfig:remote.*.url:https://github.com/kamotimestamps/**"]
  path = config_hobby
[includeIf "hasconfig:remote.*.url:git@github.com-hobby:kamotimestamps/**"]
  path = config_hobby
{{- end }}

; chezmoi repo has no remote-URL signal usable for matching, so keep a gitdir rule.
[includeIf "gitdir:~/.local/share/chezmoi/.git"]
  path = config_nlopez

[includeIf "gitdir:~/.local/share/chezmoi/.git/worktrees/**"]
  path = config_nlopez
