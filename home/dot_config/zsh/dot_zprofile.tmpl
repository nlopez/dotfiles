{{- /* ~/.config/zsh/zprofile — runs once per login shell, before zshrc.
   PATH and env exports live here. Interactive-only setup (aliases, plugins,
   prompts, zle bindings) stays in zshrc.
*/ -}}

typeset -U path

# XDG Base Directory Specification — set early; everything below depends on them.
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_STATE_HOME="$HOME/.local/state"
export XDG_CACHE_HOME="$HOME/.cache"

export COLORTERM=truecolor

{{- if not .headless }}
export OP_ACCOUNT=my.1password.com
export SSH_AUTH_SOCK="{{ .platform.ssh_auth_sock | replace "~" .chezmoi.homeDir }}"
{{- end }}

{{- if eq .chezmoi.os "darwin" }}
{{- $brewPrefixes := list "/opt/homebrew" "/usr/local" -}}
{{- $foundBrewPrefix := "" -}}
{{- range $brewPrefix := $brewPrefixes -}}
  {{- if and (not $foundBrewPrefix) (stat (printf "%s/bin/brew" $brewPrefix)) -}}
    {{- $foundBrewPrefix = $brewPrefix -}}
  {{- end -}}
{{- end }}
{{- if $foundBrewPrefix }}

fpath+=("{{ $foundBrewPrefix }}/share/zsh/site-functions")
eval "$({{ $foundBrewPrefix }}/bin/brew shellenv)"
export HOMEBREW_REQUIRE_TAP_TRUST=1
{{ end }}
{{- end }}

# Re-prepend GNU gnubin paths after brew shellenv — path_helper -s rebuilds
# PATH from /etc/paths + /etc/paths.d and appends the old PATH (containing
# the gnubin dirs from ~/.zshenv) at the end, so we must re-prepend here.
{{- if eq .chezmoi.os "darwin" }}
{{- $darwinBrewPrefix := "" -}}
{{- range (list "/opt/homebrew" "/usr/local") -}}
  {{- if and (not $darwinBrewPrefix) (stat (printf "%s/bin/brew" .)) -}}
    {{- $darwinBrewPrefix = . -}}
  {{- end -}}
{{- end }}
{{- if $darwinBrewPrefix }}
for _gnubin in \
{{- range .packages.darwin.gnu_tools }}
  "{{ $darwinBrewPrefix }}/opt/{{ . }}/libexec/gnubin" \
{{- end }}
; do
  [ -d "$_gnubin" ] && PATH="$_gnubin:$PATH"
done
unset _gnubin

# keg-only brew formulae that need to shadow system versions. Also applied
# in .zshenv (all zsh shells) since .zprofile only runs for login shells;
# re-applying here re-prepends after path_helper -s rebuilds PATH below.
{{ template "keg-only-brew-formulae.tmpl" (dict "prefix" $darwinBrewPrefix) }}
{{- end }}
{{- end }}
{{- $homeDir := .chezmoi.homeDir }}

# Dynamic PATH additions — checked at every login/reload, so new tool
# installations (cargo, go, etc.) show up without needing chezmoi apply.
for _d in \
  "$HOME/go/bin" \
  "$HOME/.cargo/bin" \
; do
  [[ -d "$_d" ]] && PATH="$_d:$PATH"
done
unset _d

export PNPM_HOME="${XDG_DATA_HOME}/pnpm"
PATH="$PNPM_HOME/bin:$PATH"

# Prepend ~/.local/bin last so shims here take priority over everything else.
PATH="{{ joinPath $homeDir ".local/bin" }}:$PATH"
typeset -U path
export TENV_AUTO_INSTALL=true
export TFENV_AUTO_INSTALL=true
export GOPATH="${XDG_DATA_HOME}/go"
export VISUAL="zed"
export EDITOR="vim"

{{- if .work }}
# Source work-specific env vars (age-encrypted in source tree, decrypted on apply).
[[ -r "${XDG_CONFIG_HOME}/work-secrets/env" ]] && source "${XDG_CONFIG_HOME}/work-secrets/env"
{{- end }}

{{- if not .headless }}
# Set on all machines — Automation vault (Kagi API)
export KAGI_API_KEY={{ onepasswordRead "op://Automation/Kagi API/credential" "my.1password.com" }}

{{- if .personal }}
# Automation vault — personal machine secrets
export HF_TOKEN={{ onepasswordRead "op://Automation/HF_TOKEN/credential" "my.1password.com" }}
{{- end }}
{{- end }}
