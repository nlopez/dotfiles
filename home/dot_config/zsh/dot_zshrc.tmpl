# Load shared POSIX env (gnubin PATH, etc.) for all shell types.
. "${XDG_CONFIG_HOME:-$HOME/.config}/shell/env"

# Skip interactive-only config when running under Pi.
[[ -n "${PI_CODING_AGENT:-}" ]] && return

###############################################################################
# Oh My Zsh — variables must be set before sourcing
###############################################################################
export ZSH="${XDG_DATA_HOME:-$HOME/.local/share}/oh-my-zsh"
ZSH_THEME="powerlevel10k/powerlevel10k"
DISABLE_AUTO_TITLE="true"
zstyle ':omz:update' mode disabled

plugins=(
{{- range .zshPlugins }}
  {{ . }}
{{- end }}
)

# Load completions before OMZ:
# https://github.com/zsh-users/zsh-completions/tree/0.36.0?tab=readme-ov-file#using-zsh-frameworks
fpath+=${ZSH_CUSTOM:-${ZSH:-~/.oh-my-zsh}/custom}/plugins/zsh-completions/src
source $ZSH/oh-my-zsh.sh
setopt completealiases

###############################################################################
# Interactive config
###############################################################################

# Terminal title management (p10k handles its own prompt styling).

function _source() {
  [[ -f $1 ]] && source "$@"
}

# Reload: replace the current shell process with a fresh login shell so
# .zprofile and .zshrc are re-read with no stale state.
function reload {  exec env -i PATH=$PATH TERMINFO=$TERMINFO TERM=$TERM USER=$USER HOME=$HOME SHELL=$SHELL TMUX=$TMUX TMUX_PANE=$TMUX_PANE zsh --login }

function _command() {
  command -v $1 >/dev/null 2>&1
}

# shellcheck source=~/.zshrc_local
_source ~/.zshrc_local

{{- if lookPath "zabrze" }}
eval "$(zabrze init --bind-keys)"
# zsh-autosuggestions skips every widget whose name starts with '_', which
# includes all __zabrze::* widgets — so ZSH_AUTOSUGGEST_CLEAR_WIDGETS can
# never wrap them directly. Create a non-underscore shim for Space that
# zsh-autosuggestions CAN see, add it to CLEAR_WIDGETS so the stale
# pre-expansion suggestion is dropped instead of bleeding into the new buffer.
zabrze-expand-and-self-insert() { zle __zabrze::expand-and-self-insert }
zle -N zabrze-expand-and-self-insert
bindkey " " zabrze-expand-and-self-insert
ZSH_AUTOSUGGEST_CLEAR_WIDGETS+=(zabrze-expand-and-self-insert)
# groot: after zabrze expands 'groot' → '"$(git rev-parse --show-toplevel)"',
# this hook immediately evaluates it and replaces it with the actual path so
# the buffer shows the resolved path, not the shell-expansion expression.
function _groot_inline_expand() {
  local pattern='"$(git rev-parse --show-toplevel)"'
  [[ "$BUFFER" == *"$pattern"* ]] || return
  local root
  root=$(git rev-parse --show-toplevel 2>/dev/null) || return
  local quoted=${(q)root}
  local before="${BUFFER%%"$pattern"*}"
  BUFFER="${BUFFER//"$pattern"/$quoted}"
  CURSOR=$(( ${#before} + ${#quoted} ))
  # zsh-syntax-highlighting registers its zle-line-pre-redraw hook before ours
  # (OMZ loads at line 22, our hook at line ~62), so its highlights are already
  # stale by the time we swap the buffer. Re-run it now with the new buffer.
  (( ${+functions[_zsh_highlight]} )) && _zsh_highlight
}
add-zsh-hook precmd _groot_inline_expand
{{- end }}
eval "$(atuin init zsh)"

# Prevent pasted newlines from ever executing a command.
# bracketed-paste-magic intercepts terminal paste events, converts embedded
# newlines to spaces, and strips any trailing newline so the Enter key must
# be pressed deliberately to run a command.
autoload -Uz bracketed-paste-magic
zle -N bracketed-paste bracketed-paste-magic

autoload -U edit-command-line
zle -N edit-command-line
function _edit_command_line() { VISUAL="code --wait" zle edit-command-line }
zle -N _edit_command_line
bindkey '^xe' _edit_command_line
bindkey '^x^e' _edit_command_line

export MANPAGER="sh -c 'col -bx | bat -l man -p'"

alias e="code --add"

###############################################################################
# AWS profile in preprompt when typing aws/terraform commands
###############################################################################
# Smart path abbreviation (p10k-compatible).
# Replaces %~ in p10k's dir segment with a smart abbreviated path.
typeset -g _p10k_path=""

function _smart_path_precmd() {
  local git_prefix git_rel repo_root p i au s d r
  local -a parts

  p="${PWD/#$HOME/~}"

  _abbrev_parts() {
    local -a pp=("$@")
    local res="~" i au s d r
    au=$(( ${#pp} - 3 ))
    for (( i = 1; i <= ${#pp}; i++ )); do
      s="${pp[$i]}"
      if (( i <= au )); then
        d="" r="$s"
        while [[ "$r" == .* ]]; do d="${d}."; r="${r:1}"; done
        res="${res}/${d}${r:0:1}"
      else
        res="${res}/${s}"
      fi
    done
    _abbrev_result="$res"
  }

  if git_prefix=$(git rev-parse --show-prefix 2>/dev/null); then
    if [[ -n "$git_prefix" ]]; then
      git_rel="${git_prefix%/}"
      repo_root="${p%/$git_rel}"
    else
      git_rel=""
      repo_root="$p"
    fi
    if [[ "$repo_root" == "~/"* ]]; then
      parts=("${(@s:/:)${repo_root#\~/}}")
      if (( ${#parts} >= 4 )); then
        _abbrev_parts "${parts[@]}"
        repo_root="$_abbrev_result"
      fi
    fi
    _p10k_path="${repo_root}${git_rel:+/$git_rel}"
  else
    if [[ "$p" == "~/"* ]]; then
      parts=("${(@s:/:)${p#\~/}}")
      if (( ${#parts} >= 4 )); then
        _abbrev_parts "${parts[@]}"
        _p10k_path="$_abbrev_result"
      else
        _p10k_path="$p"
      fi
    else
      _p10k_path="$p"
    fi
  fi
}
add-zsh-hook precmd _smart_path_precmd
_smart_path_precmd

###############################################################################
# ── Tmux pane border: push current command via @current_cmd ──────────────────
# Sets the @current_cmd pane option on preexec (command running) and clears it
# on precmd (back at prompt), feeding the pane-border-format in tmux.conf.
# When cleared the border falls back to "---" via the format's else branch.
###############################################################################
if [[ -n "$TMUX" ]]; then
  function _tmux_cmd_preexec() {
    tmux set-option -p @current_cmd "$1" 2>/dev/null
  }
  function _tmux_cmd_precmd() {
    tmux set-option -pu @current_cmd 2>/dev/null
  }
  add-zsh-hook preexec _tmux_cmd_preexec
  add-zsh-hook precmd  _tmux_cmd_precmd
fi

{{- if eq .chezmoi.os "darwin" }}
###############################################################################
# ── Long-running command notifications (terminal-notifier) ────────────────────
# Fires a macOS notification whenever a tmux command runs for longer than 5 s.
# Skips the notification when the tmux window is currently active (the user is
# already looking at the output).
###############################################################################
if command -v terminal-notifier &>/dev/null; then
  _notif_cmd_start=0
  _notif_cmd_name=""

  function _notif_preexec() {
    _notif_cmd_start=$EPOCHSECONDS
    _notif_cmd_name="${${1## }%% *}"   # first word of command, strip leading spaces
  }

  function _notif_precmd() {
    local _exit=$?
    [[ $_notif_cmd_start -eq 0 ]] && return
    local _elapsed=$(( EPOCHSECONDS - _notif_cmd_start ))
    _notif_cmd_start=0
    # Only care about tmux windows and commands that actually took a while.
    [[ -z "$TMUX" || $_elapsed -lt 5 ]] && return
    # Skip when the user is still looking at this window.
    local _active
    _active=$(tmux display-message -p '#{window_active}' 2>/dev/null) || return
    [[ "$_active" == "1" ]] && return

    local _win
    _win=$(tmux display-message -p '#W' 2>/dev/null) || _win="tmux"

    if [[ $_exit -eq 0 ]]; then
      terminal-notifier \
        -title "✅ ${_notif_cmd_name} (${_elapsed}s)" \
        -subtitle "$_win" \
        -message "Finished successfully" \
        -sound "default" \
        &>/dev/null &!
    else
      terminal-notifier \
        -title "❌ ${_notif_cmd_name} (${_elapsed}s)" \
        -subtitle "$_win" \
        -message "Exited ${_exit}" \
        -sound "Basso" \
        &>/dev/null &!
    fi
  }

  add-zsh-hook preexec _notif_preexec
  add-zsh-hook precmd _notif_precmd
fi
{{- end }}

# Inject psvar[24] into p10k prompt.
# psvar[24] = AWS profile (shown when typing aws/terraform/tf commands).
# Replaces %~ in p10k's dir segment with smart abbreviated path.
function _aws_prompt_setup() {
  local _path_var='${_p10k_path}'
  PROMPT="${PROMPT//\%\~/$_path_var}"
}
_aws_prompt_setup
unfunction _aws_prompt_setup

function _aws_profile_prompt() {
  local first_word="${${BUFFER##[[:space:]]#}%% *}"
  if [[ -n "$AWS_PROFILE" && "$first_word" == (aws|terraform|tfplan|tf) ]]; then
    psvar[24]="$AWS_PROFILE"
  else
    psvar[24]=""
  fi
}
add-zsh-hook precmd _aws_profile_prompt

###############################################################################
# Restic profile shortcuts — reads ~/.config/resticprofile/profiles.toml
# https://creativeprojects.github.io/resticprofile/
alias resticprofile='resticprofile -n default -c ${XDG_CONFIG_HOME:-$HOME/.config}/resticprofile/profiles.toml'
alias restic-snapshots='resticprofile snapshots'
alias restic-ls='resticprofile ls --snapshot latest'
alias restic-restore='resticprofile restore --target ~/restic-restore/'
###############################################################################
eval "$(direnv hook zsh)"
eval "$(zoxide init zsh)"
eval "$(mise activate zsh)"
{{- if lookPath "wt" }}
eval "$(wt config shell init zsh)"
{{- end }}
