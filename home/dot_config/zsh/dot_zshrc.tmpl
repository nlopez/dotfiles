# Skip interactive-only config when running under Pi.
[[ -n "${PI_CODING_AGENT:-}" ]] && return

###############################################################################
# Completion + plugins (all from the Nix profile — no framework)
###############################################################################
_zdir="${ZDOTDIR:-${XDG_CONFIG_HOME:-$HOME/.config}/zsh}"
_nix_profile="{{ includeTemplate "nix-profile" . }}"

# fpath: our completions, then the profile's (zsh-completions, tool-provided
# completions, and pure's prompt_pure_setup/async). Must precede compinit.
typeset -U fpath
fpath=("${XDG_DATA_HOME:-$HOME/.local/share}/zsh/completions" "$_nix_profile/share/zsh/site-functions" $fpath)
{{- if .workspace }}
# Workspaces: the host package manager's zsh completions (its init.zsh also
# re-prepends PATH, which shell/env already covers).
for _f in /opt/*/share/etc/*/init.zsh(N); do source "$_f"; done; unset _f
{{- end }}

source "$_zdir/defaults.zsh"   # options, completion styles, key bindings, aliases

autoload -Uz compinit
[[ -d "${XDG_CACHE_HOME:-$HOME/.cache}/zsh" ]] || mkdir -p "${XDG_CACHE_HOME:-$HOME/.cache}/zsh"
compinit -d "${XDG_CACHE_HOME:-$HOME/.cache}/zsh/zcompdump-$ZSH_VERSION"
setopt completealiases

# Generic coverage, in layers (most specific wins):
#  1. Completions shipped by packages (fpath above).
#  2. carapace: ~1000 built-in completers; its bridges borrow zsh/fish/bash
#     completions for tools it lacks. Registers via compdef, so it follows compinit.
#  3. Fallback for anything left: parse `--help` (zsh's _gnu_generic). Skipped for
#     path-qualified commands (./script) so tab never executes arbitrary files.
if (( $+commands[carapace] )); then
  export CARAPACE_BRIDGES='zsh,fish,bash'
  source <(carapace _carapace zsh)
fi
# _gnu_generic hands whatever it scraped to _arguments, which errors on help text
# it can't escape (e.g. engram's trailing `\`); swallow that and fall back to files.
_help_fallback() {
  if [[ $words[1] == */* ]]; then _default; else _gnu_generic 2>/dev/null || _default; fi
}
compdef _help_fallback -default-

# Plugin order matters: fast-syntax-highlighting wraps widgets, so it loads last.
source "$_nix_profile/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh"
source <(fzf --zsh)
source "$_nix_profile/share/zsh/plugins/fast-syntax-highlighting/fast-syntax-highlighting.plugin.zsh"

# Personal widgets/overrides — after the plugins so they can rebind their keys.
source "$_zdir/custom.zsh"

# Prompt: pure. Prevent it from setting window/terminal titles.
zstyle ':prompt:pure:title' show no
autoload -U promptinit && promptinit
prompt pure
# Draw time on the right, so terminal output read by an agent shows when each command ran.
RPROMPT='%D{%H:%M:%S}'

unset _zdir _nix_profile

###############################################################################
# Interactive config
###############################################################################

function _source() {
  [[ -f $1 ]] && source "$@"
}

# Reload: replace the current shell process with a fresh login shell so
# .zprofile and .zshrc are re-read with no stale state.
# The environment is cleared on purpose, so only these variables survive. The
# REX_* IDs are passed through when set: dropping them breaks every Rex-aware
# tool (agent hooks, the PR box) in the new shell and in anything launched from it.
function reload {
  exec env -i PATH=$PATH TERMINFO=$TERMINFO TERM=$TERM USER=$USER HOME=$HOME SHELL=$SHELL \
    TMUX=$TMUX TMUX_PANE=$TMUX_PANE \
    ${REX_SERVER:+REX_SERVER=$REX_SERVER} ${REX_SESSION:+REX_SESSION=$REX_SESSION} ${REX_BLOCK:+REX_BLOCK=$REX_BLOCK} \
    zsh --login
}

function _command() {
  command -v $1 >/dev/null 2>&1
}

# shellcheck source=~/.zshrc_local
_source ~/.zshrc_local

{{- if lookPath "zabrze" }}
eval "$(zabrze init --bind-keys)"
# zsh-autosuggestions skips every widget whose name starts with '_', which
# includes all __zabrze::* widgets — so ZSH_AUTOSUGGEST_CLEAR_WIDGETS can
# never wrap them directly. Create a non-underscore shim for Space that
# zsh-autosuggestions CAN see, add it to CLEAR_WIDGETS so the stale
# pre-expansion suggestion is dropped instead of bleeding into the new buffer.
zabrze-expand-and-self-insert() { zle __zabrze::expand-and-self-insert }
zle -N zabrze-expand-and-self-insert
bindkey " " zabrze-expand-and-self-insert
ZSH_AUTOSUGGEST_CLEAR_WIDGETS+=(zabrze-expand-and-self-insert)
# groot: after zabrze expands 'groot' → '"$(git rev-parse --show-toplevel)"',
# this hook immediately evaluates it and replaces it with the actual path so
# the buffer shows the resolved path, not the shell-expansion expression.
function _groot_inline_expand() {
  local pattern='"$(git rev-parse --show-toplevel)"'
  [[ "$BUFFER" == *"$pattern"* ]] || return
  local root
  root=$(git rev-parse --show-toplevel 2>/dev/null) || return
  local quoted=${(q)root}
  local before="${BUFFER%%"$pattern"*}"
  BUFFER="${BUFFER//"$pattern"/$quoted}"
  CURSOR=$(( ${#before} + ${#quoted} ))
  # zsh-syntax-highlighting registers its zle-line-pre-redraw hook before ours
  # (plugins load near the top of this file, our hook below), so its highlights are already
  # stale by the time we swap the buffer. Re-run it now with the new buffer.
  (( ${+functions[_zsh_highlight]} )) && _zsh_highlight
}
add-zle-hook-widget zle-line-pre-redraw _groot_inline_expand
{{- end }}
# mise: the few tools nixpkgs lacks (engram, unique-namer, ...).
(( $+commands[mise] )) && eval "$(mise activate zsh)"

# Keep our shims first on every prompt and directory change: `mise activate`
# and the work package manager's init re-prepend their own dirs, which would put
# real binaries (e.g. gh) ahead of our shims. Hooks registered after theirs
# run after them, so shims always win.
# ~/.local/bin/shims goes first (each shim strips its own dir from PATH to find
# the real binary), then ~/.local/bin, then /opt/*/shims/bin (work shims).
_local_bin_first() {
{{- if .work }}
  local _d
  for _d in /opt/*/shims/bin(N); do path=($_d ${path:#$_d}); done
{{- end }}
  path=("$HOME/.local/bin" ${path:#"$HOME/.local/bin"})
  # Inside a nix dev shell, its pinned tools (e.g. aws-vault) beat the
  # wrappers in ~/.local/bin and the work shims.
  if [[ -n $IN_NIX_SHELL ]]; then
    path=(${(M)path:#/nix/store/*} ${path:#/nix/store/*})
  fi
  path=("$HOME/.local/bin/shims" ${path:#"$HOME/.local/bin/shims"})
}
precmd_functions+=(_local_bin_first)
chpwd_functions+=(_local_bin_first)
_local_bin_first
eval "$(atuin init zsh)"

# Prevent pasted newlines from ever executing a command.
# bracketed-paste-magic intercepts terminal paste events, converts embedded
# newlines to spaces, and strips any trailing newline so the Enter key must
# be pressed deliberately to run a command.
autoload -Uz bracketed-paste-magic
# '.self-*' forces the builtin self-insert widgets during a paste, bypassing
# url-quote-magic so pasted URLs / special chars ($ ? & = space) are inserted
# literally instead of being backslash-escaped. Newline handling above is
# unaffected.
zstyle ':bracketed-paste-magic' active-widgets '.self-*'
zle -N bracketed-paste bracketed-paste-magic

autoload -U edit-command-line
zle -N edit-command-line
bindkey '^xe' edit-command-line
bindkey '^x^e' edit-command-line

# Home/End: some terminals don't have these bound by default, leaving Home a
# no-op and End inserting a literal '~'. Bind via terminfo so the actual
# sequence for $TERM is used rather than hardcoding one terminal's codes.
[[ -n "${terminfo[khome]}" ]] && bindkey "${terminfo[khome]}" beginning-of-line
[[ -n "${terminfo[kend]}" ]] && bindkey "${terminfo[kend]}" end-of-line

export MANPAGER="sh -c 'col -bx | bat -l man -p'"

###############################################################################
# Smart path in the pure prompt
###############################################################################
# _pure_path: smart path string, updated each precmd. In git repos keeps
# everything from the repo root downward unabbreviated and abbreviates above it
# (last 3 components shown). Outside git repos abbreviates at ≥4 dirs after ~.
typeset -g _pure_path=""

function _smart_path_precmd() {
  local git_prefix git_rel repo_root p i au s d r
  local -a parts

  p="${PWD/#$HOME/~}"

  # Abbreviate path parts: keep last 3 full, shorten earlier ones to
  # leading-dots + first-non-dot char. Result in global _abbrev_result.
  _abbrev_parts() {
    local -a pp=("$@")
    local res="~" i au s d r
    au=$(( ${#pp} - 3 ))
    for (( i = 1; i <= ${#pp}; i++ )); do
      s="${pp[$i]}"
      if (( i <= au )); then
        d="" r="$s"
        while [[ "$r" == .* ]]; do d="${d}."; r="${r:1}"; done
        res="${res}/${d}${r:0:1}"
      else
        res="${res}/${s}"
      fi
    done
    _abbrev_result="$res"
  }

  if git_prefix=$(git rev-parse --show-prefix 2>/dev/null); then
    # --show-prefix: path from repo root to CWD with trailing slash, empty at root
    if [[ -n "$git_prefix" ]]; then
      git_rel="${git_prefix%/}"
      repo_root="${p%/$git_rel}"
    else
      git_rel=""
      repo_root="$p"
    fi
    # Abbreviate the pre-root portion; \~/ escapes ~ for EXTENDED_GLOB safety
    if [[ "$repo_root" == "~/"* ]]; then
      parts=("${(@s:/:)${repo_root#\~/}}")
      if (( ${#parts} >= 4 )); then
        _abbrev_parts "${parts[@]}"
        repo_root="$_abbrev_result"
      fi
    fi
    _pure_path="${repo_root}${git_rel:+/$git_rel}"
  else
    if [[ "$p" == "~/"* ]]; then
      parts=("${(@s:/:)${p#\~/}}")
      if (( ${#parts} >= 4 )); then
        _abbrev_parts "${parts[@]}"
        _pure_path="$_abbrev_result"
      else
        _pure_path="$p"
      fi
    else
      _pure_path="$p"
    fi
  fi
}
add-zsh-hook precmd _smart_path_precmd
_smart_path_precmd  # prime before first prompt

# Swap pure's %~ for ${_pure_path} (expanded by PROMPT_SUBST at render time).
_path_var='${_pure_path}'
PROMPT="${PROMPT//\%\~/$_path_var}"
unset _path_var

# resticprofile: https://creativeprojects.github.io/resticprofile/
alias resticprofile='resticprofile -n default -c ${XDG_CONFIG_HOME:-$HOME/.config}/resticprofile/profiles.toml'
eval "$(direnv hook zsh)"
eval "$(zoxide init zsh)"
command -v wt >/dev/null && eval "$(wt config shell init zsh)"
{{- if and .workspace .work (not (index . "encryption")) }}

# Workspaces: dotfiles install before the CLI uploads workspace secrets, so the
# first apply ran without the age identity (or before Nix installed age) and
# skipped the private data. Once both are here, re-run init (which turns on
# encryption) and apply, once, in the background. The re-rendered .zshrc
# drops this block.
if [[ -s /run/user/$UID/secrets/CHEZMOI_AGE_IDENTITY ]] && (( $+commands[age] )) && mkdir "${XDG_CACHE_HOME:-$HOME/.cache}/chezmoi-first-login.lock" 2>/dev/null; then
  print -P "%F{blue}chezmoi:%f age identity found; applying private dotfiles in the background"
  (
    _log="${XDG_STATE_HOME:-$HOME/.local/state}/chezmoi-first-login.log"
    mkdir -p "${_log:h}"
    chezmoi init --apply --no-tty </dev/null >"$_log" 2>&1
    rmdir "${XDG_CACHE_HOME:-$HOME/.cache}/chezmoi-first-login.lock"
  ) &!
fi
{{- end }}
{{ includeTemplate "private-snippet" (dict "ctx" . "class" "work" "name" "pkg-hook-zsh") -}}
