{{- if lookPath "atuin" }}
# Disable zsh's history file in favor of atuin (atuin handles persistence).
# Do NOT define a plain zshaddhistory() function here — atuin registers its
# own _atuin_zshaddhistory via add-zsh-hook, and a pre-existing plain function
# blocks that hook from ever being called (add-zsh-hook only installs its
# wrapper when the function is undefined). Leaving it undefined means atuin
# correctly captures comment lines and other commands that skip preexec.
unset HISTFILE
alias history="atuin history list"
{{- end }}

ZSH_AUTOSUGGEST_BUFFER_MAX_SIZE=20

cd() {
  # If given a file path, cd to its parent directory. ${1:h} is zsh's :h modifier
  # (borrowed from vi), which strips the trailing filename component — like dirname.
  if [[ $# -eq 1 && -f "$1" ]]; then
    set -- "${1:h}"
  fi
  if (( $+functions[z] )); then
    z "$@"
  else
    builtin cd "$@"
  fi
}

clear() { stty sane; command clear }

# `chezmoi cd` opens a subshell that loses this shell's directory; cd in this shell instead.
chezmoi() {
  if [[ $1 == cd && $# -le 2 && $2 != -* ]]; then
    local dir
    if (( $# == 1 )); then
      dir=$(command chezmoi data --format json | jq -er .chezmoi.workingTree) || return
    else
      dir=$(command chezmoi source-path "$2") || return
      [[ -d $dir ]] || dir=${dir:h}
    fi
    builtin cd "$dir"
  else
    command chezmoi "$@"
  fi
}

# `pi -w <name>`: open a pi-worktree-extension worktree. pi picks its cwd before
# extensions load, so the extension needs this shell-side dispatcher.
pi() {
  if [[ $1 == (-w|--worktree) ]]; then
    (( $# >= 2 )) || { echo "usage: pi -w <name> [Pi args...]" >&2; return 2; }
    shift
    PI_WORKTREE_REAL_PI=${commands[pi]} \
      command ~/.pi/agent/npm/node_modules/.bin/pi-worktree "$@"
  else
    command pi "$@"
  fi
}

# Make Ctrl+L also run stty sane (clear-screen widget bypasses the function above)
_clear_screen_sane() { stty sane; zle clear-screen }
zle -N _clear_screen_sane
bindkey '^L' _clear_screen_sane

{{- if and .work (eq .chezmoi.os "darwin") }}
alias sudo="/Applications/Privileges.app/Contents/MacOS/PrivilegesCLI -a && /usr/bin/sudo"
{{- end }}
