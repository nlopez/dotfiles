# chezmoi:template:left-delimiter="[[" right-delimiter="]]"
skip-commit-generation-prompt = true
# Worktrees sit beside the clone: <owner>/<repo>.<branch>
worktree-path = "{{ repo_path }}/../{{ repo }}.{{ branch | sanitize }}"

[post-start]
copy-ignored = "wt step copy-ignored"
[[- /* Work repos ship their own worktree-path; keep the bare-repo layout for
       them too. The list comes from the private data (docs/private-data.md). */]]
[[- range (includeTemplate "private-data" . | fromYaml).worktrunk_projects ]]
[projects."[[ . ]]"]
worktree-path = "{{ repo_path }}/../{{ branch | sanitize }}"
[[ end ]]
[list]
json-schema = 2
