#!/usr/bin/env python3
# Managed by chezmoi.
# Preserves favorite_config_option_values, which Zed writes at runtime
# (e.g. agent mode toggles like bypassPermissions).
import json
import re
import sys


def strip_jsonc(text):
    return re.sub(r'(?m)^\s*//[^\n]*$', '', text)


current_raw = sys.stdin.read()
preserved = None
try:
    current = json.loads(strip_jsonc(current_raw))
    fav = current.get('agent_servers', {}).get('claude-acp', {}).get('favorite_config_option_values')
    if fav is not None:
        preserved = fav
except Exception:
    pass

desired_raw = '''{{ includeTemplate "zed_settings.json.tmpl" . }}'''
desired = json.loads(strip_jsonc(desired_raw))

if preserved is not None:
    desired.setdefault('agent_servers', {}).setdefault('claude-acp', {})['favorite_config_option_values'] = preserved

print(json.dumps(desired, indent=2))
