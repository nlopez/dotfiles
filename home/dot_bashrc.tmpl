{{- /* ~/.bashrc — interactive bash config.
   Sources the shared env for XDG vars and sets up gnubin PATH.
*/ -}}
# Guard: skip if already loaded in this shell session.
[ -n "$_BASHRC_LOADED" ] && return
_BASHRC_LOADED=1

# Load shared POSIX env (XDG vars) for all shell types.
. "${XDG_CONFIG_HOME:-$HOME/.config}/shell/env"

# GNU tool gnubin paths — prepend so GNU utils win over BSD/macOS system tools.
{{- if eq .chezmoi.os "darwin" }}
{{- $brewPrefixes := list "/opt/homebrew" "/home/linuxbrew/.linuxbrew" "/usr/local" -}}
{{- $brewPrefix := "" -}}
{{- range $brewPrefixes -}}
  {{- if and (not $brewPrefix) (stat (printf "%s/bin/brew" .)) -}}
    {{- $brewPrefix = . -}}
  {{- end -}}
{{- end }}
{{- if $brewPrefix }}
for _gnubin in \
{{- range .packages.darwin.gnu_tools }}
  "{{ $brewPrefix }}/opt/{{ . }}/libexec/gnubin" \
{{- end }}
; do
  [ -d "$_gnubin" ] && PATH="$_gnubin:$PATH"
done
unset _gnubin
{{- end }}
{{- end }}

# Prompt should show exit status of last command.
PROMPT_COMMAND='if [ "$?" -ne 0 ]; then echo "Exit status: $? >&1"; fi'

# History: append mode, larger history, ignore duplicates and commands
# starting with space.
export HISTFILE="${XDG_STATE_HOME:-$HOME/.local/state}/bash/history"
export HISTSIZE=10000
export HISTFILESIZE=20000
export HISTCONTROL=ignoredups:ignorespace
shopt -s histappend
shopt -s checkhash
shopt -s promptvars

# Interactive-only aliases.
alias cp='cp -i'
alias mv='mv -i'
alias rm='rm -i'
alias diff='diff --color=auto'
alias grep='grep --color=auto'
alias ls='ls --color=auto'

# Default editor.
export VISUAL="vim"
export EDITOR="vim"
