#!/usr/bin/env python3
# Managed by chezmoi.
# Sets pi theme to atom-one-dark while preserving runtime-written keys
# such as lastChangelogVersion, defaultProvider, and defaultModel.
import json
import sys

current_raw = sys.stdin.read()
current = {}
try:
    if current_raw.strip():
        current = json.loads(current_raw)
except Exception:
    pass

current["theme"] = "atom-one-dark"

print(json.dumps(current, indent=2))
