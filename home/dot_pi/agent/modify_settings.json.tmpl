#!/usr/bin/env python3
{{/* chezmoi:modify-template */}}
# Managed by chezmoi.
# Sets pi theme to atom-one-dark, defaults provider to omlx,
# ensures required packages are present, and configures pnpm
# for package installs/updates, while preserving
# runtime-written keys such as lastChangelogVersion.
import json
import sys

current_raw = sys.stdin.read()
current = {}
try:
    if current_raw.strip():
        current = json.loads(current_raw)
except Exception:
    pass

current["theme"] = "atom-one-dark"

# Default omlx as the primary provider.
if "omlx" in str(current.get("defaultProvider", "")) or current.get("defaultProvider") is None:
    current["defaultProvider"] = "omlx"

# Use pnpm for all npm package-manager operations (installs, uninstalls,
# and dependency installs inside git packages).
current["npmCommand"] = ["pnpm"]

# Ensure required packages are present without removing runtime-added packages.
required_packages = ["npm:pi-web-access", "npm:pi-subagents", "npm:context-mode", "npm:pi-intercom", "npm:pi-powerline", "npm:@benvargas/pi-firecrawl"]
existing_packages = current.get("packages", [])

existing_sources = set()
for p in existing_packages:
    if isinstance(p, str):
        existing_sources.add(p)
    elif isinstance(p, dict):
        existing_sources.add(p.get("source", ""))

for pkg in required_packages:
    if pkg not in existing_sources:
        existing_packages.append(pkg)

current["packages"] = existing_packages

print(json.dumps(current, indent=2))
