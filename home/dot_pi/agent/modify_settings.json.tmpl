#!/usr/bin/env python3
# Managed by chezmoi — source: home/dot_pi/agent/modify_settings.json.tmpl
# ⚠️  DO NOT EDIT ~/.pi/agent/settings.json directly. It is overwritten
#     by chezmoi on every `chezmoi apply`. Always edit the source tree.
#
# This is a chezmoi templated modify_ script. Chezmoi first renders the Go
# template (injecting the package list from .chezmoidata/pi.yaml), then
# executes the resulting Python script. The script receives the current
# settings.json contents on stdin and writes the replacement JSON to stdout.
#
# Configures: theme, npmCommand, showHardwareCursor, compaction,
#             and the declarative package list.
# Default model: AI Gateway ai-gw-google / gemini-4-neon (work).
# Personal machines: anthropic / claude-sonnet-5-5 (medium thinking).
import json
import sys

current_raw = sys.stdin.read()
current = {}
try:
    if current_raw.strip():
        current = json.loads(current_raw)
except Exception:
    pass
{{- if .workspace }}

# Dogpark registers its own Pi package on workspaces; keep it in the list.
host_packages = [
    p for p in current.get("packages", [])
    if isinstance(p, str) and ".local/share/dogpark/" in p
]
{{- end }}


# Theme: sensible default; auto-theme extension syncs with macOS appearance.
current.setdefault("theme", "solarized-light")

# Default model — declared here so it is identical on every machine.
# Work machines use the work AI gateway; models.json is seeded by
# modify_models.json.tmpl and refreshed with /refresh-models.
levels = current.get("modelThinkingLevels", {})
{{- if .work }}
current["defaultProvider"] = "ai-gw-google"
current["defaultModel"] = "gemini-4-neon"
levels["ai-gw-google/gemini-4-neon"] = "medium"
{{- else }}
current["defaultProvider"] = "anthropic"
current["defaultModel"] = "claude-sonnet-5-5"
levels["anthropic/claude-sonnet-5-5"] = "medium"
{{- end }}
current["modelThinkingLevels"] = levels
current["defaultThinkingLevel"] = "medium"

# Skip the blocking 30s welcome countdown (pi-powerline-footer);
# quiet startup shows the non-blocking header instead.
current["quietStartup"] = True

# Use npm for package operations. pnpm's strict linking breaks Pi's
# extension loader which resolves modules from the literal symlink path,
# not the realpath inside .pnpm/. npm hoists by default.
current["npmCommand"] = ["npm"]

# Declarative package list — exactly and only these packages.
# Source of truth: home/.chezmoidata/pi.yaml
# personal_only_packages are excluded on work machines.
# Private work packages (npm and local; see docs/private-data.md) are appended below.
current["packages"] = [
{{- range .pi.packages }}
    "{{ . }}",
{{- end }}
{{- range .pi.git_packages }}
    "{{ . }}",
{{- end }}
{{- if not .work }}
{{- range .pi.personal_only_packages }}
    "{{ . }}",
{{- end }}
{{- end }}
{{- if .work }}
{{- $pi := (includeTemplate "private-data" . | fromYaml).pi | default dict }}
{{- range .pi.work_packages }}
    "{{ . }}",
{{- end }}
{{- range $pi.packages }}
    "{{ . }}",
{{- end }}
    # Local packages from the private work repo (cloned by
    # run_after_clone-work-pi-packages.sh).
{{- range $pi.local_packages }}
    "{{ joinPath $.chezmoi.homeDir $pi.local_repo.dir "packages" . }}",
{{- end }}
{{- end }}
]
{{- if .workspace }}
current["packages"] += [p for p in host_packages if p not in current["packages"]]
{{- end }}

# Skills: Pi discovers ~/.pi/agent/skills and ~/.agents/skills on its own.
# ~/.claude/skills is deliberately excluded: Claude Code refills its reserved
# synced/ subdirectory from claude.ai with connector skills Pi has no tools for.
stale = ["~/.config/pi/agent/skills", "~/.claude/skills", "-~/.claude/skills/rex"]
current["skills"] = [s for s in current.get("skills", []) if s not in stale]

# Enable /skill: slash commands in Pi sessions.
current["enableSkillCommands"] = True

# pi-powerline-footer layout: the default preset's left row with the
# pi-session-prs status (key "pr") placed right after the git branch.
powerline = current.get("powerline")
if not isinstance(powerline, dict):
    powerline = {}
powerline.setdefault("preset", "default")
powerline.setdefault("layout", {})["left"] = [
    "model", "thinking", "shell_mode", "path", "git",
    "custom:pr",
    "queue", "context_pct", "cache_read", "cost",
]
items = [i for i in powerline.get("customItems", []) if i.get("id") != "pr"]
items.append({"id": "pr", "statusKey": "pr", "position": "left", "selfColorize": True})
powerline["customItems"] = items
# Hide the i-have-adhd extension status from the footer.
hidden = powerline.get("hiddenExtensionStatusKeys", [])
if "i-have-adhd" not in hidden:
    hidden.append("i-have-adhd")
powerline["hiddenExtensionStatusKeys"] = hidden
current["powerline"] = powerline

current["defaultTools"] = ["+codemode"]

print(json.dumps(current, indent=2))
