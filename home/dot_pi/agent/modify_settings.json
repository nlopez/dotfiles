#!/usr/bin/env python3
# Managed by chezmoi — source: home/dot_pi/agent/modify_settings.json
# ⚠️  DO NOT EDIT ~/.pi/agent/settings.json directly. It is overwritten
#     by chezmoi on every `chezmoi apply`. Always edit the source tree.
#
# This is a chezmoi modify_ script, not a modify-template. Chezmoi passes the
# current settings.json contents on stdin, and this script must write the full
# replacement JSON to stdout.
#
# Configures: theme, defaultProvider, npmCommand, showHardwareCursor,
#             and required pnpm packages (managed via renovate).
import json
import sys

current_raw = sys.stdin.read()
current = {}
try:
    if current_raw.strip():
        current = json.loads(current_raw)
except Exception:
    pass

# Theme is managed at runtime by the auto-theme extension (extensions/auto-theme.ts)
# which syncs with macOS appearance. Don't override it here — just ensure a
# sensible default exists so a fresh install isn't theme-less.
current.setdefault("theme", "solarized-light")

# Default omlx as the primary provider.
if "omlx" in str(current.get("defaultProvider", "")) or current.get("defaultProvider") is None:
    current["defaultProvider"] = "omlx"

# Use pnpm for all npm package-manager operations (installs, uninstalls,
# and dependency installs inside git packages).
current["npmCommand"] = ["pnpm"]

# Cursor is managed entirely at runtime by the cursor-manager extension.
# It starts hidden and is revealed only when the terminal window gains focus.
# Setting this to True here enables a blinking hardware cursor on startup.
current["showHardwareCursor"] = True

def base_name(spec):
    """Return the base package name (without version) from an npm:name@ver spec."""
    name = spec[4:] if spec.startswith("npm:") else spec
    if name.startswith("@"):
        # Scoped: @scope/pkg[@ver] — last @ after position 0 is the version separator.
        at_idx = name.rfind("@")
        base = name[:at_idx] if at_idx > 0 else name
    else:
        # Unscoped: pkg[@ver]
        base = name.split("@")[0]
    return ("npm:" + base) if spec.startswith("npm:") else base


# Required packages pinned to specific versions.
# Renovate will open PRs when newer versions are available.
required_packages = [
    "npm:pi-auto-theme@1.1.1",
    "npm:pi-mcp-adapter@2.6.1",
    "npm:pi-subagents@0.24.4",
    "npm:context-mode@1.0.151",
    "npm:pi-intercom@0.6.0",
    "npm:pi-powerline@0.6.1",
    "npm:@benvargas/pi-firecrawl@1.0.0",
    "npm:@mjakl/pi-kagi-api@0.1.0",
    "npm:pi-web-access@0.10.7",
    "npm:pi-lmstudio@1.3.0",
]

# Packages to explicitly remove (replaced or deprecated).
packages_to_remove = [
    "npm:@mjakl/pi-kagi-search",
]

existing_packages = current.get("packages", [])
required_base_names = {base_name(pkg) for pkg in required_packages}

# Remove existing entries that match required packages (to replace with pinned
# versions), while preserving runtime-added packages.
filtered = [
    p for p in existing_packages
    if base_name(p if isinstance(p, str) else p.get("source", "")) not in required_base_names
    and base_name(p if isinstance(p, str) else p.get("source", "")) not in packages_to_remove
]

# Add all required packages at their pinned versions.
current["packages"] = filtered + required_packages

# Compaction reserveTokens should be large enough to avoid context overflow.
# With a 256K (262144 token) context window, we use 32K reserve so that
# compaction triggers at ~230K tokens — leaving 32K tokens of headroom.
# This accounts for Pi's conservative chars/4 token overestimate in the
# shouldCompact() check (contextTokens > contextWindow - reserveTokens).
current.setdefault("compaction", {
    "enabled": True,
    "reserveTokens": 32768,  # 32K tokens of safety margin (256K - 32K = 224K trigger)
})

# LM Studio and llama-server model provider extensions.
# Installs pi-lmstudio which auto-discovers LM Studio and llama-server
# and registers them as Pi providers.

print(json.dumps(current, indent=2))
