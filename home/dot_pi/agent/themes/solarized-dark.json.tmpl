{{- $s := .solarized -}}
{
  "$schema": "https://raw.githubusercontent.com/badlogic/pi-mono/main/packages/coding-agent/src/modes/interactive/theme/theme-schema.json",
  "name": "solarized-dark",
  "vars": {
    "base03":  "{{ $s.base03 }}",
    "base02":  "{{ $s.base02 }}",
    "base01":  "{{ $s.base01 }}",
    "base0":   "{{ $s.base0 }}",
    "yellow":  "{{ $s.yellow }}",
    "orange":  "{{ $s.orange }}",
    "red":     "{{ $s.red }}",
    "magenta": "{{ $s.magenta }}",
    "violet":  "{{ $s.violet }}",
    "blue":    "{{ $s.blue }}",
    "cyan":    "{{ $s.cyan }}",
    "green":   "{{ $s.green }}"
  },
  "colors": {
    "accent":       "cyan",
    "border":       "blue",
    "borderAccent": "cyan",
    "borderMuted":  "base01",
    "success":      "green",
    "error":        "red",
    "warning":      "yellow",
    "muted":        "base01",
    "dim":          "base01",
    "text":         "",
    "thinkingText": "base01",

    "selectedBg":         "base02",
    "userMessageBg":      "base02",
    "userMessageText":    "",
    "customMessageBg":    "#0e0b2e",
    "customMessageText":  "",
    "customMessageLabel": "violet",
    "toolPendingBg":      "#001e2c",
    "toolSuccessBg":      "#011c0d",
    "toolErrorBg":        "#1e0a0a",
    "toolTitle":          "",
    "toolOutput":         "base01",

    "mdHeading":        "yellow",
    "mdLink":           "blue",
    "mdLinkUrl":        "base01",
    "mdCode":           "cyan",
    "mdCodeBlock":      "base0",
    "mdCodeBlockBorder": "base01",
    "mdQuote":          "base01",
    "mdQuoteBorder":    "base01",
    "mdHr":             "base01",
    "mdListBullet":     "cyan",

    "toolDiffAdded":    "green",
    "toolDiffRemoved":  "red",
    "toolDiffContext":  "base01",

    "syntaxComment":    "base01",
    "syntaxKeyword":    "green",
    "syntaxFunction":   "blue",
    "syntaxVariable":   "base0",
    "syntaxString":     "cyan",
    "syntaxNumber":     "magenta",
    "syntaxType":       "yellow",
    "syntaxOperator":   "base01",
    "syntaxPunctuation": "base01",

    "thinkingOff":      "base01",
    "thinkingMinimal":  "base01",
    "thinkingLow":      "blue",
    "thinkingMedium":   "cyan",
    "thinkingHigh":     "violet",
    "thinkingXhigh":    "magenta",

    "bashMode": "orange"
  },
  "export": {
    "pageBg":  "base03",
    "cardBg":  "base02",
    "infoBg":  "#052820"
  }
}
