{{- $s := .solarized -}}
{
  "$schema": "https://raw.githubusercontent.com/badlogic/pi-mono/main/packages/coding-agent/src/modes/interactive/theme/theme-schema.json",
  "name": "solarized-light",
  "vars": {
    "base3":   "{{ $s.base3 }}",
    "base2":   "{{ $s.base2 }}",
    "base1":   "{{ $s.base1 }}",
    "base01":  "{{ $s.base01 }}",
    "base00":  "{{ $s.base00 }}",
    "yellow":  "{{ $s.yellow }}",
    "orange":  "{{ $s.orange }}",
    "red":     "{{ $s.red }}",
    "magenta": "{{ $s.magenta }}",
    "violet":  "{{ $s.violet }}",
    "blue":    "{{ $s.blue }}",
    "cyan":    "{{ $s.cyan }}",
    "green":   "{{ $s.green }}"
  },
  "colors": {
    "accent":       "cyan",
    "border":       "blue",
    "borderAccent": "cyan",
    "borderMuted":  "base1",
    "success":      "green",
    "error":        "red",
    "warning":      "yellow",
    "muted":        "base01",
    "dim":          "base1",
    "text":         "",
    "thinkingText": "base01",

    "selectedBg":       "base2",
    "userMessageBg":    "base2",
    "userMessageText":  "",
    "customMessageBg":  "#e8e0f0",
    "customMessageText": "",
    "customMessageLabel": "violet",
    "toolPendingBg":    "#eef2f8",
    "toolSuccessBg":    "#edf3e0",
    "toolErrorBg":      "#f8ecea",
    "toolTitle":        "",
    "toolOutput":       "base01",

    "mdHeading":        "yellow",
    "mdLink":           "blue",
    "mdLinkUrl":        "base01",
    "mdCode":           "cyan",
    "mdCodeBlock":      "base00",
    "mdCodeBlockBorder": "base1",
    "mdQuote":          "base01",
    "mdQuoteBorder":    "base01",
    "mdHr":             "base1",
    "mdListBullet":     "cyan",

    "toolDiffAdded":    "green",
    "toolDiffRemoved":  "red",
    "toolDiffContext":  "base01",

    "syntaxComment":    "base1",
    "syntaxKeyword":    "green",
    "syntaxFunction":   "blue",
    "syntaxVariable":   "base00",
    "syntaxString":     "cyan",
    "syntaxNumber":     "magenta",
    "syntaxType":       "yellow",
    "syntaxOperator":   "base01",
    "syntaxPunctuation": "base01",

    "thinkingOff":      "base1",
    "thinkingMinimal":  "base01",
    "thinkingLow":      "blue",
    "thinkingMedium":   "cyan",
    "thinkingHigh":     "violet",
    "thinkingXhigh":    "magenta",

    "bashMode": "orange"
  },
  "export": {
    "pageBg":  "base3",
    "cardBg":  "#ffffff",
    "infoBg":  "#fdf3c8"
  }
}
