{{- /* Pi side of plannotator-tui (send reviews to Pi, plannotator_tui_note tool),
   from `plannotator-tui pi install --print` so it always matches the installed
   binary. Empty until mise has installed plannotator-tui
   (.chezmoitemplates/mise/base.toml). */ -}}
{{- $shim := joinPath .chezmoi.homeDir ".local/share/mise/shims/plannotator-tui" -}}
{{- if stat $shim -}}
{{-   output "sh" "-c" "\"$1\" pi install --print 2>/dev/null || true" "sh" $shim -}}
{{- end -}}
