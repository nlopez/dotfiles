#!/bin/sh
# Merge chezmoi-managed keys into mcp.json, preserving runtime keys that pi
# writes itself (e.g. directTools). Uses jq's recursive-merge operator so the
# chezmoi overlay wins on conflicts, but unrecognised keys are kept as-is.

OVERLAY=$(cat << 'EOF'
{
  "settings": {
    "autoAuth": true
  },
  "mcpServers": {
    {{- if .work }}
    "datadog": {
      "url": "https://mcp.datadoghq.com/api/unstable/mcp-server/mcp?toolsets=core,ddsql",
      "auth": "oauth"
    },
    "ddstaging": {
      "url": "https://mcp.ddstaging.datadoghq.com/api/unstable/mcp-server/mcp?toolsets=core,ddsql",
      "auth": "oauth"
    },
    "atlassian": {
      "url": "https://mcp.atlassian.com/v1/mcp/authv2",
      "auth": "oauth"
    },
    "slack": {
      "url": "https://mcp.slack.com/mcp",
      "auth": "oauth",
      "oauth": {
        "clientId": "1601185624273.8899143856786"
      }
    }
    {{- end }}
  }
}
EOF
)

current=$(cat)

if [ -z "$current" ]; then
  printf '%s\n' "$OVERLAY"
else
  printf '%s\n' "$current" | jq --argjson overlay "$OVERLAY" '. * $overlay | del(.mcpServers.figma)'
fi
