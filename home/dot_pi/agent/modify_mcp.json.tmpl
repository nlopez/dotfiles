#!/bin/sh
# Merge chezmoi-managed keys into mcp.json, preserving runtime keys that pi
# writes itself (e.g. enabled state). Uses jq's recursive-merge
# operator so the chezmoi overlay wins on conflicts, but unrecognised keys
# are kept as-is.
#
# Private MCP servers come from .chezmoitemplates/private-mcp-servers (see
# docs/private-data.md). Per-machine OAuth sign-in happens afterwards via
# /mcp; over SSH, paste the browser's redirected URL into the sign-in screen.
#
# Also migrates pi-mcp-adapter legacy fields to native pi 1.0 format:
#   directTools        →  removed (exposure is forced below)
#   auth: "oauth"      →  removed (pi auto-detects OAuth from server response)
#   settings.autoAuth  →  removed (not a native pi mcp.json field)
#
# Every server gets exposure "deferred": pi's default ("codemode") hides
# their tools from the model unless it calls searchTools(), while deferred
# servers are found through the declared tool_search tool. Exposure changes
# made through /mcp are reset on the next apply.

{{- $servers := includeTemplate "private-mcp-servers" . | fromJson }}

OVERLAY=$(cat << 'EOF'
{
  "mcpServers": {
    "playwright": {
      "command": "{{ includeTemplate "nix-profile" . }}/bin/npx",
      "args": ["-y", "{{ .mcp.playwright | trimPrefix "npm:" }}"]
    }
{{- if or (not .headless) .workspace }}
    ,"kagi": {
{{- if .workspace }}
      "command": "{{ includeTemplate "nix-profile" . }}/bin/uvx",
      "args": ["kagimcp"]
{{- else }}
      "command": "{{ .chezmoi.homeDir }}/.local/share/mise/shims/varlock",
      "args": ["run", "-p", "{{ .chezmoi.homeDir }}/.config/varlock/agents.env", "--filter", "KAGI_API_KEY", "--inject", "vars", "--no-redact-stdout", "--", "{{ includeTemplate "nix-profile" . }}/bin/uvx", "kagimcp"]
{{- end }}
    }
{{- end }}
{{- if not .headless }}
    ,"1password": {
      "command": "1password-mcp"
    }
{{- end }}
{{- range $k, $v := $servers }}
    ,"{{ $k }}": {{ $v | toJson }}
{{- end }}
  }
}
EOF
)

current=$(cat)

if [ -z "$current" ]; then
  printf '%s\n' "$OVERLAY"
else
  # Retired servers, plus private servers excluded on this machine (see
  # .chezmoitemplates/private-mcp-servers), are removed.
{{- $p := includeTemplate "private-data" . | fromYaml }}
  # datadog is retired in favour of the pup CLI.
{{- $drop := concat (list "figma" "datadog" "datadog-prod" "datadog-staging") ($p.mcp_retired | default list) }}
{{- if .workspace }}{{ $drop = concat $drop ($p.mcp_workspace_exclude | default list) }}{{ end }}
  # On workspaces, wmux owns the servers it marks wmuxManaged (it points
  # them at its local auth proxy), so their entries are kept as wmux wrote them.
  printf '%s\n' "$current" | jq --argjson overlay "$OVERLAY" --argjson drop {{ $drop | toJson | squote }} '
    . as $cur |
    . * $overlay |
{{- if .workspace }}
    .mcpServers |= with_entries(
      if $cur.mcpServers[.key].wmuxManaged then .value = $cur.mcpServers[.key] else . end
    ) |
{{- end }}
    del(.settings) |
    .mcpServers |= with_entries(
      .value |= (
        . + {"exposure": "deferred"} |
        del(.directTools, .auth)
      )
    ) |
    reduce $drop[] as $k (.; del(.mcpServers[$k]))
  '
fi
