import json
import sys

current_raw = sys.stdin.read()
current = {}
try:
    if current_raw.strip():
        current = json.loads(current_raw)
except Exception:
    pass

current.setdefault("providers", {})

{{- $pi := (includeTemplate "private-data" . | fromYaml).pi | default dict }}
GATEWAY = json.loads({{ if and .work $pi.gateway }}{{ $pi.gateway | toJson | quote }}{{ else }}"null"{{ end }})
WORK_EMAIL = {{ .workemail | quote }}

if GATEWAY:
    # Drop legacy providers from the old gateway host (never touches the
    # providers /refresh-models writes against the current host).
    legacy_host = GATEWAY.get("legacy_host")
    for key in list(current["providers"]):
        legacy = current["providers"][key]
        if legacy_host and isinstance(legacy, dict) and legacy_host in legacy.get("baseUrl", ""):
            del current["providers"][key]

    provider = GATEWAY["provider"]
    existing = current["providers"].get(provider, {})
    headers = dict(GATEWAY.get("headers", {}))
    if GATEWAY.get("email_header"):
        headers[GATEWAY["email_header"]] = WORK_EMAIL or "unknown"
    if GATEWAY.get("team_header"):
        headers[GATEWAY["team_header"]] = existing.get("headers", {}).get(GATEWAY["team_header"], "unknown")

    glm_5_3 = {
        "id": "glm-5-3",
        "name": "GLM 5.3 (AI Gateway logical)",
        "api": "openai-completions",
        "reasoning": True,
        "input": ["text"],
        "contextWindow": 1048576,
        "maxTokens": 131072,
        "compat": {"supportsDeveloperRole": False},
        "thinkingLevelMap": {
            "off": None,
            "minimal": None,
            "low": "low",
            "medium": None,
            "high": "high",
            "xhigh": None,
            "max": "max",
        },
    }
    current["providers"][provider] = {
        "baseUrl": GATEWAY["base_url"],
        "api": "openai-completions",
        "apiKey": GATEWAY["api_key"],
        "headers": headers,
        "models": existing.get("models") or [glm_5_3],
    }
else:
    # Built-in Anthropic provider: raise Sonnet to the 1M context window.
    prov = current["providers"].setdefault("anthropic", {})
    prov.setdefault("modelOverrides", {})["claude-sonnet-5-5"] = {"contextWindow": 1000000}

