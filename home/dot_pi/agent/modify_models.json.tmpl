        current["providers"].setdefault(key, cfg)

    provider = GATEWAY["provider"]
    existing = current["providers"].get(provider, {})
    headers = dict(GATEWAY.get("headers", {}))
    if GATEWAY.get("email_header"):
        headers[GATEWAY["email_header"]] = WORK_EMAIL or "unknown"
    if GATEWAY.get("team_header"):
        headers[GATEWAY["team_header"]] = existing.get("headers", {}).get(GATEWAY["team_header"], "unknown")

    glm_5_3 = {
        "id": "glm-5-3",
        "name": "GLM 5.3 (AI Gateway logical)",
        "api": "openai-completions",
        "reasoning": True,
        "input": ["text"],
