{{- if lookPath "atuin" }}
# Disable history file and zsh's own history management in favor of atuin
unset HISTFILE
function zshaddhistory() { return 1 }
alias history="atuin history list"
{{- end }}

ZSH_AUTOSUGGEST_BUFFER_MAX_SIZE=20

cd() {
  # If given a file path, cd to its parent directory. ${1:h} is zsh's :h modifier
  # (borrowed from vi), which strips the trailing filename component — like dirname.
  if [[ $# -eq 1 && -f "$1" ]]; then
    set -- "${1:h}"
  fi
  if (( $+functions[z] )); then
    z "$@"
  else
    builtin cd "$@"
  fi
}

# Rebuild PATH from scratch on reload: hand .zprofile a clean slate so
# added/removed paths are accurate rather than carried over from the old shell.
{{- if eq .chezmoi.os "darwin" }}
alias reload='exec env -i PATH=/usr/bin:/bin:/usr/sbin:/sbin TERMINFO=$TERMINFO TERM=$TERM USER=$USER HOME=$HOME SHELL=$SHELL TMUX=$TMUX TMUX_PANE=$TMUX_PANE zsh --login'
{{- else }}
alias reload='exec env -i PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin TERMINFO=$TERMINFO TERM=$TERM USER=$USER HOME=$HOME SHELL=$SHELL TMUX=$TMUX TMUX_PANE=$TMUX_PANE zsh --login'
{{- end }}

###############################################################################
# AWS profile fzf picker — ZLE widget that intercepts Tab after --profile / -p
###############################################################################
_aws_profile_fzf() {
  # Only activate when the command on the line starts with `aws`.
  [[ "$BUFFER" != aws\ * ]] && { zle expand-or-complete; return }

  # When Tab is pressed mid-word, zsh may have split the buffer so that the
  # partial word sits in RBUFFER. Reconstruct the full left context by appending
  # the current partial word (everything in RBUFFER up to the next space).
  local full_left="$LBUFFER"
  local partial_word="${RBUFFER%%[[:space:]]*}"
  [[ -n "$partial_word" && "$partial_word" != -* ]] && full_left+="$partial_word"

  # Only activate when the cursor is directly after --profile or -p (with optional partial).
  if [[ ! "$full_left" =~ '(--profile[[:space:]]+|--profile=|-p[[:space:]]+)([-a-zA-Z0-9_.]*)$' ]]; then
    zle expand-or-complete
    return
  fi

  local query="${match[2]}" # partial already typed, may be empty

  # Strip the partial from LBUFFER so we can splice the chosen value in cleanly.
  local lbuffer_base="${LBUFFER%${query}}"

  local config="${AWS_CONFIG_FILE:-$HOME/.aws/config}"
  [[ -f "$config" ]] || { zle expand-or-complete; return }

  local profiles
  profiles=$(grep -E '^\[(profile [^]]+|default)\]' "$config" \
    | sed -E 's/^\[profile ([^]]+)\]$/\1/; s/^\[default\]$/default/')
  [[ -z "$profiles" ]] && { zle expand-or-complete; return }

  local aws_bin
  aws_bin=$(whence -p aws)

  local chosen
  chosen=$(printf '%s\n' "$profiles" | fzf \
    --height=40% \
    --layout=reverse \
    --border \
    --prompt='AWS profile> ' \
    --query="$query" \
    --preview="$aws_bin configure list --profile {} 2>/dev/null || echo '(no details)'" \
    --preview-window='right:50%:wrap' \
  )

  # Esc / Ctrl-C — leave the buffer untouched.
  [[ -z "$chosen" ]] && zle redisplay && return 0

  LBUFFER="${lbuffer_base}${chosen}"
  zle redisplay
}
zle -N _aws_profile_fzf
bindkey '^I' _aws_profile_fzf  # ^I is Tab

###############################################################################
# gh wrapper — appends a Pi co-authorship footer to issue/PR comments
###############################################################################
gh() {
  # Intercept: gh {pr,issue} {create,edit,comment,review} when --body is given.
  # Keep in sync with gh-attribution.ts (covers the interactive shell case;
  # the extension covers pi agent bash tool calls).
  if (( $# >= 2 )) && {
       [[ "$1" == "issue" && ( "$2" == "comment" || "$2" == "create" || "$2" == "edit" ) ]] ||
       [[ "$1" == "pr"    && ( "$2" == "comment" || "$2" == "review" || "$2" == "edit" || "$2" == "create" ) ]]
     }; then
    local -a args=("$@")
    local -a newargs=()
    local i=1 modified=0
    while (( i <= ${#args} )); do
      if [[ "${args[$i]}" == "--body" ]] && (( i + 1 <= ${#args} )); then
        local pi_name
        pi_name=$(pi-model-name 2>/dev/null)
        local footer=$'\n\n---\n'"*Co-authored with Pi${pi_name:+ (${pi_name})}*"
        newargs+=("--body" "${args[$((i+1))]}${footer}")
        (( i += 2 ))
        modified=1
      else
        newargs+=("${args[$i]}")
        (( i++ ))
      fi
    done
    # --body-file <path>: append footer to the file in-place, keep args unchanged.
    if (( ! modified )); then
      local j=1
      while (( j <= ${#args} )); do
        if [[ "${args[$j]}" == "--body-file" ]] && (( j + 1 <= ${#args} )); then
          local bf_path="${args[$((j+1))]}"
          if [[ "$bf_path" != "-" ]] && [[ -f "$bf_path" ]]; then
            local bf_content
            bf_content=$(cat "$bf_path")
            if [[ "$bf_content" != *"Co-authored with Pi"* ]]; then
              local pi_name
              pi_name=$(pi-model-name 2>/dev/null)
              local footer=$'\n\n---\n'"*Co-authored with Pi${pi_name:+ (${pi_name})}*"
              printf '%s%s' "$bf_content" "$footer" > "$bf_path"
              modified=1
            fi
          fi
          break
        fi
        (( j++ ))
      done
    fi

    (( modified )) && { command gh "${newargs[@]}"; return }
  fi
  command gh "$@"
}

