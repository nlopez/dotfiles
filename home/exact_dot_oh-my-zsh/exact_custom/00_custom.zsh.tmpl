{{- if lookPath "atuin" }}
# Disable history file and zsh's own history management in favor of atuin
unset HISTFILE
function zshaddhistory() { return 1 }
alias history="atuin history list"
{{- end }}

ZSH_AUTOSUGGEST_BUFFER_MAX_SIZE=20

cd() {
  # If given a file path, cd to its parent directory. ${1:h} is zsh's :h modifier
  # (borrowed from vi), which strips the trailing filename component — like dirname.
  if [[ $# -eq 1 && -f "$1" ]]; then
    set -- "${1:h}"
  fi
  if (( $+functions[z] )); then
    z "$@"
  else
    builtin cd "$@"
  fi
}

alias reload='exec env -i PATH=$PATH TERMINFO=$TERMINFO TERM=$TERM USER=$USER HOME=$HOME SHELL=$SHELL TMUX=$TMUX zsh --login'

{{- if .work }}
{{- if lookPath "awsv" }}
eval "$(awsv init)"
{{- end }}

alias sudo="/Applications/Privileges.app/Contents/MacOS/PrivilegesCLI -a && /usr/bin/sudo"
{{- end }}
