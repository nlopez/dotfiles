#!/usr/bin/env python3
"""Refuse agent git commands that stage every change in the work tree.

Several agent sessions can share one checkout, and a blanket stage commits
another session's unfinished edits. Used as a Claude Code PreToolUse hook (Bash
matcher) and by the pi extension stage-guard.ts; hook I/O in agent_guard.py.

Blocks `git add` with -A/--all/-u/--update or a whole-tree pathspec (., ./, :/,
*), and `git commit` with -a/--all. Heredoc bodies and commit/PR message
arguments are ignored.
"""

import os
import re
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import agent_guard  # noqa: E402

REASON = (
    "Blocked: this stages every change in the work tree, including other "
    "sessions' unfinished edits. Stage only the files you changed: "
    "`git add <path>...` (check with `git status --short` first), then commit "
    "without -a."
)

# `git` plus global options (-C <dir>, -c <k=v>, --no-pager, ...), then the subcommand.
GIT = r"\bgit(?:\s+(?:-[Cc]\s+\S+|--[\w-]+(?:=\S+)?))*\s+"
ARGS = r"(?P<args>[^;&|\n)]*)"
ADD = re.compile(GIT + r"(?:add|stage)\b" + ARGS)
COMMIT = re.compile(GIT + r"commit\b" + ARGS)

ADD_ALL = re.compile(
    r"(?:^|\s)(?:--all|--update|-(?!-)[a-zA-Z]*[Au][a-zA-Z]*"
    r"|['\"]?(?:\.|\./|:/|:\(top\)|\*)['\"]?)(?=\s|$)"
)
COMMIT_ALL = re.compile(r"(?:^|\s)(?:--all|-(?!-)[a-zA-Z]*a[a-zA-Z]*)(?=\s|$)")


def blocked(text: str) -> bool:
    return any(ADD_ALL.search(m.group("args")) for m in ADD.finditer(text)) or any(
        COMMIT_ALL.search(m.group("args")) for m in COMMIT.finditer(text)
    )


if __name__ == "__main__":
    agent_guard.run(blocked, REASON)
