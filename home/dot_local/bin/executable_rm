#!/usr/bin/env bash
# rm shim: prefer `trash` when available, swallowing rm-style flags it doesn't accept.

if ! command -v trash >/dev/null 2>&1; then
  exec /bin/rm "$@"
fi

args=()
paths=()
end_of_opts=0
verbose=0
force=0
for arg in "$@"; do
  if [ "$end_of_opts" -eq 1 ]; then
    paths+=("$arg")
  elif [ "$arg" = "--" ]; then
    end_of_opts=1
  elif [ "$arg" = "--verbose" ]; then
    verbose=1
  elif [ "${arg#-}" != "$arg" ] && [ -n "${arg#-}" ]; then
    # bundled short flags like -rfv: extract known flags, swallow the rest
    case "$arg" in
      -*v*) verbose=1 ;;
    esac
    case "$arg" in
      -*f*) force=1 ;;
    esac
  else
    paths+=("$arg")
  fi
done

[ ${#paths[@]} -eq 0 ] && exit 0

[ "$verbose" -eq 1 ] && args+=(-v)

exit_code=0
existing=()
for path in "${paths[@]}"; do
  if [ ! -e "$path" ] && [ ! -L "$path" ]; then
    if [ "$force" -eq 0 ]; then
      echo "rm: $path: No such file or directory" >&2
      exit_code=1
    fi
  else
    existing+=("$path")
  fi
done

if [ ${#existing[@]} -gt 0 ]; then
  trash "${args[@]}" "${existing[@]}" || exit_code=$?
fi

exit $exit_code
