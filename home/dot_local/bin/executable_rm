#!/usr/bin/env bash
# rm shim: prefer `trash` when available, swallowing rm-style flags it doesn't accept.

if ! command -v trash >/dev/null 2>&1; then
  exec /bin/rm "$@"
fi

args=()
paths=()
end_of_opts=0
verbose=0
for arg in "$@"; do
  if [ "$end_of_opts" -eq 1 ]; then
    paths+=("$arg")
  elif [ "$arg" = "--" ]; then
    end_of_opts=1
  elif [ "$arg" = "--verbose" ]; then
    verbose=1
  elif [ "${arg#-}" != "$arg" ] && [ -n "${arg#-}" ]; then
    # bundled short flags like -rfv: extract v if present, swallow the rest
    case "$arg" in
      -*v*) verbose=1 ;;
    esac
  else
    paths+=("$arg")
  fi
done

[ ${#paths[@]} -eq 0 ] && exit 0

[ "$verbose" -eq 1 ] && args+=(-v)

exec trash "${args[@]}" "${paths[@]}"
