{{- if and (or .personal .work) (not .headless) -}}
#!/bin/bash

# Keeps Engram Cloud autosync enrollment in step with the repos you work on.
# Enrollment lives in the local SQLite store (not on the server) and autosync
# only replicates enrolled projects, so this runs on apply and every 5 minutes
# from the com.local.engram-cloud-enroll LaunchAgent.
#
# 1. Enrolls the project every git repo under the ghq root resolves to, plus
#    every project already in the local store, except engram.cloud_exclude
#    (.chezmoidata/engram.yaml).
# 2. Reports drift: a repo whose project stays unenrolled or has an alias
#    conflict, or a project with local memories but nothing on the server.
#    Problems go to stdout (the LaunchAgent log) and to a desktop notification
#    once they persist across two runs.

set -ufo pipefail

export PATH="{{ includeTemplate "agent-path" . }}:$PATH"
export ENGRAM_DATA_DIR="${XDG_DATA_HOME:-{{ .chezmoi.homeDir }}/.local/share}/engram"

command -v engram >/dev/null 2>&1 || { echo "engram not found, skipping" >&2; exit 0; }
command -v jq >/dev/null 2>&1 || { echo "jq not found, skipping" >&2; exit 0; }

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/engram"
mkdir -p "$state_dir"
prev="$state_dir/cloud-enroll.problems"
notified="$state_dir/cloud-enroll.notified"
touch "$prev" "$notified"

exclude=({{ range .engram.cloud_exclude | default list }}{{ . | quote }} {{ end }})
excluded() {
  local x
  for x in "${exclude[@]+"${exclude[@]}"}"; do
    [ "$1" = "$x" ] && return 0
  done
  return 1
}

problems=()
work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT
: >"$work/enrolled" # projects handled this run
: >"$work/repos"    # "<project>\t<dir>" for repos under ~/src
: >"$work/store"    # "<project> <obs>" from the local store

enroll() {
  grep -qxF -- "$1" "$work/enrolled" && return 0
  printf '%s\n' "$1" >>"$work/enrolled"
  excluded "$1" && return 0
  engram cloud enroll "$1" >/dev/null 2>&1 || problems+=("enroll failed: $1")
}

# Repos under ~/src (ghq root), resolved the way agents resolve their cwd.
repos() {
  if command -v ghq >/dev/null 2>&1; then
    ghq list -p
  elif [ -d "$HOME/src" ]; then
    find "$HOME/src" -mindepth 2 -maxdepth 5 -name .git -prune -print 2>/dev/null | sed 's#/\.git$##'
  fi
}
while read -r dir; do
  [ -n "$dir" ] || continue
  json="$(engram projects alias resolve --cwd "$dir" 2>/dev/null)" || {
    problems+=("cannot resolve project: $dir")
    continue
  }
  project="$(jq -r '.project // empty' <<<"$json")"
  [ -n "$project" ] || { problems+=("no project name: $dir"); continue; }
  [ "$(jq -r '.conflict' <<<"$json")" = "true" ] && problems+=("alias conflict: $dir -> $project")
  other="$(awk -F '\t' -v p="$project" '$1 == p { print $2; exit }' "$work/repos")"
  [ -n "$other" ] && problems+=("shared project name $project: $other and $dir")
  printf '%s\t%s\n' "$project" "$dir" >>"$work/repos"
  enroll "$project"
done < <(repos)

# Projects already in the store, including ones outside ~/src.
# `engram projects list`: a "Projects (N):" header, then "  <name>  <N> obs ...".
engram projects list | awk 'NR > 1 && NF { print $1, $2 }' >"$work/store"
while read -r project _; do
  enroll "$project"
done <"$work/store"

# Verify: ~/src projects are enrolled; projects with memories reached the server.
while IFS=$'\t' read -r project dir; do
  excluded "$project" && continue
  json="$(engram projects alias resolve --cwd "$dir" 2>/dev/null)" || continue
  [ "$(jq -r '.enrolled' <<<"$json")" = "true" ] || problems+=("not enrolled: $project ($dir)")
done <"$work/repos"
while read -r project obs; do
  excluded "$project" && continue
  [ "$obs" -gt 0 ] 2>/dev/null || continue
  remote="$(engram sync --cloud --status --project "$project" 2>&1 | awk '/Remote chunks:/ { print $3 }')"
  if [ -z "$remote" ]; then
    problems+=("cloud status unavailable: $project")
  elif [ "$remote" -eq 0 ]; then
    problems+=("nothing on server: $project ($obs local memories)")
  fi
done <"$work/store"

current="$(printf '%s\n' "${problems[@]+"${problems[@]}"}" | sed '/^$/d' | sort -u)"
if [ -n "$current" ]; then
  printf '%s %s\n' "$(date '+%F %T')" "$current" | sed '2,$s/^/  /'
fi

# Notify once per problem, after it has persisted for two runs.
persisting="$(comm -12 <(printf '%s\n' "$current" | sed '/^$/d') "$prev")"
new="$(comm -23 <(printf '%s\n' "$persisting" | sed '/^$/d') "$notified")"
if [ -n "$new" ] && command -v osascript >/dev/null 2>&1; then
  msg="$(printf '%s' "$new" | head -3 | tr '\n' ';' | sed 's/;$//; s/"/\\"/g')"
  osascript -e "display notification \"$msg\" with title \"Engram sync drift\"" >/dev/null 2>&1 || true
fi
printf '%s\n' "$current" | sed '/^$/d' >"$prev"
printf '%s\n' "$persisting" | sed '/^$/d' >"$notified"
exit 0
{{ end -}}
