#!/bin/bash
# Launch claude or pi against DigitalOcean serverless inference.
#
#   doai claude [claude args...]
#   doai pi [pi args...]
#
# The model access key is read from 1Password on each launch and only exported
# to the child process. DOAI_CLAUDE_MODEL / DOAI_PI_MODEL pick the default
# model; an explicit --model argument wins.
set -euo pipefail

readonly KEY_REF="op://evjh25ux2mnoufaut6qhvm2pdi/apjntvnyx7etmzvxsksqgx2lcm/credential"
readonly BASE_URL="https://inference.do-ai.run"

usage() {
  echo "usage: doai {claude|pi} [args...]" >&2
  exit 2
}

[[ $# -ge 1 ]] || usage
tool=$1
shift

MODEL_ACCESS_KEY=$(op read --no-newline "$KEY_REF") || {
  echo "doai: could not read the DigitalOcean model access key from 1Password" >&2
  exit 1
}
export MODEL_ACCESS_KEY

has_model_flag() {
  local arg
  for arg in "$@"; do
    [[ $arg == --model || $arg == --model=* ]] && return 0
  done
  return 1
}

case $tool in
  claude)
    export ANTHROPIC_BASE_URL=$BASE_URL
    export CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS=1
    export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
    export ANTHROPIC_MODEL=${DOAI_CLAUDE_MODEL:-sonnet}
    exec claude \
      --settings '{"apiKeyHelper":"printenv MODEL_ACCESS_KEY","forceLoginMethod":"console"}' \
      "$@"
    ;;
  pi)
    args=(--provider digitalocean)
    has_model_flag "$@" || args+=(--model "${DOAI_PI_MODEL:-anthropic-claude-sonnet-5.5}")
    exec pi "${args[@]}" "$@"
    ;;
  *)
    usage
    ;;
esac
