#!/bin/sh
# Wrapper: locate op-ssh-sign at runtime so git config needs no OS conditional.
# Searches known paths in order of preference.
for _path in \
  /Applications/1Password.app/Contents/MacOS/op-ssh-sign \
  /opt/1Password/op-ssh-sign; do
  if [ -x "$_path" ]; then
    exec "$_path" "$@"
  fi
done
echo "op-ssh-sign not found in known locations" >&2
exit 1
