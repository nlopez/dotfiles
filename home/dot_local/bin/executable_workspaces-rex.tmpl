#!/usr/bin/env -S uv run --python 3.14.3 --script
"""Tunnel from this Mac to the Rex servers on your cloud workspaces.

  workspaces-rex status      supervisor and local sockets
  workspaces-rex supervise   run the supervisor (the LaunchAgent runs this)

Rex (https://www.superlogical.com/rex) keeps terminals and agents running on a
workspace while the laptop is closed. Each workspace runs a Rex server that
these dotfiles install (see .chezmoidata/rex.yaml).

The LaunchAgent com.local.workspaces-rex runs the supervisor. Every minute it
lists your running workspaces. For each one with a Rex server it keeps a
socket-activated launchd job that forwards a local socket to the server's
socket with `ssh -W`, and, while a Rex client is connected, one
agent-forwarding SSH session so terminals on the workspace can use this Mac's
SSH keys. Paused workspaces get no socket, so Rex does not resume them. The
tunnels keep running while the supervisor restarts.
"""

from __future__ import annotations

import argparse
import json
import os
import plistlib
import re
import shutil
import subprocess
import sys
import time
from pathlib import Path

HOME = Path.home()
NAME_RE = re.compile(r"^[a-zA-Z0-9][a-zA-Z0-9-]*$")

STATE_DIR = Path(os.environ.get("XDG_STATE_HOME") or HOME / ".local/state") / "workspaces/rex"
JOBS_DIR = STATE_DIR / "jobs"
SUPERVISOR_LABEL = "com.local.workspaces-rex"
SUPERVISOR_LOG = STATE_DIR / "supervisor.log"
TUNNEL_PREFIX = SUPERVISOR_LABEL + ".tunnel."
AGENT_PREFIX = SUPERVISOR_LABEL + ".agent."
DOMAIN = f"gui/{os.getuid()}"
# sun_path holds 104 bytes on macOS, including the terminating NUL.
MAX_SOCKET_PATH = 103

if os.environ.get("REX_CONFIG", "").startswith("/"):
    REX_CONFIG_DIR = Path(os.environ["REX_CONFIG"]).parent
else:
    REX_CONFIG_DIR = Path(os.environ.get("XDG_CONFIG_HOME") or HOME / ".config") / "rex"
# Loaded by ~/.config/rex/init.lua (chezmoi-managed).
HOSTS_FILE = REX_CONFIG_DIR / "workspaces_rex.lua"
# rex is on PATH only in Rex terminals; launchd jobs need the app's copy.
MAC_REX = (
    HOME
    / "Library/Application Support/com.superlogical.rex/RexServer/Versions/Current/Rex Server.app/Contents/MacOS/rex"
)

POLL_INTERVAL = 60
AGENT_POLL_INTERVAL = 5
WAKE_SLACK = 30
ENSURE_TIMEOUT = 45

# Find a dead connection in about 30 seconds. Whichever client starts the ssh
# connection master sets them, so every job uses the same values.
# ConnectTimeout stops a connect from hanging while the network comes back.
SSH_KEEPALIVE = [
    "-o", "BatchMode=yes",
    "-o", "ConnectTimeout=10",
    "-o", "ServerAliveInterval=15",
    "-o", "ServerAliveCountMax=2",
]  # fmt: skip

# launchd starts one instance of an inetd-style job per accepted connection
# and labels it <job label>.<UUID>.
CONNECTION_RE = re.compile(r"^(.+)\.[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$")

# Runs the workspace's ensure script (dot_local/share/workspaces-rex), which
# starts the server if needed and prints a marker line, then the server's
# JSON status. A workspace without it has no Rex server. The marker separates
# login-shell noise from that output.
MARKER = "--- workspaces-rex ---"
NOT_INSTALLED = "not-installed"
ENSURE_REMOTE_SH = f"""ensure="$HOME/.local/share/workspaces-rex/ensure"
if [ ! -x "$ensure" ] || [ ! -x "$HOME/.local/bin/rex" ]; then
	echo '{MARKER}'
	echo '{NOT_INSTALLED}'
	exit 0
fi
exec "$ensure"
"""


class Error(Exception):
    pass


# ── Workspace access ──────────────────────────────────────────────────────────


def ssh_host(ws: str) -> str:
    """The SSH alias that the workspaces CLI writes for a workspace."""
    return "workspace-" + ws


def stderr_tail(stderr: str) -> str:
    lines = stderr.strip().splitlines()[-5:]
    return (": " + "\n".join(lines)) if lines else ""


def run_remote(ws: str, script: str, timeout: float) -> str:
    """Run script with a bash login shell on the workspace; return stdout."""
    cmd = [
        "ssh", "-T",
        "-o", "BatchMode=yes",
        "-o", "ConnectTimeout=20",
        # A RemoteForward from the SSH config would replace the forwarded
        # socket of another open connection, and this connection is short.
        "-o", "ClearAllForwardings=yes",
        ssh_host(ws),
        "bash -l -s",
    ]  # fmt: skip
    try:
        p = subprocess.run(cmd, input=script, capture_output=True, text=True, timeout=timeout)
    except subprocess.TimeoutExpired as e:
        raise Error(f"ssh {ssh_host(ws)}: timed out after {timeout:.0f}s") from e
    if p.returncode != 0:
        raise Error(f"ssh {ssh_host(ws)}: exit {p.returncode}{stderr_tail(p.stderr)}")
    return p.stdout


def close_master(ws: str) -> bool:
    p = subprocess.run(["ssh", "-O", "exit", ssh_host(ws)], capture_output=True, timeout=10)
    return p.returncode == 0


def running_workspaces() -> list[str]:
    """Names of your PROVISIONED workspaces. Paused ones are left out: an SSH
    connection would resume them."""
    p = subprocess.run(["workspaces", "list", "--no-color"], capture_output=True, text=True, timeout=60)
    if p.returncode != 0:
        raise Error(f"workspaces list: exit {p.returncode}{stderr_tail(p.stderr or p.stdout)}")
    lines = [line for line in p.stdout.splitlines() if line.strip()]
    if not lines:
        return []
    header = lines[0].split()
    if "NAME" not in header or "STATUS" not in header:
        raise Error(f"workspaces list: unexpected header {lines[0]!r}")
    name_col, status_col = header.index("NAME"), header.index("STATUS")
    names = []
    for line in lines[1:]:
        fields = line.split()
        if len(fields) > status_col and fields[status_col] == "PROVISIONED":
            names.append(fields[name_col])
    return sorted(names)


def ensure_server(ws: str) -> str | None:
    """Start the workspace's Rex server if needed. Returns its socket path,
    or None when the workspace has no Rex server."""
    out = run_remote(ws, ENSURE_REMOTE_SH, timeout=ENSURE_TIMEOUT)
    i = out.rfind(MARKER + "\n")
    if i < 0:
        raise Error(f"unexpected ensure output: {out[:200]!r}")
    body = out[i + len(MARKER) + 1 :].strip()
    if body == NOT_INSTALLED:
        return None
    endpoint = json.loads(body).get("endpoint", "")
    path = endpoint.removeprefix("unix://")
    if path == endpoint or not path.startswith("/"):
        raise Error(f"rex server endpoint {endpoint!r} is not a Unix socket")
    return path


# ── launchd ───────────────────────────────────────────────────────────────────


def launchctl(*args: str, timeout: float = 30) -> subprocess.CompletedProcess:
    return subprocess.run(["launchctl", *args], capture_output=True, text=True, timeout=timeout)


def _output(p: subprocess.CompletedProcess) -> str:
    return (p.stdout + p.stderr).strip()


def _not_found(p: subprocess.CompletedProcess) -> bool:
    out = _output(p)
    return any(s in out for s in ("Could not find specified service", "Could not find service", "No such process"))


def bootstrap(plist: Path) -> None:
    # bootout returns before launchd forgets the old job, and bootstrap fails
    # with error 5 until it does.
    for _ in range(20):
        p = launchctl("bootstrap", DOMAIN, str(plist))
        if p.returncode == 0:
            return
        if "Bootstrap failed: 5:" not in _output(p):
            break
        time.sleep(0.25)
    raise Error(f"launchctl bootstrap {plist}: {_output(p)}")


def bootout(label: str) -> None:
    try:
        p = launchctl("bootout", "--wait", f"{DOMAIN}/{label}", timeout=15)
    except subprocess.TimeoutExpired as e:
        raise Error(f"timed out waiting for {label} to stop") from e
    if p.returncode != 0 and not _not_found(p):
        raise Error(f"launchctl bootout {label}: {_output(p)}")


def job_info(label: str) -> dict | None:
    """Top-level fields of `launchctl print`, or None when not loaded."""
    p = launchctl("print", f"{DOMAIN}/{label}")
    if p.returncode != 0:
        if _not_found(p):
            return None
        raise Error(f"launchctl print {label}: {_output(p)}")
    info = {}
    for line in p.stdout.splitlines():
        if line.startswith("\t") and not line.startswith("\t\t"):
            key, sep, value = line.strip().partition(" = ")
            if sep:
                info.setdefault(key, value)
    return info


def labels(prefix: str) -> list[str]:
    p = launchctl("list")
    if p.returncode != 0:
        raise Error(f"launchctl list: {_output(p)}")
    found = []
    for line in p.stdout.splitlines():
        cols = line.split()
        if len(cols) == 3 and cols[2] != "Label" and cols[2].startswith(prefix):
            found.append(cols[2])
    return found


def tunnel_label(ws: str) -> str:
    return TUNNEL_PREFIX + ws


def agent_label(ws: str) -> str:
    return AGENT_PREFIX + ws


def local_socket(ws: str) -> Path:
    return STATE_DIR / f"{ws}.sock"


def job_plist(label: str) -> Path:
    # Not in ~/Library/LaunchAgents, so launchd loads them only when the
    # supervisor does.
    return JOBS_DIR / f"{label}.plist"


def job_env() -> dict:
    # ssh runs the workspaces CLI's ProxyCommand, so PATH must contain it.
    return {"LANG": "en_US.UTF-8", "PATH": os.environ.get("PATH", "/usr/bin:/bin")}


def tunnel_plist(ws: str, remote: str) -> bytes:
    """launchd listens on the local socket and starts ssh only when a client
    connects, with the connection as its stdin and stdout (inetd style)."""
    return plistlib.dumps(
        {
            "Label": tunnel_label(ws),
            "ProgramArguments": ["/usr/bin/ssh", *SSH_KEEPALIVE, "-W", remote, ssh_host(ws)],
            "EnvironmentVariables": job_env(),
            "inetdCompatibility": {"Wait": False},
            "Sockets": {"Listener": {"SockPathName": str(local_socket(ws)), "SockPathMode": 0o600}},
            "StandardErrorPath": str(STATE_DIR / f"{ws}.log"),
        }
    )


def agent_plist(ws: str) -> bytes:
    """One SSH session with agent forwarding, so terminals on the workspace
    have a live ~/.ssh/ssh_auth_sock. Tunnel connections open no session."""
    return plistlib.dumps(
        {
            "Label": agent_label(ws),
            "ProgramArguments": [
                "/usr/bin/ssh", "-T", "-o", "ForwardAgent=yes", *SSH_KEEPALIVE,
                ssh_host(ws), "exec sleep infinity",
            ],
            "EnvironmentVariables": job_env(),
            "RunAtLoad": True,
            "KeepAlive": True,
            "ThrottleInterval": 10,
            "ProcessType": "Background",
            "StandardErrorPath": str(STATE_DIR / f"{ws}.agent.log"),
        }
    )  # fmt: skip


def write_atomic(path: Path, content: bytes) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(f".{path.name}.tmp")
    tmp.write_bytes(content)
    tmp.replace(path)


# ── Rex hosts module ──────────────────────────────────────────────────────────


def render_hosts(workspaces: list[str]) -> bytes:
    # The label is the workspace name, so `rex -S <name>` works.
    lines = ["-- Generated by workspaces-rex. Do not edit."]
    for ws in sorted(workspaces):
        endpoint = "unix://" + str(local_socket(ws))
        lines.append("rex.host" + "{ label = " + json.dumps(ws) + ", endpoint = " + json.dumps(endpoint) + " }")
    return ("\n".join(lines) + "\n").encode()


def rex_reload() -> str | None:
    """Run `rex config reload`. Returns an error message, or None."""
    rex = shutil.which("rex") or (str(MAC_REX) if MAC_REX.exists() else None)
    if not rex:
        return None  # Rex for Mac reads the hosts module when it starts.
    p = subprocess.run([rex, "--autostart=false", "config", "reload"], capture_output=True, text=True, timeout=30)
    return None if p.returncode == 0 else f"rex config reload: {_output(p)}"


# ── Supervisor ────────────────────────────────────────────────────────────────


def log(msg: str) -> None:
    print(time.strftime("%Y-%m-%d %H:%M:%S"), msg, flush=True)


class Supervisor:
    def __init__(self) -> None:
        self.tunnels: dict[str, str] = {}  # workspace -> server socket path
        self.problems: dict[str, str] = {}  # last problem logged per workspace
        self.adopting = True

    def run(self) -> None:
        log(f"supervisor started (pid {os.getpid()})")
        while True:
            try:
                self.sync()
            except Error as e:
                log(str(e))
            self.sync_agents()
            self.wait(POLL_INTERVAL)

    def wait(self, interval: float) -> None:
        """Check for Rex clients until interval passes; return early after
        the Mac wakes. Wall-clock time keeps running while the Mac sleeps."""
        deadline = time.time() + interval
        while (step := min(AGENT_POLL_INTERVAL, deadline - time.time())) > 0:
            start = time.time()
            time.sleep(step)
            gap = time.time() - start
            if gap > step + WAKE_SLACK:
                log(f"wake detected after {gap:.0f}s")
                # After sleep the ssh masters hold dead connections. Closing
                # them lets launchd reconnect now, not after the keepalives.
                for ws in sorted(self.tunnels):
                    if close_master(ws):
                        log(f"wake: closed ssh master for {ws}")
                return
            self.sync_agents()

    def problem(self, ws: str, msg: str) -> None:
        if self.problems.get(ws) != msg:
            self.problems[ws] = msg
            log(f"{ws}: {msg}")

    def sync(self) -> None:
        try:
            names = running_workspaces()
        except (Error, OSError, subprocess.TimeoutExpired) as e:
            # Auth or network failure: keep the tunnels and try again later.
            raise Error(f"list workspaces: {e}") from e
        wanted = set(names)
        self.prune(wanted)
        for ws in sorted(self.tunnels):
            if ws not in wanted:
                log(f"stop {ws}: workspace is not running")
                self.stop(ws)
        for ws in names:
            self.sync_workspace(ws)
        for ws in list(self.problems):
            if ws not in wanted:
                del self.problems[ws]
        content = render_hosts(list(self.tunnels))
        if not HOSTS_FILE.exists() or HOSTS_FILE.read_bytes() != content:
            write_atomic(HOSTS_FILE, content)
            if err := rex_reload():
                log(f"{err} (is Rex running?)")

    def sync_workspace(self, ws: str) -> None:
        # The name becomes part of an SSH host, launchd labels and file paths.
        if not NAME_RE.match(ws):
            return self.problem(ws, "invalid workspace name")
        if len(str(local_socket(ws))) > MAX_SOCKET_PATH:
            return self.problem(ws, f"socket path {local_socket(ws)} is longer than macOS allows")
        try:
            remote = ensure_server(ws)
        except (Error, ValueError, OSError) as e:
            # Keep a tunnel that exists: the failure may be brief, and launchd
            # reconnects on the next connection.
            return self.problem(ws, f"check rex server: {e}")
        if remote is None:
            if ws in self.tunnels or job_plist(tunnel_label(ws)).exists():
                log(f"stop {ws}: rex server is gone")
                self.stop(ws)
            return self.problem(ws, "no rex server; run chezmoi apply on the workspace")
        if self.problems.pop(ws, None) is not None:
            log(f"{ws}: ok")
        if self.tunnels.get(ws) == remote:
            return
        try:
            self.start(ws, remote)
        except (Error, OSError) as e:
            log(f"start {ws}: {e}")
            self.stop(ws)

    def start(self, ws: str, remote: str) -> None:
        label, content = tunnel_label(ws), tunnel_plist(ws, remote)
        path = job_plist(label)
        # A previous supervisor leaves its jobs running; adopt an identical one.
        if path.exists() and path.read_bytes() == content and job_info(label) is not None:
            log(f"adopt {ws}: {local_socket(ws)} -> {remote}")
        else:
            log(f"start {ws}: {local_socket(ws)} -> {remote}")
            self.stop_jobs(ws)
            write_atomic(path, content)
            bootstrap(path)
        self.tunnels[ws] = remote

    def sync_agents(self) -> None:
        """Keep an agent holder only while a Rex client is connected. The
        holder's session stops idle auto-pause, so it must not outlive the
        last client."""
        if not self.tunnels:
            return
        try:
            tunnel_jobs, agent_jobs = labels(TUNNEL_PREFIX), labels(AGENT_PREFIX)
        except (Error, subprocess.TimeoutExpired) as e:
            return log(f"agent holders: {e}")
        connected = {m[1] for lb in tunnel_jobs if (m := CONNECTION_RE.match(lb.removeprefix(TUNNEL_PREFIX)))}
        held = {lb.removeprefix(AGENT_PREFIX) for lb in agent_jobs}
        for ws in sorted(self.tunnels):
            if ws in connected and ws not in held:
                log(f"start agent holder for {ws}: a rex client is connected")
                try:
                    write_atomic(job_plist(agent_label(ws)), agent_plist(ws))
                    bootstrap(job_plist(agent_label(ws)))
                except (Error, OSError) as e:
                    log(f"start agent holder for {ws}: {e}")
                    self.stop_agent(ws)
            elif ws not in connected and ws in held:
                log(f"stop agent holder for {ws}: no rex client is connected")
                self.stop_agent(ws)

    def stop_agent(self, ws: str) -> None:
        try:
            bootout(agent_label(ws))
        except Error as e:
            log(f"stop agent holder for {ws}: {e}")
        job_plist(agent_label(ws)).unlink(missing_ok=True)

    def prune(self, wanted: set[str]) -> None:
        """Stop jobs that a previous supervisor left for workspaces that are
        not running. Jobs of running workspaces stay, so start can adopt them."""
        found: set[str] = set()
        if JOBS_DIR.is_dir():
            for p in JOBS_DIR.glob("*.plist"):
                for prefix in (TUNNEL_PREFIX, AGENT_PREFIX):
                    if p.stem.startswith(prefix):
                        found.add(p.stem.removeprefix(prefix))
        if self.adopting:
            # Once, in case a loaded job lost its plist.
            self.adopting = False
            for prefix in (TUNNEL_PREFIX, AGENT_PREFIX):
                try:
                    found.update(
                        lb.removeprefix(prefix)
                        for lb in labels(prefix)
                        if not CONNECTION_RE.match(lb.removeprefix(prefix))
                    )
                except (Error, subprocess.TimeoutExpired) as e:
                    log(f"prune: {e}")
        for ws in sorted(found - wanted - set(self.tunnels)):
            log(f"stop {ws}: workspace is not running")
            self.stop_jobs(ws)

    def stop(self, ws: str) -> None:
        self.stop_jobs(ws)
        self.tunnels.pop(ws, None)

    def stop_jobs(self, ws: str) -> None:
        for label in (tunnel_label(ws), agent_label(ws)):
            try:
                bootout(label)
            except Error as e:
                log(f"stop {ws}: {e}")
            job_plist(label).unlink(missing_ok=True)
        # launchd leaves the socket file behind, and a stale one stops the
        # next job from listening.
        local_socket(ws).unlink(missing_ok=True)


# ── Commands ──────────────────────────────────────────────────────────────────


def cmd_status(args: argparse.Namespace) -> int:
    job = job_info(SUPERVISOR_LABEL)
    print("supervisor:")
    if job is None:
        print("  state:    not loaded (run: chezmoi apply)")
    else:
        pid = f", pid {job['pid']}" if "pid" in job else ""
        print(f"  state:    {job.get('state', '?')}{pid}")
        print(f"  runs:     {job.get('runs', '?')}, last exit {job.get('last exit code', '?')}")
    print(f"  log:      {SUPERVISOR_LOG}")
    rows: dict[str, dict] = {}
    for lb in labels(TUNNEL_PREFIX):
        name = lb.removeprefix(TUNNEL_PREFIX)
        if m := CONNECTION_RE.match(name):
            row = rows.setdefault(m[1], {})
            row["connections"] = row.get("connections", 0) + 1
        else:
            rows.setdefault(name, {})["listening"] = True
    for lb in labels(AGENT_PREFIX):
        rows.setdefault(lb.removeprefix(AGENT_PREFIX), {})["agent"] = True
    print()
    if not rows:
        print("No tunnels. Running workspaces get one within a minute of the supervisor starting.")
        return 0
    table = [("WORKSPACE", "REX SOCKET", "SSH AGENT", "CONNECTIONS", "SOCKET")]
    for ws in sorted(rows):
        r = rows[ws]
        table.append(
            (
                ws,
                "listening" if r.get("listening") else "missing",
                "forwarded" if r.get("agent") else "idle",
                str(r.get("connections", 0)),
                str(local_socket(ws)),
            )
        )
    widths = [max(len(row[i]) for row in table) for i in range(4)]
    for row in table:
        print("  ".join(c.ljust(w) for c, w in zip(row[:4], widths, strict=True)) + "  " + row[4])
    print(
        "\nTo add a workspace to Rex for Mac: Settings > Remote Hosts, then add a remote host"
        "\nwhose address is the full path of its socket."
    )
    return 0


def cmd_supervise(args: argparse.Namespace) -> int:
    JOBS_DIR.mkdir(parents=True, exist_ok=True)
    Supervisor().run()
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(
        prog="workspaces-rex", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    sub = parser.add_subparsers(dest="cmd", required=True)
    sub.add_parser("status", help="supervisor and local sockets").set_defaults(func=cmd_status)
    sub.add_parser("supervise", help="run the supervisor (the LaunchAgent runs this)").set_defaults(func=cmd_supervise)
    args = parser.parse_args()
    try:
        return args.func(args)
    except Error as e:
        print(f"workspaces-rex: {e}", file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    sys.exit(main())
