#!/usr/bin/env bash
# Shim: finds and runs the real `pi` binary, then cleans up on exit.

# Strip this shim's directory from PATH so `command -v` finds the real binary.
_shim_dir="$(cd "$(dirname "$0")" && pwd)"
_clean_path="$(printf '%s' "$PATH" | tr ':' '\n' | grep -vxF "$_shim_dir" | tr '\n' ':' | sed 's/:$//')"
_real="$(PATH="$_clean_path" command -v pi 2>/dev/null)"

if [[ -z "$_real" ]]; then
  echo "pi shim: could not locate real pi binary" >&2
  exit 1
fi

_is_interactive_pi() {
  # Only reset the terminal after Pi's full-screen TUI exits.
  # Non-interactive invocations like `pi update`, `pi -p`, `pi --mode json`,
  # `pi --export`, `pi --help`, etc. should leave terminal output intact.
  [[ -t 0 && -t 1 ]] || return 1

  local arg
  local first_nonflag=""
  local expect_value_for=""

  for arg in "$@"; do
    if [[ -n "$expect_value_for" ]]; then
      expect_value_for=""
      continue
    fi

    case "$arg" in
      --mode|--export|--session|--fork|--provider|--model|--api-key|--thinking|--models|--session-dir)
        expect_value_for="$arg"
        ;;
      -p|--print|--mode=*|--export|--export=*|--list-models|--list-models=*|-h|--help|-v|--version)
        return 1
        ;;
      install|remove|uninstall|update|list|config)
        return 1
        ;;
      --)
        break
        ;;
      -*)
        ;;
      *)
        if [[ -z "$first_nonflag" ]]; then
          first_nonflag="$arg"
        fi
        ;;
    esac
  done

  case "$first_nonflag" in
    install|remove|uninstall|update|list|config)
      return 1
      ;;
  esac

  return 0
}

_should_reset_terminal=0
if _is_interactive_pi "$@"; then
  _should_reset_terminal=1
fi

unset AWS_PROFILE
"$_real" "$@"
_exit=$?

# Restore tmux window name (strip leading emoji prefix set by pi/claude hooks).
if [[ -n "${TMUX:-}" ]]; then
  _pane="${TMUX_PANE}"
  _current="$(tmux display-message -p -t "$_pane" '#W' 2>/dev/null)"
  _base="$(printf '%s' "$_current" | sed -E 's/^([🤖✳️🛎️ ])+//')"
  tmux rename-window -t "$_pane" "$_base"
  tmux set-option -w -t "$_pane" automatic-rename off
fi

if [[ "$_should_reset_terminal" -eq 1 ]]; then
  tput reset
fi

exit "$_exit"
