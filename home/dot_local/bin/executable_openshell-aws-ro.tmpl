{{- if and (eq .chezmoi.os "darwin") (eq .chezmoi.arch "arm64") (not .headless) -}}
#!/bin/bash
# Sync the host's active AWS SSO access token into OpenShell provider `aws-sso-ro`
# (which restricts portal.sso.* strictly to role_name=read-only) and generate a
# read-only-only AWS config file for sandboxes.

set -eufo pipefail

START_URL="${AWS_SSO_START_URL:-https://d-906757b57c.awsapps.com/start}"
PROVIDER="${1:-aws-sso-ro}"
PROFILE_YAML="${XDG_CONFIG_HOME:-${HOME}/.config}/openshell/profiles/aws-sso-ro.yaml"
STATE_DIR="${XDG_STATE_HOME:-${HOME}/.local/state}/openshell"
RO_AWS_CONFIG="${STATE_DIR}/aws-ro-config"

mkdir -p "${STATE_DIR}"

# Import the aws-sso-ro provider profile on the local gateway if not already present.
if ! openshell provider list-profiles 2>/dev/null | grep -Eq '^[[:space:]]*aws-sso-ro[[:space:]]'; then
  openshell provider profile import -f "${PROFILE_YAML}" --global >/dev/null
fi

# Extract the newest non-expired SSO accessToken for START_URL from ~/.aws/sso/cache.
# Keep the token out of argv and temp files by reading it via stdin/env.
sso_meta="$(python3 - "${START_URL}" <<'PY'
import datetime, glob, json, os, sys

start_url = sys.argv[1]
now = datetime.datetime.now(datetime.timezone.utc)
best = None

for path in glob.glob(os.path.expanduser("~/.aws/sso/cache/*.json")):
    try:
        with open(path) as f:
            data = json.load(f)
    except Exception:
        continue
    if data.get("startUrl") != start_url or "accessToken" not in data or "expiresAt" not in data:
        continue
    exp_str = data["expiresAt"].replace("Z", "+00:00")
    try:
        exp = datetime.datetime.fromisoformat(exp_str)
    except ValueError:
        continue
    if exp <= now:
        continue
    if best is None or exp > best[0]:
        best = (exp, data["expiresAt"], data["accessToken"])

if best is None:
    sys.exit(1)

print(best[1])
print(best[2])
PY
)" || {
  echo "openshell-aws-ro: no active SSO token for ${START_URL} (run: aws sso login --profile <any-sso-read-only-profile>)" >&2
  exit 1
}

EXPIRES_AT="$(printf '%s\n' "${sso_meta}" | sed -n '1p')"
AWS_SSO_ACCESS_TOKEN="$(printf '%s\n' "${sso_meta}" | sed -n '2p')"
export AWS_SSO_ACCESS_TOKEN
unset sso_meta

if openshell provider get "${PROVIDER}" >/dev/null 2>&1; then
  openshell provider update "${PROVIDER}" \
    --credential AWS_SSO_ACCESS_TOKEN \
    --credential-expires-at "AWS_SSO_ACCESS_TOKEN=${EXPIRES_AT}" >/dev/null
else
  openshell provider create \
    --name "${PROVIDER}" \
    --type aws-sso-ro \
    --credential AWS_SSO_ACCESS_TOKEN >/dev/null
  openshell provider update "${PROVIDER}" \
    --credential AWS_SSO_ACCESS_TOKEN \
    --credential-expires-at "AWS_SSO_ACCESS_TOKEN=${EXPIRES_AT}" >/dev/null
fi

# Filter ~/.aws/config down to read-only profiles only.
# Emit both `sso-<name>-read-only` and `exec-sso-<name>-read-only` pointing
# directly at SSO (without aws-vault credential_process) so Terragrunt/OpenTofu
# units referencing `exec-sso-*-read-only` work inside Linux VM sandboxes.
python3 - "${RO_AWS_CONFIG}" <<'PY'
import configparser, os, sys

out_path = sys.argv[1]
src_path = os.path.expanduser(os.environ.get("AWS_CONFIG_FILE", "~/.aws/config"))
if not os.path.exists(src_path):
    sys.exit(0)

cp = configparser.ConfigParser()
cp.read(src_path)
out = configparser.ConfigParser()
count = 0
for sec in cp.sections():
    if sec.startswith("profile sso-") and sec.endswith("-read-only") and cp.get(sec, "sso_role_name", fallback="") == "read-only":
        out[sec] = cp[sec]
        exec_sec = "profile exec-" + sec[len("profile "):]
        out[exec_sec] = cp[sec]
        count += 1

with open(out_path, "w") as f:
    out.write(f)
os.chmod(out_path, 0o600)
print(f"Wrote {count} read-only accounts ({count * 2} profiles: sso-* + exec-sso-*) to {out_path}")
PY

echo "Synced AWS SSO token to OpenShell provider '${PROVIDER}' (expires ${EXPIRES_AT})."
echo "Run: openshell sandbox create --no-keep --provider ${PROVIDER} --policy ~/.config/openshell/policies/aws-ro.yaml -- <cmd>"
{{- end }}
