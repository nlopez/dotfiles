#!/usr/bin/env python3
"""Refuse agent shell commands that delete files permanently.

Used as a Claude Code PreToolUse hook (Bash matcher) and by the pi extension
rm-guard.ts; hook I/O in agent_guard.py.

Blocks `rm` as a command word and `find -delete`; `git rm` is allowed.
Heredoc bodies and commit/PR message arguments are ignored.
"""

import os
import re
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import agent_guard  # noqa: E402

REASON = (
    "Blocked: rm and find -delete delete permanently. Run `trash <path>...` "
    "instead; it moves files to the system trash. Do not pass flags such as -rf."
)

# A command word starts after a separator, a subshell opener, or a wrapper.
WRAPPER = r"(?:sudo|xargs|exec|command|time|env|nohup)(?:\s+-\w+(?:\s+[^-\s]\S*)?)*"  # with options: sudo -u bob
START = r"(?:^|[;&|(){`\n]|\$\(|\b(?:" + WRAPPER + r"|then|do|else)\s)\s*"
RM = re.compile(START + r"\\?(?:/(?:usr/)?bin/)?rm(?=\s|$)")
EXEC_RM = re.compile(r"-exec(?:dir)?\s+\\?(?:/(?:usr/)?bin/)?rm(?=\s|$)")
FIND_DELETE = re.compile(r"\bfind\b[^;&|\n]*\s-delete\b")


def blocked(text: str) -> bool:
    return any(p.search(text) for p in (RM, EXEC_RM, FIND_DELETE))


if __name__ == "__main__":
    agent_guard.run(blocked, REASON)
