#!/usr/bin/env python3
"""Convert an existing git working directory to fetch from gitcache mirrors.

For each remote, the fetch URL is repointed to the local gitcache mirror
(creating it if needed) and the push URL is set to the original remote URL.

Usage: git-use-gitcache [--dry-run] [--revert] [<repo-dir>]

  --dry-run   Print what would be done without making any changes.
  --revert    Undo a previous conversion: restore upstream fetch URLs and
              remove the explicit push URL that gitcache conversion set.
"""

import argparse
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path


def git(*args, repo_dir: Path, check: bool = True) -> str:
    result = subprocess.run(
        ["git", "-C", str(repo_dir), *args],
        capture_output=True,
        text=True,
    )
    if check and result.returncode != 0:
        raise subprocess.CalledProcessError(result.returncode, result.args, result.stdout, result.stderr)
    return result.stdout.strip()


def run(cmd: list[str], *, dry_run: bool) -> None:
    print("  + " + " ".join(cmd))
    if not dry_run:
        subprocess.run(cmd, check=True)


def normalize_url(url: str) -> str:
    """Strip a leading file:// scheme so the path can be treated as absolute."""
    return url.removeprefix("file://")


def is_gitcache_mirror(url: str) -> bool:
    """Return True if url points at a gitcache mirror regardless of GITCACHE_DIR."""
    url = normalize_url(url)
    return url.startswith("/") and "/mirrors/" in url and url.endswith("/git")


def parse_url(url: str) -> str:
    """Return '<host>/<path>' from a remote URL (no trailing .git)."""
    # https://, ssh://, git://
    m = re.match(r'^(?:https?|git|ssh)://(?:[^/@]+@)?([^/]+)/(.+)$', url)
    if m:
        host, path = m.group(1), m.group(2)
    else:
        # SCP-style: git@host:org/repo.git
        m = re.match(r'^(?:[^@]+@)?([^:]+):(.+)$', url)
        if not m:
            raise ValueError(f"cannot parse URL: {url}")
        host, path = m.group(1), m.group(2)

    path = path.lstrip("/").removesuffix(".git")
    return f"{host}/{path}"


def mirror_path_for_url(url: str, gitcache_dir: Path) -> Path:
    return gitcache_dir / "mirrors" / parse_url(url) / "git"


def resolve_gitcache_dir() -> Path:
    if "GITCACHE_DIR" in os.environ:
        return Path(os.environ["GITCACHE_DIR"])

    gitcache_bin = shutil.which("gitcache")
    if gitcache_bin:
        result = subprocess.run([gitcache_bin], capture_output=True, text=True)
        for line in result.stdout.splitlines():
            if "GITCACHE_DIR" in line:
                parts = line.split()
                if len(parts) >= 3:
                    return Path(parts[2])

    return Path.home() / ".cache" / "gitcache"


def resolve_real_git() -> str:
    return os.environ.get("GITCACHE_REAL_GIT") or shutil.which("git") or "git"


def ensure_mirror(url: str, mirror: Path, real_git: str, *, dry_run: bool) -> None:
    if mirror.is_dir():
        print(f"  mirror already exists: {mirror}")
        return
    print(f"  creating mirror: {mirror}")
    if not dry_run:
        mirror.parent.mkdir(parents=True, exist_ok=True)
    run([real_git, "clone", "--mirror", url, str(mirror)], dry_run=dry_run)


def cmd_convert(repo_dir: Path, gitcache_dir: Path, real_git: str, *, dry_run: bool) -> None:
    remotes = git("remote", repo_dir=repo_dir).splitlines()
    if not remotes:
        print("No remotes found.")
        return

    for remote in remotes:
        raw_url = git("remote", "get-url", remote, repo_dir=repo_dir, check=False)
        if not raw_url:
            print(f"[{remote}] skipping — could not read URL")
            continue

        current_url = normalize_url(raw_url)

        if is_gitcache_mirror(current_url):
            print(f"[{remote}] already uses gitcache mirror: {current_url}")
            continue

        mirror = mirror_path_for_url(current_url, gitcache_dir)
        raw_push = git("remote", "get-url", "--push", remote, repo_dir=repo_dir, check=False)
        push_url = normalize_url(raw_push or current_url)

        print(f"[{remote}]")
        print(f"  upstream url : {current_url}")
        print(f"  mirror path  : {mirror}")

        ensure_mirror(current_url, mirror, real_git, dry_run=dry_run)
        run(["git", "-C", str(repo_dir), "remote", "set-url", remote, str(mirror)], dry_run=dry_run)

        if is_gitcache_mirror(push_url):
            run(["git", "-C", str(repo_dir), "remote", "set-url", "--push", remote, current_url], dry_run=dry_run)
            print(f"  push url reset to upstream: {current_url}")
        elif push_url != current_url:
            print(f"  push url unchanged (was already customised): {push_url}")
        else:
            run(["git", "-C", str(repo_dir), "remote", "set-url", "--push", remote, current_url], dry_run=dry_run)
            print(f"  push url set to upstream: {current_url}")

        print("  done.")
        print()

    if dry_run:
        print("Dry run complete — no changes made.")
    else:
        print(f"Conversion complete. Verify with: git -C '{repo_dir}' remote -v")


def cmd_revert(repo_dir: Path, *, dry_run: bool) -> None:
    remotes = git("remote", repo_dir=repo_dir).splitlines()
    if not remotes:
        print("No remotes found.")
        return

    for remote in remotes:
        raw_fetch = git("remote", "get-url", remote, repo_dir=repo_dir, check=False)
        if not raw_fetch:
            print(f"[{remote}] skipping — could not read URL")
            continue

        fetch_url = normalize_url(raw_fetch)
        raw_push = git("remote", "get-url", "--push", remote, repo_dir=repo_dir, check=False)
        push_url = normalize_url(raw_push or "")

        if not is_gitcache_mirror(fetch_url):
            print(f"[{remote}] not using a gitcache mirror, nothing to revert (fetch: {fetch_url})")
            continue

        if fetch_url == push_url or is_gitcache_mirror(push_url):
            print(f"[{remote}] error: push URL is also a mirror ({push_url}); cannot determine upstream", file=sys.stderr)
            print(f"         Set the upstream URL manually with: git remote set-url {remote} <upstream>")
            continue

        print(f"[{remote}]")
        print(f"  mirror (current fetch) : {fetch_url}")
        print(f"  upstream (current push): {push_url}")
        run(["git", "-C", str(repo_dir), "remote", "set-url", remote, push_url], dry_run=dry_run)
        run(["git", "-C", str(repo_dir), "remote", "set-url", "--delete", "--push", remote, push_url], dry_run=dry_run)
        print("  done.")
        print()

    if dry_run:
        print("Dry run complete — no changes made.")
    else:
        print(f"Revert complete. Verify with: git -C '{repo_dir}' remote -v")


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--dry-run", action="store_true", help="print actions without executing them")
    parser.add_argument("--revert", action="store_true", help="restore upstream URLs, undoing a previous conversion")
    parser.add_argument("repo_dir", nargs="?", default=".", metavar="repo-dir")
    args = parser.parse_args()

    repo_dir = Path(args.repo_dir).resolve()

    try:
        git("rev-parse", "--git-dir", repo_dir=repo_dir)
    except subprocess.CalledProcessError:
        sys.exit(f"error: '{repo_dir}' is not a git repository")

    if not shutil.which("gitcache"):
        sys.exit("error: gitcache not found in PATH")

    mode_label = "Reverting" if args.revert else "Converting"
    if args.dry_run:
        mode_label += " (dry run)"

    print(f"{mode_label} remotes in: {repo_dir}")

    if args.revert:
        print()
        cmd_revert(repo_dir, dry_run=args.dry_run)
    else:
        gitcache_dir = resolve_gitcache_dir()
        real_git = resolve_real_git()
        print(f"gitcache dir: {gitcache_dir}")
        print()
        cmd_convert(repo_dir, gitcache_dir, real_git, dry_run=args.dry_run)


if __name__ == "__main__":
    main()
