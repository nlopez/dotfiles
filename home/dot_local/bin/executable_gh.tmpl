#!/bin/bash
# gh shim: auto-select GH_CONFIG_DIR for ddoghq remotes, inject the effective
# branch during rebases.

# Find the real gh: the first `gh` on PATH that is not this shim. Works with
# any install method (mise, brew, apt, ...), whatever order PATH is in, and
# regardless of where the shim is installed (-ef compares inode, so symlinks
# and relative PATH entries are handled).
REAL_GH=
IFS=: read -ra _path_dirs <<< "$PATH"
for _dir in "${_path_dirs[@]}"; do
  _cand="${_dir:-.}/gh"
  if [[ -f "$_cand" && -x "$_cand" && ! "$_cand" -ef "${BASH_SOURCE[0]}" ]]; then
    REAL_GH=$_cand
    break
  fi
done
unset _path_dirs _dir _cand
[[ -n "$REAL_GH" ]] || { echo "gh shim: real gh not found on PATH" >&2; exit 127; }

# --- GH_CONFIG_DIR routing ---
# CLI args take priority over the git remote of the cwd.  Extract the org from:
#   --repo / -R  ORG/REPO   (any subcommand)
#   gh api /repos/ORG/REPO  or  /orgs/ORG   (api subcommand URL path)
_gh_detect_org() {
  local i
  for (( i=1; i<=$#; i++ )); do
    case "${!i}" in
      --repo=*|-R=*)
        local val="${!i#*=}"
        printf '%s' "${val%%/*}"; return ;;
      --repo|-R)
        (( i++ ))
        printf '%s' "${!i%%/*}"; return ;;
    esac
  done
  # For 'gh api <endpoint>', parse the URL path argument
  if [[ "$1" == "api" ]]; then
    for (( i=2; i<=$#; i++ )); do
      [[ "${!i}" == -* ]] && continue
      local path="${!i#/}"          # strip optional leading slash
      case "$path" in
        repos/*/*)
          local rest="${path#*/}"   # strip 'repos/'
          printf '%s' "${rest%%/*}" # org component
          ;;
        orgs/*)
          local rest="${path#*/}"   # strip 'orgs/'
          printf '%s' "${rest%%/*}" # org component
          ;;
      esac
      break  # first non-flag arg is the endpoint; stop
    done
  fi
}
_cli_org=$(_gh_detect_org "$@")
if [[ -n "$_cli_org" ]]; then
  # Explicit org on CLI wins over git remote
  if [[ "$_cli_org" =~ ^[Dd][Dd]oghq$ ]]; then
    export GH_CONFIG_DIR="$HOME/.config/gh-ddog"
  fi
  # else: DataDog or any other org → leave GH_CONFIG_DIR unset (default config)
elif git remote -v 2>/dev/null | grep -qi 'github\.com[:/][Dd][Dd]oghq/'; then
  export GH_CONFIG_DIR="$HOME/.config/gh-ddog"
fi
unset _cli_org

# --- Rebase branch injection ---
# During `git rebase -i` HEAD is detached and gh cannot determine the current
# branch. Read the per-worktree rebase state file and inject the branch as a
# positional arg for pr sub-commands that need it.
_gh_effective_branch() {
  local branch git_dir state_dir
  branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null)
  if [[ -z "$branch" ]]; then
    git_dir=$(git rev-parse --git-dir 2>/dev/null)
    for state_dir in rebase-merge rebase-apply; do
      if [[ -f "$git_dir/$state_dir/head-name" ]]; then
        branch=$(< "$git_dir/$state_dir/head-name")
        branch=${branch#refs/heads/}
        break
      fi
    done
  fi
  printf '%s' "$branch"
}

if [[ "$1" == "pr" && $# -ge 2 ]]; then
  case "$2" in
    view|merge|diff|ready|close|reopen|comment|checks|review|edit)
      # Only inject when no PR identifier is present yet (an identifier
      # would be a 3rd arg that doesn't start with -) and HEAD is detached.
      if [[ $# -lt 3 || "${3:0:1}" == "-" ]] && \
         ! git symbolic-ref --quiet HEAD &>/dev/null; then
        _branch=$(_gh_effective_branch)
        [[ -n "$_branch" ]] && set -- "$1" "$2" "$_branch" "${@:3}"
      fi
      ;;
  esac
fi

exec "$REAL_GH" "$@"
