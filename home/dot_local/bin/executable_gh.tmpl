#!/bin/bash
# gh shim: auto-select GH_CONFIG_DIR for ddoghq remotes, inject the effective
# branch during rebases, and append a Pi co-authorship footer to --body /
# --body-file on PR/issue write commands.
# Keep in sync with gh-attribution.ts (covers non-shell contexts).

{{- if eq .chezmoi.os "darwin" }}
REAL_GH={{ if eq .chezmoi.arch "arm64" }}/opt/homebrew/bin/gh{{ else }}/usr/local/bin/gh{{ end }}
{{- else }}
# Linux: gh is installed out-of-band (apt/dnf/manual), not via chezmoi. Resolve
# the real binary at runtime, skipping this shim's own location in PATH.
REAL_GH=$(command -v -a gh | grep -vF "$HOME/.local/bin/gh" | head -n1)
{{- end }}

# --- GH_CONFIG_DIR routing ---
if git remote -v 2>/dev/null | grep -qi 'github\.com[:/][Dd][Dd]oghq/'; then
  export GH_CONFIG_DIR="$HOME/.config/gh-ddog"
fi

# --- Rebase branch injection ---
# During `git rebase -i` HEAD is detached and gh cannot determine the current
# branch. Read the per-worktree rebase state file and inject the branch as a
# positional arg for pr sub-commands that need it.
_gh_effective_branch() {
  local branch git_dir state_dir
  branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null)
  if [[ -z "$branch" ]]; then
    git_dir=$(git rev-parse --git-dir 2>/dev/null)
    for state_dir in rebase-merge rebase-apply; do
      if [[ -f "$git_dir/$state_dir/head-name" ]]; then
        branch=$(< "$git_dir/$state_dir/head-name")
        branch=${branch#refs/heads/}
        break
      fi
    done
  fi
  printf '%s' "$branch"
}

if [[ "$1" == "pr" && $# -ge 2 ]]; then
  case "$2" in
    view|merge|diff|ready|close|reopen|comment|checks|review|edit)
      # Only inject when no PR identifier is present yet (an identifier
      # would be a 3rd arg that doesn't start with -) and HEAD is detached.
      if [[ $# -lt 3 || "${3:0:1}" == "-" ]] && \
         ! git symbolic-ref --quiet HEAD &>/dev/null; then
        _branch=$(_gh_effective_branch)
        [[ -n "$_branch" ]] && set -- "$1" "$2" "$_branch" "${@:3}"
      fi
      ;;
  esac
fi

# --- Pi co-authorship footer ---
# Intercept: gh {pr,issue} {create,edit,comment,review} when --body/--body-file is given.
if [[ $# -ge 2 ]]; then
  case "$1 $2" in
    "issue comment"|"issue create"|"issue edit"|\
    "pr comment"|"pr review"|"pr edit"|"pr create")
      args=("$@")
      newargs=()
      i=0
      modified=0
      while (( i < ${#args[@]} )); do
        if [[ "${args[$i]}" == "--body" ]] && (( i + 1 < ${#args[@]} )); then
          body="${args[$((i+1))]}"
          if [[ "$body" != *"Co-authored with [Pi]"* ]]; then
            pi_name=$(pi-model-name 2>/dev/null)
            footer=$'\n\n---\n'"*Co-authored with [Pi](https://pi.dev)${pi_name:+ (${pi_name})}*"
            body="${body}${footer}"
            modified=1
          fi
          newargs+=("--body" "$body")
          (( i += 2 ))
        else
          newargs+=("${args[$i]}")
          (( i++ ))
        fi
      done

      # --body-file <path>: append footer to the file in-place, keep args unchanged.
      if (( ! modified )); then
        j=0
        while (( j < ${#args[@]} )); do
          if [[ "${args[$j]}" == "--body-file" ]] && (( j + 1 < ${#args[@]} )); then
            bf_path="${args[$((j+1))]}"
            if [[ "$bf_path" != "-" && -f "$bf_path" ]]; then
              bf_content=$(cat "$bf_path")
              if [[ "$bf_content" != *"Co-authored with [Pi]"* ]]; then
                pi_name=$(pi-model-name 2>/dev/null)
                footer=$'\n\n---\n'"*Co-authored with [Pi](https://pi.dev)${pi_name:+ (${pi_name})}*"
                printf '%s%s' "$bf_content" "$footer" > "$bf_path"
                modified=1
              fi
            fi
            break
          fi
          (( j++ ))
        done
      fi

      (( modified )) && exec "$REAL_GH" "${newargs[@]}"
      ;;
  esac
fi

exec "$REAL_GH" "$@"
