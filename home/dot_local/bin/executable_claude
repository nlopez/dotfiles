#!/usr/bin/env bash
# Shim: finds and runs the real `claude` binary, then cleans up on exit.
# Mirrors the pi shim: clears @pi-status and resets the terminal after
# interactive TUI sessions. Handles crashes and SIGKILL that bypass SessionEnd.

# Strip this shim's directory from PATH so `command -v` finds the real binary.
_shim_dir="$(cd "$(dirname "$0")" && pwd)"
_clean_path="$(printf '%s' "$PATH" | tr ':' '\n' | grep -vxF "$_shim_dir" | tr '\n' ':' | sed 's/:$//')"
_real="$(PATH="$_clean_path" command -v claude 2>/dev/null)"

if [[ -z "$_real" ]]; then
  echo "claude shim: could not locate real claude binary" >&2
  exit 1
fi

_is_interactive_claude() {
  # Only reset the terminal after Claude's full-screen TUI exits.
  # Non-interactive modes (-p, --version, --help, --init-only) leave output intact.
  [[ -t 0 && -t 1 ]] || return 1

  local arg expect_value=""
  for arg in "$@"; do
    if [[ -n "$expect_value" ]]; then
      expect_value=""
      continue
    fi
    case "$arg" in
      --output-format|--permission-mode)
        expect_value="$arg"
        ;;
      -p|--print|--output-format=*|-v|--version|-h|--help|--init-only)
        return 1
        ;;
    esac
  done
  return 0
}

_should_reset_terminal=0
if _is_interactive_claude "$@"; then
  _should_reset_terminal=1
fi

"$_real" "$@"
_exit=$?

# Clear @pi-status on the tmux window after Claude exits.
# SessionEnd hook handles clean exits; this catches crashes and SIGKILL.
if [[ -n "${TMUX:-}" && -n "${TMUX_PANE:-}" ]]; then
  tmux set-option -wu -t "${TMUX_PANE}" @pi-status 2>/dev/null || true
fi

if [[ "$_should_reset_terminal" -eq 1 ]]; then
  tput reset
fi

exit "$_exit"
