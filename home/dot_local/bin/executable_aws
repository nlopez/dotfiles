#!/usr/bin/env bash
# aws — chezmoi-managed shim for the AWS CLI.
#
# Sits at ~/.local/bin/aws (ahead of the real aws in PATH) and transparently
# proxies every invocation to the real binary. The one extra thing it does:
#
#   1. Detect the active AWS profile from $AWS_PROFILE or a --profile flag.
#   2. If a profile is set, run the real command directly.
#   3. If the command fails with an auth error, run `aws sso login` and retry once.
#   4. If no profile is detected, just pass through with no SSO logic.
#
# This avoids the double-network-call problem of a preflight `sts get-caller-identity`
# followed by the real command — auth is checked lazily on actual failure.

# ---------------------------------------------------------------------------
# Locate the real aws binary — the first `aws` found in PATH entries that
# come *after* ~/.local/bin, so this shim can't call itself recursively.
# ---------------------------------------------------------------------------
_real_aws() {
  local skip=true
  local dir
  while IFS= read -r dir; do
    if [[ "$skip" == true ]]; then
      [[ "$dir" == "$HOME/.local/bin" ]] && skip=false
      continue
    fi
    if [[ -x "$dir/aws" ]]; then
      echo "$dir/aws"
      return 0
    fi
  done < <(echo "$PATH" | tr ':' '\n')
  return 1
}

AWS_BIN="$(_real_aws)" || {
  echo "aws shim: could not locate the real aws binary in PATH (past ~/.local/bin)" >&2
  exit 127
}

# ---------------------------------------------------------------------------
# Detect the active profile.
# Priority: --profile <value> flag in args  >  $AWS_PROFILE env var.
# ---------------------------------------------------------------------------
_detect_profile() {
  local arg
  local prev=""
  for arg in "$@"; do
    if [[ "$prev" == "--profile" ]]; then
      echo "$arg"
      return 0
    fi
    prev="$arg"
  done

  for arg in "$@"; do
    if [[ "$arg" == --profile=* ]]; then
      echo "${arg#--profile=}"
      return 0
    fi
  done

  if [[ -n "${AWS_PROFILE:-}" ]]; then
    echo "$AWS_PROFILE"
    return 0
  fi

  return 1
}

# ---------------------------------------------------------------------------
# Check whether a command's stderr output looks like an SSO auth failure.
# ---------------------------------------------------------------------------
_is_auth_error() {
  grep -qiE 'token has expired|sso session|not authorized|InvalidClientTokenId|ExpiredToken|AuthorizationError|SSOTokenProviderFailure' <<< "$1"
}

# ---------------------------------------------------------------------------
# Main logic
# ---------------------------------------------------------------------------
PROFILE="$(_detect_profile "$@")" || PROFILE=""

if [[ -z "$PROFILE" ]]; then
  # No profile — just run transparently.
  exec "$AWS_BIN" "$@"
fi

# Run the real command, capturing stderr to a temp file so we can inspect it
# for auth errors while leaving stdout fully intact (TTY, streaming, etc.).
stderr_tmp=$(mktemp)
trap 'rm -f "$stderr_tmp"' EXIT
"$AWS_BIN" "$@" 2>"$stderr_tmp"
exit_code=$?
stderr_out=$(cat "$stderr_tmp")
# Replay stderr to the caller.
printf '%s' "$stderr_out" >&2

if [[ $exit_code -ne 0 ]] && _is_auth_error "$stderr_out"; then
  echo "aws shim: SSO session for profile '$PROFILE' is expired; logging in..." >&2
  if "$AWS_BIN" sso login --profile "$PROFILE"; then
    # Retry the original command after successful login.
    exec "$AWS_BIN" "$@"
  else
    echo "aws shim: SSO login failed for profile '$PROFILE'" >&2
    exit $exit_code
  fi
fi

exit $exit_code
