#!/usr/bin/env bash
# aws — chezmoi-managed shim for the AWS CLI.
#
# Sits at ~/.local/bin/aws (ahead of the real aws in PATH) and transparently
# proxies every invocation to the real binary. The one extra thing it does:
#
#   1. Detect the active AWS profile from $AWS_PROFILE or a --profile flag.
#   2. If a profile is found, silently test the session with sts get-caller-identity.
#   3. If the session is expired/invalid, run `aws sso login` before continuing.
#   4. Always forward the original arguments verbatim to the real aws binary.
#   5. If no profile is detected, skip all SSO logic entirely.
#   6. If SSO login fails, still attempt the original command (errors are not swallowed).

# ---------------------------------------------------------------------------
# Locate the real aws binary — the first `aws` found in PATH entries that
# come *after* ~/.local/bin, so this shim can't call itself recursively.
# ---------------------------------------------------------------------------
_real_aws() {
  local skip=true
  local dir
  while IFS= read -r dir; do
    if [[ "$skip" == true ]]; then
      [[ "$dir" == "$HOME/.local/bin" ]] && skip=false
      continue
    fi
    if [[ -x "$dir/aws" ]]; then
      echo "$dir/aws"
      return 0
    fi
  done < <(echo "$PATH" | tr ':' '\n')
  return 1
}

AWS_BIN="$(_real_aws)" || {
  echo "aws shim: could not locate the real aws binary in PATH (past ~/.local/bin)" >&2
  exit 127
}

# ---------------------------------------------------------------------------
# Detect the active profile.
# Priority: --profile <value> flag in args  >  $AWS_PROFILE env var.
# ---------------------------------------------------------------------------
_detect_profile() {
  local arg
  local prev=""
  for arg in "$@"; do
    if [[ "$prev" == "--profile" ]]; then
      echo "$arg"
      return 0
    fi
    prev="$arg"
  done

  # Also handle --profile=value form
  for arg in "$@"; do
    if [[ "$arg" == --profile=* ]]; then
      echo "${arg#--profile=}"
      return 0
    fi
  done

  # Fall back to the environment variable
  if [[ -n "${AWS_PROFILE:-}" ]]; then
    echo "$AWS_PROFILE"
    return 0
  fi

  return 1  # no profile detected
}

# ---------------------------------------------------------------------------
# Main logic
# ---------------------------------------------------------------------------
PROFILE="$(_detect_profile "$@")" || PROFILE=""

if [[ -n "$PROFILE" ]]; then
  # Test whether the current SSO session is still valid (suppress all output).
  if ! "$AWS_BIN" sts get-caller-identity --profile "$PROFILE" \
        --output text >/dev/null 2>&1; then
    # Session is expired or invalid — attempt an SSO login.
    echo "aws shim: SSO session for profile '$PROFILE' is expired; logging in..." >&2
    if ! "$AWS_BIN" sso login --profile "$PROFILE"; then
      # Login failed — warn but do not abort; let the original command surface
      # its own error so the caller sees the real failure.
      echo "aws shim: SSO login failed for profile '$PROFILE'; attempting command anyway..." >&2
    fi
  fi
fi

# Forward all original arguments to the real aws binary.
exec "$AWS_BIN" "$@"
