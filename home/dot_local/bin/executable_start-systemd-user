#!/usr/bin/env bash
# Workspaces: start the system D-Bus, systemd-logind, and a systemd --user
# manager. PID 1 is s6, so nothing else starts them. logind cannot create
# sessions or start user@.service without systemd as PID 1, so this script does
# what pam_systemd would: the runtime dir, a delegated cgroup, and the manager.
# logind still serves loginctl and records lingering.
# ~/.config/shell/env runs this on the first shell after container start.
set -euo pipefail

uid=$(id -u)
gid=$(id -g)
user=$(id -un)
export XDG_RUNTIME_DIR=/run/user/$uid

alive() { [ -r "$1" ] && sudo -n kill -0 "$(cat "$1")" 2>/dev/null; }

# systemd --user and logind refuse to start unless sd_booted() sees this.
sudo -n mkdir -p /run/systemd/system

if ! alive /run/dbus/pid; then
  sudo -n rm -f /run/dbus/pid /run/dbus/system_bus_socket
  sudo -n dbus-daemon --system --fork
fi

sudo -n install -d /var/lib/systemd/linger
sudo -n touch "/var/lib/systemd/linger/$user"
if ! alive /run/systemd-logind.pid; then
  # One started before the pidfile existed would hold the logind bus name.
  sudo -n pkill -x systemd-logind || true
  # A background job is not a process group leader, so setsid execs in place
  # and $! is logind's PID.
  sudo -n sh -c 'setsid /usr/lib/systemd/systemd-logind >/run/systemd-logind.log 2>&1 </dev/null &
    echo $! >/run/systemd-logind.pid'
fi

systemctl --user is-system-running >/dev/null 2>&1 && exit 0

cg=/sys/fs/cgroup/user.slice/user-$uid.slice/user@$uid.service

sudo -n install -d -o "$uid" -g "$gid" -m 700 "$XDG_RUNTIME_DIR"
# A previous manager leaves child cgroups with controllers enabled, which
# blocks moving a process into $cg. Remove the empty stale tree first.
if [ -d "$cg" ]; then
  sudo -n find "$cg" -depth -type d -exec rmdir {} + 2>/dev/null || true
fi
sudo -n mkdir -p "$cg"
sudo -n chown -R "$uid:$gid" "$cg"
echo "+cpu +memory +pids +io" | sudo -n tee \
  /sys/fs/cgroup/user.slice/cgroup.subtree_control \
  "/sys/fs/cgroup/user.slice/user-$uid.slice/cgroup.subtree_control" >/dev/null

# The inner bash moves itself into $cg, records its PID for the cheap liveness
# check in ~/.config/shell/env, then execs the manager in place.
# shellcheck disable=SC2016
setsid bash -c 'sudo -n sh -c "echo $$ > $1/cgroup.procs" && echo $$ > "$2" && exec /usr/lib/systemd/systemd --user' \
  _ "$cg" "$XDG_RUNTIME_DIR/systemd-user.pid" \
  >"$XDG_RUNTIME_DIR/systemd-user.log" 2>&1 </dev/null &

for _ in $(seq 50); do
  systemctl --user is-system-running >/dev/null 2>&1 && exit 0
  sleep 0.1
done
echo "systemd --user did not start; see $XDG_RUNTIME_DIR/systemd-user.log" >&2
exit 1
