#!/bin/sh
# gh wrapper: always create pull requests as drafts.
# Chains to the next `gh` after this script's own PATH entry (so other shims,
# e.g. dogbrew, can sit behind it). If none follows, falls back to any other
# `gh` earlier on PATH. Never runs itself.
self=$(cd "$(dirname "$0")" && pwd -P)/$(basename "$0")
real=; before=; passed=
IFS=:
for d in $PATH; do
  c="$d/gh"
  [ -x "$c" ] || continue
  if [ "$(cd "$d" 2>/dev/null && pwd -P)/gh" = "$self" ]; then
    passed=1; continue
  fi
  if [ -n "$passed" ]; then real=$c; break; fi
  [ -n "$before" ] || before=$c
done
unset IFS
[ -n "$real" ] || real=$before
[ -n "$real" ] || { echo "gh: no other gh found on PATH" >&2; exit 127; }

# Add --draft after `pr create` (global flags such as -R may come first),
# unless a draft flag is already present.
draft=
for a in "$@"; do
  case "$a" in
    --draft|--draft=true) draft=1 ;;
    --*) ;;
    -*d*) draft=1 ;;
  esac
done
if [ -z "$draft" ]; then
  n=$#; i=0; prev=; done_=
  while [ "$i" -lt "$n" ]; do
    a=$1; shift; i=$((i + 1))
    set -- "$@" "$a"
    if [ -z "$done_" ] && [ "$prev" = pr ] && [ "$a" = create ]; then
      set -- "$@" --draft; done_=1
    fi
    prev=$a
  done
fi
exec "$real" "$@"
