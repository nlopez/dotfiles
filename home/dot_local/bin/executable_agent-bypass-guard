#!/usr/bin/env python3
"""Refuse agent shell commands that skip git hooks or disable commit signing.

Used as a Claude Code PreToolUse hook (Bash matcher) and by the pi extension
git-bypass-guard.ts; hook I/O in agent_guard.py.

Commit/PR message text (-m/--message/--body/--title arguments and heredoc
bodies) is ignored so a message that mentions a flag is not blocked.
"""

import os
import re
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import agent_guard  # noqa: E402

REASON = (
    "Blocked: this command skips git hooks or disables commit signing. "
    "Commits must be signed and hooks must run. If signing or a hook fails, "
    "stop and report the error to the user instead of working around it."
)

BYPASSES = [
    # Skip signing for one command.
    re.compile(r"--no-gpg-sign\b"),
    # Turn signing off via -c, git config, or a GIT_CONFIG_* env pair.
    re.compile(r"\b(?:commit|tag)\.gpgsign\b['\"]?(?:\s*=\s*|\s+)['\"]?(?:false|no|off|0)\b", re.I),
    re.compile(r"--unset(?:-all)?\s+(?:commit|tag)\.gpgsign\b", re.I),
    # Skip hooks.
    re.compile(r"\bgit\b.*--no-verify\b"),
    re.compile(r"\bgit\b(?:\s+-c\s+\S+)*\s+commit\b[^;&|]*\s-[a-zA-Z]*n[a-zA-Z]*\b"),
    re.compile(r"\bgit\s+fcommit\b"),
    re.compile(r"\bcore\.hooksPath\s*=", re.I),
    # Disable or replace the signing hooks.
    re.compile(r"\bhook\.require-signed-\w+\."),
    re.compile(r"\bGIT_CONFIG_(?:GLOBAL|NOSYSTEM|COUNT|PARAMETERS|KEY_\d+|VALUE_\d+)\s*="),
]


def blocked(text: str) -> bool:
    return any(p.search(text) for p in BYPASSES)


if __name__ == "__main__":
    agent_guard.run(blocked, REASON)
