#!/bin/bash
# rclone-mounts — manage rclone nfsmount mounts via launchd.
#
# Configuration source: ~/.config/rclone-mounts/mounts.yaml  (XDG config)
# Generated scripts:    ~/.local/share/rclone-mounts/<remote>.sh
# Generated plists:     ~/Library/LaunchAgents/localuser.rclone-<remote>.mount.plist
#
# Usage:
#   rclone-mounts generate           # (re)generate scripts + plists from config
#   rclone-mounts mount              # load + start all mounts via launchd
#   rclone-mounts unmount            # stop + unload all mounts
#   rclone-mounts unmount <remote>   # stop + unload one mount
#   rclone-mounts remount <remote>   # unmount then mount one remote
#   rclone-mounts status             # show mount status
#
# Workflow for adding a new mount:
#   1. Add entry to ~/.chezmoidata/mounts.yaml (via chezmoi source tree)
#   2. chezmoi apply
#   3. rclone-mounts generate
#   4. rclone-mounts mount

set -euo pipefail

# ── Paths ──────────────────────────────────────────────────────────────────────

MOUNTS_CONFIG="${XDG_CONFIG_HOME:-${HOME}/.config}/rclone-mounts/mounts.yaml"
SCRIPTS_DIR="${HOME}/.local/share/rclone-mounts"
LAUNCH_AGENTS_DIR="${HOME}/Library/LaunchAgents"
LOG_DIR="${HOME}/Library/Logs"
RCLONE="${HOME}/.local/bin/rclone"
BREW_PREFIX="${HOMEBREW_PREFIX:-$(brew --prefix 2>/dev/null || echo /opt/homebrew)}"

# ── Helpers ────────────────────────────────────────────────────────────────────

log()  { printf '[%s] %s\n' "$(date '+%H:%M:%S')" "$*"; }
info() { log "INFO  $*"; }
warn() { log "WARN  $*"; }
err()  { log "ERROR $*" >&2; }

# List all configured remote names from mounts.yaml
remote_names() {
    yq '.mounts | keys | .[]' "${MOUNTS_CONFIG}"
}

# Read one option for a remote; print default if null/absent
# Usage: get_opt <remote> <yaml-key> [default]
get_opt() {
    local remote="$1" key="$2" default="${3:-}"
    local val
    val=$(yq ".mounts.${remote}.${key}" "${MOUNTS_CONFIG}" 2>/dev/null)
    if [ "${val}" = "null" ] || [ -z "${val}" ]; then
        echo "${default}"
    else
        echo "${val}"
    fi
}

# Expand a leading ~/ to $HOME
expand_home() { echo "${1/#\~/${HOME}}"; }

# Launchd label for a remote
label_for() { echo "localuser.rclone-${1}.mount"; }

# Launchd GUI session UID
gui_uid() { echo "gui/$(id -u)"; }

# Check if a launchd service is registered
service_registered() {
    launchctl list "$(label_for "$1")" &>/dev/null
}

# Check if a path is currently an NFS/FUSE mount
is_mounted() {
    mount | grep -qF " $1 " 2>/dev/null
}

# ── generate ───────────────────────────────────────────────────────────────────

cmd_generate() {
    mkdir -p "${SCRIPTS_DIR}" "${LAUNCH_AGENTS_DIR}" "${LOG_DIR}"

    # Remove stale artefacts for remotes no longer in config
    local configured
    configured=$(remote_names | tr '\n' '|')  # pipe-separated for grep
    for plist in "${LAUNCH_AGENTS_DIR}"/localuser.rclone-*.mount.plist; do
        [[ -f "${plist}" ]] || continue
        local lbl
        lbl=$(basename "${plist}" .plist)
        local name="${lbl#localuser.rclone-}"
        name="${name%.mount}"
        if ! echo "${configured}" | grep -qF "${name}|"; then
            warn "Removing stale plist for unconfigured remote '${name}'"
            launchctl bootout "$(gui_uid)" "${lbl}" 2>/dev/null || true
            rm -f "${plist}" "${SCRIPTS_DIR}/${name}.sh"
        fi
    done

    local count=0
    for remote in $(remote_names); do
        _generate_one "${remote}" && (( count++ )) || true
    done
    info "Generated ${count} mount script(s) and plist(s)."
    info "Run: rclone-mounts mount"
}

_generate_one() {
    local remote="$1"

    # Read config values
    # rclone_remote: the actual rclone remote name (may differ from the YAML key)
    local rclone_remote; rclone_remote=$(get_opt "${remote}" remote "${remote}")
    local mp;     mp=$(expand_home "$(get_opt "${remote}" mountpoint        "~/mnt/${remote}")")
    local mode;   mode=$(get_opt    "${remote}" vfs_cache_mode       "writes")
    local maxsz;  maxsz=$(get_opt   "${remote}" vfs_cache_max_size   "10G")
    local maxage; maxage=$(get_opt  "${remote}" vfs_cache_max_age    "1h")
    local poll;   poll=$(get_opt    "${remote}" vfs_cache_poll_interval "1m")
    local wb;     wb=$(get_opt      "${remote}" vfs_write_back       "5s")
    local dct;    dct=$(get_opt     "${remote}" dir_cache_time       "5m")
    local pi;     pi=$(get_opt      "${remote}" poll_interval        "1m")
    local attr;   attr=$(get_opt    "${remote}" attr_timeout         "1s")
    local loglvl; loglvl=$(get_opt  "${remote}" log_level            "INFO")
    local logf;   logf=$(get_opt    "${remote}" log_file             "rclone-${remote}-mount.log")
    local nfslim; nfslim=$(get_opt  "${remote}" nfs_cache_handle_limit "1000000")
    local allow_other;    allow_other=$(get_opt   "${remote}" allow_other    "false")
    local allow_nonempty; allow_nonempty=$(get_opt "${remote}" allow_non_empty "false")
    local no_unicode;     no_unicode=$(get_opt    "${remote}" no_unicode_normalization "false")
    local read_only; read_only=$(get_opt "${remote}" read_only "false")
    local rc;        rc=$(get_opt       "${remote}" rc        "false")
    local rc_addr;   rc_addr=$(get_opt  "${remote}" rc_addr   "localhost:5572")

    local log_path="${LOG_DIR}/${logf}"
    local script="${SCRIPTS_DIR}/${remote}.sh"
    local plist="${LAUNCH_AGENTS_DIR}/$(label_for "${remote}").plist"
    local label
    label=$(label_for "${remote}")

    # ── per-mount shell script ─────────────────────────────────────────────────
    {
    cat <<SHEOF
#!/bin/sh
# rclone nfsmount wrapper for remote: ${remote}
# Generated by rclone-mounts generate — do not edit manually.
set -eu

export HOME="${HOME}"
export PATH="${HOME}/.local/bin:${BREW_PREFIX}/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
export RCLONE_CONFIG="${HOME}/.config/rclone/rclone.conf"

MOUNT_DIR="${mp}"
mkdir -p "\${MOUNT_DIR}"

# Build argument list
set -- \\
    "${rclone_remote}:" \\
    "\${MOUNT_DIR}" \\
    --vfs-cache-mode     "${mode}" \\
    --vfs-cache-max-size "${maxsz}" \\
    --vfs-cache-max-age  "${maxage}" \\
    --vfs-cache-poll-interval "${poll}" \\
    --vfs-write-back     "${wb}" \\
    --dir-cache-time     "${dct}" \\
    --poll-interval      "${pi}" \\
    --attr-timeout       "${attr}" \\
    --nfs-cache-handle-limit "${nfslim}" \\
    --log-level          "${loglvl}" \\
    --log-file           "${log_path}" \\
    --no-unicode-normalization="${no_unicode}"
SHEOF

    [ "${allow_other}"    = "true" ] && echo 'set -- "$@" --allow-other'
    [ "${allow_nonempty}" = "true" ] && echo 'set -- "$@" --allow-non-empty'
    [ "${read_only}"      = "true" ] && echo 'set -- "$@" --read-only'
    if [ "${rc}" = "true" ]; then
        cat <<RCEOF
set -- "\$@" --rc --rc-addr "${rc_addr}"
RCEOF
    fi

    cat <<EXECEOF

exec "${RCLONE}" nfsmount "\$@"
EXECEOF
    } > "${script}"

    chmod +x "${script}"

    # ── launchd plist ─────────────────────────────────────────────────────────
    cat > "${plist}" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>              <string>${label}</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>${script}</string>
    </array>
    <key>RunAtLoad</key>          <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key> <false/>
    </dict>
    <key>ThrottleInterval</key>   <integer>30</integer>
    <key>WorkingDirectory</key>   <string>${HOME}</string>
    <key>StandardOutPath</key>    <string>${LOG_DIR}/rclone-${remote}-mount.log</string>
    <key>StandardErrorPath</key>  <string>${LOG_DIR}/rclone-${remote}-mount-error.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>  <string>${HOME}/.local/bin:${BREW_PREFIX}/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>  <string>${HOME}</string>
        <key>RCLONE_CONFIG</key> <string>${HOME}/.config/rclone/rclone.conf</string>
    </dict>
    <key>SoftResourceLimits</key>
    <dict>
        <key>NumberOfFiles</key>  <integer>65536</integer>
    </dict>
</dict>
</plist>
PLIST

    info "Generated: ${script}"
    info "Generated: ${plist}"
}

# ── mount ──────────────────────────────────────────────────────────────────────

cmd_mount() {
    local failed=0
    for remote in $(remote_names); do
        _mount_one "${remote}" || failed=1
    done
    [[ "${failed}" -eq 0 ]] || { err "One or more mounts failed."; return 1; }
}

_mount_one() {
    local remote="$1"
    local label
    label=$(label_for "${remote}")
    local plist="${LAUNCH_AGENTS_DIR}/${label}.plist"

    if [[ ! -f "${plist}" ]]; then
        warn "No plist for '${remote}' — generating first..."
        _generate_one "${remote}"
    fi

    if service_registered "${remote}"; then
        info "'${remote}' already registered — kicking..."
        launchctl kickstart -k "$(gui_uid)/${label}" 2>/dev/null || true
    else
        info "Loading '${remote}'..."
        launchctl bootstrap "$(gui_uid)" "${plist}"
    fi
}

# ── unmount ────────────────────────────────────────────────────────────────────

cmd_unmount() {
    local target="${1:-}"
    if [[ -n "${target}" ]]; then
        _unmount_one "${target}"
    else
        local failed=0
        for remote in $(remote_names); do
            _unmount_one "${remote}" || failed=1
        done
        [[ "${failed}" -eq 0 ]] || { err "One or more unmounts failed."; return 1; }
    fi
}

_unmount_one() {
    local remote="$1"
    local label
    label=$(label_for "${remote}")
    local mp
    mp=$(expand_home "$(get_opt "${remote}" mountpoint "~/mnt/${remote}")")

    # Stop launchd service
    if service_registered "${remote}"; then
        info "Stopping launchd service '${label}'..."
        launchctl bootout "$(gui_uid)" "${label}" 2>/dev/null || true
        sleep 1
    fi

    # Unmount filesystem
    if is_mounted "${mp}"; then
        info "Unmounting ${mp}..."
        umount "${mp}" 2>/dev/null \
            || umount -f "${mp}" 2>/dev/null \
            || { err "Could not unmount ${mp} — is it busy?"; return 1; }
    else
        warn "'${remote}': ${mp} is not mounted"
    fi
    info "'${remote}' unmounted."
}

# ── remount ────────────────────────────────────────────────────────────────────

cmd_remount() {
    local remote="${1:?Usage: rclone-mounts remount <remote>}"
    _unmount_one "${remote}"
    _generate_one "${remote}"
    _mount_one    "${remote}"
}

# ── status ─────────────────────────────────────────────────────────────────────

cmd_status() {
    printf '\n%-20s %-40s %-10s %s\n' "REMOTE" "MOUNTPOINT" "MOUNTED" "LAUNCHD"
    printf '%s\n' "$(printf '─%.0s' {1..80})"
    for remote in $(remote_names); do
        local mp
        mp=$(expand_home "$(get_opt "${remote}" mountpoint "~/mnt/${remote}")")
        local label
        label=$(label_for "${remote}")

        local mounted="no"
        is_mounted "${mp}" && mounted="YES"

        local svc_status="not loaded"
        if service_registered "${remote}"; then
            local pid
            pid=$(launchctl list "${label}" 2>/dev/null | awk 'NR==2{print $1}')
            svc_status="${pid:+pid=${pid}}"
            svc_status="${svc_status:-loaded}"
        fi

        printf '%-20s %-40s %-10s %s\n' "${remote}" "${mp}" "${mounted}" "${svc_status}"
    done
    echo
}

# ── usage ──────────────────────────────────────────────────────────────────────

usage() {
    cat <<EOF
rclone-mounts — manage rclone nfsmount mounts

Usage: rclone-mounts <command> [args]

Commands:
  generate              (Re)generate launchd plists + scripts from mounts.yaml
  mount                 Load and start all configured mounts
  unmount [remote]      Stop all mounts, or a single named remote
  remount <remote>      Unmount, regenerate, and remount one remote
  status                Show mount status for all configured remotes

Config: ${MOUNTS_CONFIG}
Scripts: ${SCRIPTS_DIR}/
Plists:  ${LAUNCH_AGENTS_DIR}/localuser.rclone-*.mount.plist
EOF
}

# ── entry point ────────────────────────────────────────────────────────────────

main() {
    local cmd="${1:-}"
    case "${cmd}" in
        generate)           cmd_generate ;;
        mount)              cmd_mount ;;
        unmount)            cmd_unmount "${2:-}" ;;
        remount)            cmd_remount "${2:-}" ;;
        status)             cmd_status ;;
        help|--help|-h|"")  usage ;;
        *) err "Unknown command: ${cmd}"; usage; exit 1 ;;
    esac
}

main "$@"
