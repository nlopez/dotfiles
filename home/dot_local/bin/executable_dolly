#!/usr/bin/env -S uv run --python 3.14.3 --script
# Like the cloned sheep, because it runs git clone.
# Bare repo + primary worktree: https://www.tomups.com/posts/git-worktrees/
from __future__ import annotations

import argparse
import sys
from pathlib import Path
from shlex import quote
from subprocess import CalledProcessError, run
from urllib.parse import urlparse

# ~/src/<host>/<path>/.bare, .git → ./.bare, <default-branch>/


def git(repo: Path, *args: str) -> None:
    run(["git", "-C", str(repo), *args], check=True, text=True)


def git_out(repo: Path, *args: str) -> str:
    r = run(
        ["git", "-C", str(repo), *args],
        check=True,
        text=True,
        capture_output=True,
    )
    return r.stdout.strip()


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Clone a Git repo as bare + primary worktree under ~/src/<host>/…",
    )
    parser.add_argument("url", help="git clone <url>")
    parser.add_argument(
        "git_args",
        nargs="*",
        help="extra arguments for git clone --bare",
    )
    args = parser.parse_args()

    url = urlparse(args.url)
    netloc = url.netloc.split("@")[-1]
    dest = Path.home() / "src" / netloc / url.path.lstrip("/")
    bare = dest / ".bare"

    if dest.exists() and any(dest.iterdir()):
        print(f"error: destination not empty: {dest}", file=sys.stderr)
        return 1

    dest.mkdir(parents=True, exist_ok=True)

    try:
        run(
            ["git", "clone", "--bare", *args.git_args, url.geturl(), str(bare)],
            check=True,
        )
        (dest / ".git").write_text("gitdir: ./.bare\n", encoding="utf-8")

        branch = git_out(dest, "symbolic-ref", "--short", "HEAD")
        spec = f"+refs/heads/{branch}:refs/remotes/origin/{branch}"
        git(dest, "config", "remote.origin.fetch", spec)
        git(dest, "fetch", "origin")
        git(dest, "worktree", "add", branch, branch)

        work = dest / branch
        git(work, "branch", "--set-upstream-to", f"origin/{branch}")
    except CalledProcessError as e:
        return e.returncode if e.returncode else 1

    print(f"Bare repo: {dest}")
    print(f"Work in:   {work}")
    print(f"Add more:  git -C {quote(str(dest))} worktree add <path> <branch>")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
