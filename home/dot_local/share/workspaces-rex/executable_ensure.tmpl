{{- if .workspace -}}
#!/bin/bash
# Starts this account's Rex server when it is not running, and puts back the
# crontab entry that runs this script every minute. cron runs it, and so does
# the workspaces-rex tunnel supervisor on a work Mac on every poll.
#
# The server listens only on its Unix socket. Clients reach it by forwarding
# that socket over SSH, so it needs no TCP listener.
#
# Output: a marker line, then the server's JSON status.
set -u
unset REX_SERVER REX_SESSION REX_BLOCK
export SSH_AUTH_SOCK="$HOME/.ssh/ssh_auth_sock"

# The markers let this script change only its own block of the crontab.
begin='# BEGIN workspaces-rex'
end='# END workspaces-rex'
# $HOME stays literal: cron's shell expands it.
# shellcheck disable=SC2016
line='* * * * * /bin/bash -l "$HOME/.local/share/workspaces-rex/ensure" >/dev/null 2>&1'

current=$(crontab -l 2>/dev/null) || current=
if ! printf '%s\n' "$current" | grep -qxF -- "$line"; then
	{
		if [ -n "$current" ]; then
			printf '%s\n' "$current" | awk -v b="$begin" -v e="$end" '$0 == b { skip = 1; next } $0 == e { skip = 0; next } !skip'
		fi
		printf '%s\n%s\n%s\n' "$begin" "$line" "$end"
	} | crontab - || echo "workspaces-rex: could not install the crontab entry" >&2
fi

echo '--- workspaces-rex ---'
exec "$HOME/.local/bin/rex" server start --json
{{- end }}
