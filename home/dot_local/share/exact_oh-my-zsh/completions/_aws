#compdef aws
# zsh completion for the aws shim at ~/.local/bin/aws.
#
# --profile / -p: reads profiles from ~/.aws/config and offers them via compadd.
#                 fzf integration is handled separately by the _aws_profile_fzf
#                 ZLE widget defined in 00_custom.zsh, which intercepts Tab before
#                 this completion function is ever called.
# Everything else: delegates to aws_completer for full sub-command/flag completion.
#   Results are cached per-subcommand so aws_completer only runs once per context.

# Real aws binary — bypass the shim to avoid sts get-caller-identity overhead.
_AWS_BIN="${commands[aws]:-/opt/homebrew/bin/aws}"
[[ "$_AWS_BIN" == "$HOME/.local/bin/aws" ]] && _AWS_BIN=/opt/homebrew/bin/aws

# ---------------------------------------------------------------------------
# Helper: extract profile names from ~/.aws/config, one per line.
# ---------------------------------------------------------------------------
_aws_profiles() {
  local config="${AWS_CONFIG_FILE:-$HOME/.aws/config}"
  [[ -f "$config" ]] || return 1
  grep -E '^\[(profile [^]]+|default)\]' "$config" \
    | sed -E 's/^\[profile ([^]]+)\]$/\1/; s/^\[default\]$/default/'
}

# ---------------------------------------------------------------------------
# Main completion function
# ---------------------------------------------------------------------------
_aws() {
  local cur prev
  cur="${words[CURRENT]}"
  prev="${words[CURRENT-1]}"

  # --profile <TAB> or -p <TAB>
  if [[ "$prev" == "--profile" || "$prev" == "-p" ]]; then
    local -a profile_list
    profile_list=("${(@f)$(_aws_profiles)}")
    local -a matches
    if [[ -n "$cur" ]]; then
      matches=("${(@)profile_list[(R)${cur}*]}")
      (( ${#matches} )) || matches=("${(@)profile_list[(R)*${cur}*]}")
    else
      matches=("${profile_list[@]}")
    fi
    compadd -Q -- "${matches[@]}"
    return
  fi

  # --profile=<TAB> or --profile=partial<TAB>
  if [[ "$cur" == --profile=* ]]; then
    local prefix="${cur#--profile=}"
    local -a profile_list
    profile_list=("${(@f)$(_aws_profiles)}")
    local -a matches
    if [[ -n "$prefix" ]]; then
      matches=("${(@)profile_list[(R)${prefix}*]}")
      (( ${#matches} )) || matches=("${(@)profile_list[(R)*${prefix}*]}")
    else
      matches=("${profile_list[@]}")
    fi
    compadd -Q -P "--profile=" -- "${matches[@]}"
    return
  fi

  # Everything else: delegate to aws_completer, caching results per command context.
  if command -v aws_completer &>/dev/null; then
    local _AWS_BIN_COMPLETER="${commands[aws_completer]:-/opt/homebrew/bin/aws_completer}"

    # Build a cache key from the current word context (e.g. "aws_s3_ls").
    local cache_key="aws_${(j:_:)words[1,-2]//[^a-zA-Z0-9]/_}"
    local -a completions

    if ! _retrieve_cache "$cache_key"; then
      local COMP_LINE COMP_POINT
      COMP_LINE="${words[*]}"
      COMP_POINT="${#COMP_LINE}"
      local IFS=$'\n'
      completions=($(COMP_LINE="$COMP_LINE" COMP_POINT="$COMP_POINT" "$_AWS_BIN_COMPLETER" 2>/dev/null))
      _store_cache "$cache_key" completions
    fi

    compadd -- "${completions[@]}"
  fi
}

_aws "$@"
