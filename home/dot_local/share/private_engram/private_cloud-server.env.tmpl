{{- /* ~/.local/share/engram/cloud-server.env — secrets for the work Mac's local
   `engram cloud serve` LaunchAgent. Mode 0600 via the private_ prefix so the
   plist holds no secrets. */ -}}
{{- if and (eq .chezmoi.os "darwin") .work (not .headless) .encryption }}
{{- $p := includeTemplate "private-data" . | fromYaml }}
ENGRAM_CLOUD_TOKEN={{ $p.engram_cloud.token | quote }}
ENGRAM_JWT_SECRET={{ $p.engram_cloud.jwt_secret | quote }}
{{- end }}
