Host *
  Compression yes
  ServerAliveInterval 240
  ServerAliveCountMax 2
  HostKeyAlgorithms -ssh-rsa
  ForwardAgent no
  IdentityFile none
  LogLevel ERROR
  StrictHostKeyChecking accept-new
  User nlopez
  {{- if eq .chezmoi.os "darwin" }}
  IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
  {{- end }}

#Default github.com → personal/nlopez key (DataDog org access goes through nlopez).
Host github.com
  User git
  IdentitiesOnly yes
  IdentityFile ~/.ssh/id_nlopez.pub

{{- if .personal }}

# Aliased host for hobby orgs (silentshout42, kamotimestamps). Routed via git insteadOf.
Host github.com-hobby
  HostName github.com
  User git
  IdentitiesOnly yes
  IdentityFile ~/.ssh/id_silentshout42.pub
{{- end }}
{{- if .work }}

#Aliased host for ddoghq + ddoghq-sandbox orgs. Routed via git insteadOf.
Host github.com-ddog
  HostName github.com
  User git
  IdentitiesOnly yes
  IdentityFile ~/.ssh/id_ddog.pub
{{- end }}
