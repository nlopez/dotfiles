Host *
  Compression yes
  ServerAliveInterval 240
  ServerAliveCountMax 2
  HostKeyAlgorithms -ssh-rsa
  ForwardAgent no
  IdentityFile none
  LogLevel ERROR
  StrictHostKeyChecking accept-new
  User nlopez
  {{- if eq .chezmoi.os "darwin" }}
  IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
  {{- else if eq .chezmoi.os "linux" }}
  IdentityAgent "~/.1password/agent.sock"
  {{- end }}

# Default github.com is anonymous — no key offered. All org access must go
# through one of the org-specific aliases below (driven by git insteadOf rules).
Host github.com
  User git
  IdentitiesOnly yes

# Aliased host for personal/nlopez orgs (DataDog, nlopez). Routed via git insteadOf.
Host github.com-nlopez
  HostName github.com
  User git
  IdentitiesOnly yes
  IdentityFile ~/.ssh/id_nlopez
{{- if .personal }}

# Aliased host for hobby orgs (silentshout42, kamotimestamps). Routed via git insteadOf.
Host github.com-hobby
  HostName github.com
  User git
  IdentitiesOnly yes
  IdentityFile ~/.ssh/id_silentshout42
{{- end }}
{{- if .work }}

# Aliased host for ddoghq + ddoghq-sandbox orgs. Routed via git insteadOf.
Host github.com-ddog
  HostName github.com
  User git
  IdentitiesOnly yes
  IdentityFile ~/.ssh/id_ddog
{{- end }}
