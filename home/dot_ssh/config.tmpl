Host *
  Compression yes
  ServerAliveInterval 240
  ServerAliveCountMax 2
  HostKeyAlgorithms -ssh-rsa
  ForwardAgent no
  IdentityFile none
  LogLevel ERROR
  StrictHostKeyChecking accept-new
  User nlopez
  {{- if eq .chezmoi.os "darwin" }}
  IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
  {{- else if eq .chezmoi.os "linux" }}
  IdentityAgent "~/.1password/agent.sock"
  {{- end }}

# Direct github.com connections are anonymous — git uses core.sshCommand
# (set per-repo by the identity includes) to authenticate instead.
Host github.com
  User git
  IdentitiesOnly yes

# SSH aliases below are not used by git (core.sshCommand handles that), but
# are kept as named shortcuts for testing: ssh -T git@github.com-nlopez
# Each alias pins exactly one public key so the 1Password agent offers the
# right identity without attempting others.

# nlopez GitHub identity: nlopez + DataDog org repos.
Host github.com-nlopez
  HostName github.com
  User git
  IdentityFile ~/.ssh/id_nlopez.pub
  IdentitiesOnly yes

{{- if .work }}
# nick-lopez_ddog GitHub identity: ddoghq + ddoghq-sandbox org repos.
Host github.com-nick-lopez_ddog
  HostName github.com
  User git
  IdentityFile ~/.ssh/id_nick-lopez_ddog.pub
  IdentitiesOnly yes
{{- end }}

{{- if .personal }}
# SilentShout42 GitHub identity: silentshout42 + kamotimestamps org repos.
Host github.com-silentshout42
  HostName github.com
  User git
  IdentityFile ~/.ssh/id_silentshout42.pub
  IdentitiesOnly yes
{{- end }}
