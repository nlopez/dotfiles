typeset -U path

export XDG_DATA_HOME=$HOME/.local/share
export XDG_CONFIG_HOME=$HOME/.config
export XDG_STATE_HOME=$HOME/.local/state
export XDG_CACHE_HOME=$HOME/.cache

export HOMEBREW_NO_AUTO_UPDATE=1
export HOMEBREW_NO_ENV_HINTS=1
# Homebrew: run auto-update at most once per day (default behavior)
export HOMEBREW_AUTO_UPDATE_SECS=86400
# Homebrew: disable analytics/telemetry
export HOMEBREW_NO_ANALYTICS=1
# Homebrew: verify SLSA build-provenance attestations on homebrew-core bottles.
# Catches the case where a bottle is swapped out under us. Requires `gh`.
export HOMEBREW_VERIFY_ATTESTATIONS=1
# Homebrew: refuse insecure HTTP redirects during downloads.
export HOMEBREW_NO_INSECURE_REDIRECT=1
# Homebrew: require casks to have a SHA. Bypass for one-off installs of
# autoupdate casks via:  HOMEBREW_CASK_OPTS= brew install --cask <name>
export HOMEBREW_CASK_OPTS="--require-sha"

# gh CLI: disable telemetry
export GH_TELEMETRY=false
# gh CLI: disable update notifications
export GH_NO_UPDATE_NOTIFIER=1

# Pager: exit immediately if output fits on screen; keep ANSI colours.
# -F  quit-if-one-screen
# -R  raw ANSI colour codes
# -X  don't clear screen on exit
export LESS="-FRX"
export AWS_PAGER=""  # AWS CLI: skip pager entirely (respects LESS poorly)

# Supply-chain security: every shell starts with a fresh "N days ago" cutoff.
# Delay window is defined in .chezmoidata/security.yaml (supplyChainDelayDays).
# npm/pnpm honor $npm_config_before; uv honors $UV_EXCLUDE_NEWER.
# Use zsh/datetime (pure-zsh) to avoid depending on a `date` binary that
# may or may not be GNU at this point in startup.
zmodload zsh/datetime
strftime -s __supplychain_cutoff '%Y-%m-%d' $((EPOCHSECONDS - {{ .supplyChainDelayDays }}*86400))
export npm_config_before="$__supplychain_cutoff"
export UV_EXCLUDE_NEWER="$__supplychain_cutoff"
unset __supplychain_cutoff

