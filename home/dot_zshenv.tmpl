typeset -U path

export COLORTERM=truecolor
{{- if .work }}

# Pi MCP adapter: Slack's pre-registered OAuth app expects callbacks on port
# 3118 (matching the Claude Code Slack app redirect URI).
export MCP_OAUTH_CALLBACK_PORT=3118
{{- end }}

export HOMEBREW_PREFIX={{ .packages.brew_prefix }}

{{- if eq .chezmoi.os "darwin" }}
# Prepend GNU tool gnubin directories so GNU utils win over BSD/macOS system
# tools. Driven by the gnu_tools list in .chezmoidata/darwin/packages.yaml.
path=(
{{- range .packages.darwin.gnu_tools }}
    "${HOMEBREW_PREFIX}/opt/{{ . }}/libexec/gnubin"
{{- end }}
    $path
)
{{- end }}
