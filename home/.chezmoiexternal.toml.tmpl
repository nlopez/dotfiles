# everything-claude-code rules - https://github.com/affaan-m/everything-claude-code
[".claude/rules/ecc"]
    type = "archive"
    url = "https://github.com/affaan-m/everything-claude-code/archive/refs/heads/main.tar.gz"
    stripComponents = 2
    refreshPeriod = "240h"
    include = [
        "rules/common/**",
        "rules/typescript/**",
        "rules/python/**",
        "rules/golang/**",
        "rules/rust/**",
        "rules/web/**",
    ]

{{- $fontDir := "" }}
{{- if eq .chezmoi.os "darwin" }}
{{-   $fontDir = "Library/Fonts" }}
{{- else if eq .chezmoi.os "linux" }}
{{-   $fontDir = ".local/share/fonts" }}
{{- end }}

