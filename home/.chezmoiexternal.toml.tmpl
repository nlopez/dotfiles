{{- $miseVersion := "v2026.6.1" -}}
{{- $miseOS := "linux" -}}{{- if eq .chezmoi.os "darwin" -}}{{- $miseOS = "macos" -}}{{- end -}}
{{- $miseArch := .chezmoi.arch -}}{{- if eq .chezmoi.arch "amd64" -}}{{- $miseArch = "x64" -}}{{- end -}}

{{- $ageVersion := "v1.3.1" -}}
{{- $ageOS := .chezmoi.os -}}
{{- $ageArch := .chezmoi.arch -}}

{{- $zabrzeVersion := "v0.7.3" -}}
{{- $zabrzeArch := "x86_64" -}}{{- if eq .chezmoi.arch "arm64" -}}{{- $zabrzeArch = "aarch64" -}}{{- end -}}
{{- $zabrzeTarget := "unknown-linux-gnu" -}}{{- if eq .chezmoi.os "darwin" -}}{{- $zabrzeTarget = "apple-darwin" -}}{{- end -}}

{{- if not .headless }}
# age — https://github.com/FiloSottile/age
[".local/bin/age"]
    type = "archive-file"
    # renovate: datasource=github-releases depName=FiloSottile/age
    url = "https://github.com/FiloSottile/age/releases/download/{{ $ageVersion }}/age-{{ $ageVersion }}-{{ $ageOS }}-{{ $ageArch }}.tar.gz"
    path = "age/age"
    executable = true

[".local/bin/age-keygen"]
    type = "archive-file"
    # renovate: datasource=github-releases depName=FiloSottile/age
    url = "https://github.com/FiloSottile/age/releases/download/{{ $ageVersion }}/age-{{ $ageVersion }}-{{ $ageOS }}-{{ $ageArch }}.tar.gz"
    path = "age/age-keygen"
    executable = true
{{- end }}

# mise — https://github.com/jdx/mise
[".local/bin/mise"]
    type = "archive-file"
    # renovate: datasource=github-releases depName=jdx/mise
    url = "https://github.com/jdx/mise/releases/download/{{ $miseVersion }}/mise-{{ $miseVersion }}-{{ $miseOS }}-{{ $miseArch }}.tar.gz"
    path = "mise/bin/mise"
    executable = true

# zabrze — https://github.com/Ryooooooga/zabrze
[".local/bin/zabrze"]
    type = "archive-file"
    # renovate: datasource=github-releases depName=Ryooooooga/zabrze
    url = "https://github.com/Ryooooooga/zabrze/releases/download/{{ $zabrzeVersion }}/zabrze-{{ $zabrzeVersion }}-{{ $zabrzeArch }}-{{ $zabrzeTarget }}.tar.gz"
    path = "zabrze"
    executable = true

[".local/bin/rclone"]
    type = "archive-file"
    url = "https://github.com/rclone/rclone/releases/download/v1.74.2/rclone-v1.74.2-osx-arm64.zip"
    path = "rclone"
    stripComponents = 1
    executable = true

[".local/share/oh-my-zsh"]
    type = "archive"
    url = "https://github.com/ohmyzsh/ohmyzsh/archive/master.tar.gz"
    exact = true
    stripComponents = 1
    refreshPeriod = "168h"
[".local/share/oh-my-zsh/custom/plugins/fast-syntax-highlighting"]
    type = "archive"
    # renovate: datasource=github-commits depName=zdharma-continuum/fast-syntax-highlighting
    url = "https://github.com/zdharma-continuum/fast-syntax-highlighting/archive/3d574ccf48804b10dca52625df13da5edae7f553.tar.gz"
    exact = true
    stripComponents = 1
[".local/share/oh-my-zsh/custom/plugins/pure"]
    type = "archive"
    # renovate: datasource=github-releases depName=sindresorhus/pure
    url = "https://github.com/sindresorhus/pure/archive/v1.28.1.tar.gz"
    exact = true
    stripComponents = 1
[".local/share/oh-my-zsh/custom/plugins/zsh-autosuggestions"]
    type = "archive"
    url = "https://github.com/zsh-users/zsh-autosuggestions/archive/v0.7.1.tar.gz"
    exact = true
    stripComponents = 1
[".local/share/oh-my-zsh/custom/plugins/zsh-completions"]
    type = "archive"
    url = "https://github.com/zsh-users/zsh-completions/archive/0.36.0.tar.gz"
    exact = true
    stripComponents = 1
[".local/share/oh-my-zsh/custom/plugins/fzf-tab"]
    type = "archive"
    url = "https://github.com/Aloxaf/fzf-tab/archive/v1.3.0.tar.gz"
    exact = true
    stripComponents = 1

# Nerd Fonts (Iosevka) are intentionally NOT managed by chezmoi as externals:
# the release zips are ~375MB each and chezmoi must fully decompress an
# "archive" external into memory to compute its target state on every
# apply/status/diff, even when excluded from application — this alone cost
# several seconds and ~3GB of peak heap on every invocation. Install fonts
# manually (e.g. via your package manager, or download once from
# https://github.com/ryanoasis/nerd-fonts/releases) instead.
