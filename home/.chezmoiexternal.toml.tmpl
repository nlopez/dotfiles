{{- $miseVersion := "v2026.6.1" -}}
{{- $miseOS := "linux" -}}{{- if eq .chezmoi.os "darwin" -}}{{- $miseOS = "macos" -}}{{- end -}}
{{- $miseArch := .chezmoi.arch -}}{{- if eq .chezmoi.arch "amd64" -}}{{- $miseArch = "x64" -}}{{- end -}}

# mise — https://github.com/jdx/mise
[".local/bin/mise"]
    type = "archive-file"
    # renovate: datasource=github-releases depName=jdx/mise
    url = "https://github.com/jdx/mise/releases/download/{{ $miseVersion }}/mise-{{ $miseVersion }}-{{ $miseOS }}-{{ $miseArch }}.tar.gz"
    path = "mise/bin/mise"
    executable = true

[".local/bin/rclone"]
    type = "archive-file"
    url = "https://github.com/rclone/rclone/releases/download/v1.74.2/rclone-v1.74.2-osx-arm64.zip"
    path = "rclone"
    stripComponents = 1
    executable = true

[".local/share/oh-my-zsh"]
    type = "archive"
    url = "https://github.com/ohmyzsh/ohmyzsh/archive/master.tar.gz"
    exact = true
    stripComponents = 1
    refreshPeriod = "168h"
[".local/share/oh-my-zsh/custom/plugins/fast-syntax-highlighting"]
    type = "archive"
    # renovate: datasource=github-commits depName=zdharma-continuum/fast-syntax-highlighting
    url = "https://github.com/zdharma-continuum/fast-syntax-highlighting/archive/3d574ccf48804b10dca52625df13da5edae7f553.tar.gz"
    exact = true
    stripComponents = 1
[".local/share/oh-my-zsh/custom/plugins/pure"]
    type = "archive"
    # renovate: datasource=github-releases depName=sindresorhus/pure
    url = "https://github.com/sindresorhus/pure/archive/v1.28.1.tar.gz"
    exact = true
    stripComponents = 1
[".local/share/oh-my-zsh/custom/plugins/zsh-autosuggestions"]
    type = "archive"
    url = "https://github.com/zsh-users/zsh-autosuggestions/archive/v0.7.1.tar.gz"
    exact = true
    stripComponents = 1
[".local/share/oh-my-zsh/custom/plugins/zsh-completions"]
    type = "archive"
    url = "https://github.com/zsh-users/zsh-completions/archive/0.36.0.tar.gz"
    exact = true
    stripComponents = 1
[".local/share/oh-my-zsh/custom/plugins/fzf-tab"]
    type = "archive"
    url = "https://github.com/Aloxaf/fzf-tab/archive/v1.3.0.tar.gz"
    exact = true
    stripComponents = 1

{{- $fontDir := .platform.font_dir }}

{{- if and $fontDir (not .headless) }}
# Iosevka Nerd Font (Normal + Mono + Propo variants)
# Iosevka Term Nerd Font (Term + Mono + Propo variants)
# Both extracted to subdirectories then merged via script
# Pinned versions — no refreshPeriod needed (new version = new URL).

# Iosevka Nerd Font — https://github.com/ryanoasis/nerd-fonts
{{-   $iosevkaUrl := "https://github.com/ryanoasis/nerd-fonts/releases/download/v3.4.0/Iosevka.zip" }}
["{{ $fontDir }}/iosevka-nf"]
    type = "archive"
    url = {{ printf "%q" $iosevkaUrl }}
    include = ["IosevkaNerdFont*"]
    exact = false
    stripComponents = 0

# Iosevka Term Nerd Font
{{-   $iosevkaTermUrl := "https://github.com/ryanoasis/nerd-fonts/releases/download/v3.4.0/IosevkaTerm.zip" }}
["{{ $fontDir }}/iosevka-term-nf"]
    type = "archive"
    url = {{ printf "%q" $iosevkaTermUrl }}
    include = ["IosevkaTermNerdFont*"]
    exact = false
    stripComponents = 0
{{- end }}
