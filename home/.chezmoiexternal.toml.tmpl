[".oh-my-zsh"]
    type = "archive"
    url = "https://github.com/ohmyzsh/ohmyzsh/archive/master.tar.gz"
    exact = true
    stripComponents = 1
    refreshPeriod = "168h"
[".oh-my-zsh/custom/plugins/zsh-syntax-highlighting"]
    type = "archive"
    url = "https://github.com/zsh-users/zsh-syntax-highlighting/archive/0.8.0.tar.gz"
    exact = true
    stripComponents = 1
[".oh-my-zsh/custom/plugins/pure"]
    type = "archive"
    # renovate: datasource=github-releases depName=sindresorhus/pure
    url = "https://github.com/sindresorhus/pure/archive/v1.28.1.tar.gz"
    exact = true
    stripComponents = 1
[".oh-my-zsh/custom/plugins/zsh-autosuggestions"]
    type = "archive"
    url = "https://github.com/zsh-users/zsh-autosuggestions/archive/v0.7.1.tar.gz"
    exact = true
    stripComponents = 1
[".oh-my-zsh/custom/plugins/zsh-completions"]
    type = "archive"
    url = "https://github.com/zsh-users/zsh-completions/archive/0.36.0.tar.gz"
    exact = true
    stripComponents = 1
[".oh-my-zsh/custom/plugins/fzf-tab"]
    type = "archive"
    url = "https://github.com/Aloxaf/fzf-tab/archive/v1.3.0.tar.gz"
    exact = true
    stripComponents = 1

# HashiCorp Terraform agent skills - https://github.com/hashicorp/agent-skills
{{- range list
    "code-generation/terraform-search-import"
    "code-generation/terraform-style-guide"
    "code-generation/terraform-test"
    "module-generation/refactor-module"
    "module-generation/terraform-stacks"
    "provider-development/new-terraform-provider"
    "provider-development/provider-actions"
    "provider-development/provider-docs"
    "provider-development/provider-resources"
    "provider-development/provider-test-patterns"
    "provider-development/run-acceptance-tests" }}
{{- $parts := splitList "/" . }}
{{- $cat := index $parts 0 }}
{{- $skill := index $parts 1 }}
[".claude/skills/{{ $skill }}/SKILL.md"]
    type = "file"
    url = "https://raw.githubusercontent.com/hashicorp/agent-skills/main/terraform/{{ $cat }}/skills/{{ $skill }}/SKILL.md"
    refreshPeriod = "168h"
{{ end -}}

# everything-claude-code rules - https://github.com/affaan-m/everything-claude-code
[".claude/rules/ecc"]
    type = "archive"
    url = "https://github.com/affaan-m/everything-claude-code/archive/refs/heads/main.tar.gz"
    stripComponents = 2
    refreshPeriod = "240h"
    include = [
        "rules/common/**",
        "rules/typescript/**",
        "rules/python/**",
        "rules/golang/**",
        "rules/rust/**",
        "rules/web/**",
    ]

# VoltAgent infra subagents - https://github.com/VoltAgent/awesome-claude-code-subagents
{{- range list
    "azure-infra-engineer"
    "cloud-architect"
    "database-administrator"
    "deployment-engineer"
    "devops-engineer"
    "devops-incident-responder"
    "docker-expert"
    "incident-responder"
    "kubernetes-specialist"
    "network-engineer"
    "platform-engineer"
    "security-engineer"
    "sre-engineer"
    "terraform-engineer"
    "terragrunt-expert" }}
[".claude/agents/{{ . }}.md"]
    type = "file"
    url = "https://raw.githubusercontent.com/VoltAgent/awesome-claude-code-subagents/main/categories/03-infrastructure/{{ . }}.md"
    refreshPeriod = "168h"
{{ end -}}

{{- $fontDir := "" }}
{{- if eq .chezmoi.os "darwin" }}
{{-   $fontDir = "Library/Fonts" }}
{{- else if eq .chezmoi.os "linux" }}
{{-   $fontDir = ".local/share/fonts" }}
{{- end }}

{{- if $fontDir }}
# Iosevka Nerd Font (Normal + Mono + Propo variants)
# Iosevka Term Nerd Font (Term + Mono + Propo variants)
# Both extracted to subdirectories then merged via script

# Iosevka Nerd Font — https://github.com/ryanoasis/nerd-fonts
{{-   $iosevkaUrl := "https://github.com/ryanoasis/nerd-fonts/releases/download/v3.4.0/Iosevka.zip" }}
["{{ $fontDir }}/iosevka-nf"]
    type = "archive"
    url = {{ printf "%q" $iosevkaUrl }}
    include = ["IosevkaNerdFont*"]
    exact = false
    stripComponents = 0
    refreshPeriod = "168h"

# Iosevka Term Nerd Font
{{-   $iosevkaTermUrl := "https://github.com/ryanoasis/nerd-fonts/releases/download/v3.4.0/IosevkaTerm.zip" }}
["{{ $fontDir }}/iosevka-term-nf"]
    type = "archive"
    url = {{ printf "%q" $iosevkaTermUrl }}
    include = ["IosevkaTermNerdFont*"]
    exact = false
    stripComponents = 0
    refreshPeriod = "168h"
{{- end }}
