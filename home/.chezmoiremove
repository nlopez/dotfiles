# Targets chezmoi deletes on every apply. Each entry guards against a file that
# something can recreate; one-time migration entries are removed once every
# machine has applied them.

# Workspaces own this (their package manager hooks, persistent multiplexers PATH)
{{ if not .workspace -}}
.bash_profile
{{ end -}}

# macOS Terminal.app session files — disabled via SHELL_SESSIONS_DISABLE=1
.zsh_sessions/

# Completion cache and dump files — kept under XDG via zstyle/compinit
.zcompcache/
.zcompdump-*
.zcompdump-local-*

# Stray Engram store created when a process runs without ENGRAM_DATA_DIR (real
# store is ~/.local/share/engram)
.engram

# Colima lives in ~/.config/colima (COLIMA_HOME)
.colima

# billion-context Pi extension (dropped); one-time cleanup
.config/billion-context
.local/share/billion-context
.local/state/billion-context
.cache/billion-context

# Alacritty (dropped); one-time cleanup
.config/alacritty

# niri (dropped); one-time cleanup
.config/niri

# Noctalia and Vicinae (dropped); one-time cleanup
.config/noctalia
.config/BraveSoftware/Brave-Origin/NativeMessagingHosts/com.vicinae.vicinae.json

# Linux GPU video decode / Qt theme settings (dropped); one-time cleanup
.config/brave-origin-flags.conf
.config/environment.d/hardware-video-accel.conf
.config/environment.d/qt-theme.conf

# rtk pi extension, retired (one-time migration)
.pi/agent/extensions/rtk.ts
