# Targets chezmoi deletes on every apply. Each entry guards against a file that
# something can recreate; one-time migration entries are removed once every
# machine has applied them.

# Workspaces own these (their package manager hooks, persistent multiplexers PATH)
{{ if not .workspace -}}
.bashrc
.bash_profile
{{ end -}}

# macOS Terminal.app session files — disabled via SHELL_SESSIONS_DISABLE=1
.zsh_sessions/

# Completion cache and dump files — kept under XDG via zstyle/compinit
.zcompcache/
.zcompdump-*
.zcompdump-local-*

# Stray Engram store created when a process runs without ENGRAM_DATA_DIR (real
# store is ~/.local/share/engram)
.engram

# Claude Code lives in ~/.config/claude (CLAUDE_CONFIG_DIR); a run without it
# leaves this backup in $HOME
.claude.json.backup

# Colima lives in ~/.config/colima (COLIMA_HOME)
.colima
