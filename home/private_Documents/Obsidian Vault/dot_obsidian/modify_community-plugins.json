#!/usr/bin/env python3
# Keeps the plugins whose files .chezmoiexternal.toml.tmpl installs enabled,
# preserving any others enabled from Obsidian's UI.
# Receives the current community-plugins.json on stdin (empty if missing),
# writes the replacement to stdout. Unparseable input is passed through.
import json
import sys

WANTED = ["obsidian-git"]

raw = sys.stdin.read()
try:
    plugins = json.loads(raw) if raw.strip() else []
    if not isinstance(plugins, list):
        raise TypeError
except Exception:
    sys.stdout.write(raw)
    sys.exit(0)

plugins += [p for p in WANTED if p not in plugins]
sys.stdout.write(json.dumps(plugins, indent=2) + "\n")
