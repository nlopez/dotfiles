###############################################################################
# AWS profile in preprompt when typing aws/terraform commands
###############################################################################
# _pure_path: smart path string, updated each precmd. In git repos keeps
# everything from the repo root downward unabbreviated and abbreviates above it
# (last 3 components shown). Outside git repos abbreviates at ≥4 dirs after ~.
typeset -g _pure_path=""

function _smart_path_precmd() {
  local git_prefix git_rel repo_root p i au s d r
  local -a parts

  p="${PWD/#$HOME/~}"

  # Abbreviate path parts: keep last 3 full, shorten earlier ones to
  # leading-dots + first-non-dot char. Result in global _abbrev_result.
  _abbrev_parts() {
    local -a pp=("$@")
    local res="~" i au s d r
    au=$(( ${#pp} - 3 ))
    for (( i = 1; i <= ${#pp}; i++ )); do
      s="${pp[$i]}"
      if (( i <= au )); then
        d="" r="$s"
        while [[ "$r" == .* ]]; do d="${d}."; r="${r:1}"; done
        res="${res}/${d}${r:0:1}"
      else
        res="${res}/${s}"
      fi
    done
    _abbrev_result="$res"
  }

  if git_prefix=$(git rev-parse --show-prefix 2>/dev/null); then
    # --show-prefix: path from repo root to CWD with trailing slash, empty at root
    if [[ -n "$git_prefix" ]]; then
      git_rel="${git_prefix%/}"
      repo_root="${p%/$git_rel}"
    else
      git_rel=""
      repo_root="$p"
    fi
    # Abbreviate the pre-root portion; \~/ escapes ~ for EXTENDED_GLOB safety
    if [[ "$repo_root" == "~/"* ]]; then
      parts=("${(@s:/:)${repo_root#\~/}}")
      if (( ${#parts} >= 4 )); then
        _abbrev_parts "${parts[@]}"
        repo_root="$_abbrev_result"
      fi
    fi
    _pure_path="${repo_root}${git_rel:+/$git_rel}"
  else
    if [[ "$p" == "~/"* ]]; then
      parts=("${(@s:/:)${p#\~/}}")
      if (( ${#parts} >= 4 )); then
        _abbrev_parts "${parts[@]}"
        _pure_path="$_abbrev_result"
      else
        _pure_path="$p"
      fi
    else
      _pure_path="$p"
    fi
  fi
}
add-zsh-hook precmd _smart_path_precmd
_smart_path_precmd  # prime before first prompt

###############################################################################
if [[ -n "$TMUX" ]]; then
  # chezmoi apply queued-reload: the run_onchange_after_reload-shells script sets
  # @chezmoi_reload 1 on every zsh pane (idle or busy) without injecting keystrokes.
  # This precmd hook fires before every prompt — i.e. before any command executes —
  # and exec-restarts the shell when the sentinel option is set.  TMUX_PANE must be
  # set (it is absent after a bare `exec env -i … zsh` that doesn't forward it).
  function _chezmoi_reload_precmd() {
    [[ -n "$TMUX_PANE" ]] || return 0
    local _pending
    _pending=$(tmux display-message -p -t "$TMUX_PANE" '#{@chezmoi_reload}' 2>/dev/null) || return 0
    [[ "$_pending" == "1" ]] || return 0
    tmux set-option -pu -t "$TMUX_PANE" @chezmoi_reload 2>/dev/null || true
    exec env -i \
      PATH="{{ .platform.reload_path }}" \
      TERMINFO="$TERMINFO" TERM="$TERM" \
      USER="$USER" HOME="$HOME" SHELL="$SHELL" \
      TMUX="$TMUX" TMUX_PANE="$TMUX_PANE" \
      zsh --login
  }
  add-zsh-hook precmd _chezmoi_reload_precmd

fi

{{- if eq .chezmoi.os "darwin" }}
###############################################################################
# ── Long-running command notifications (terminal-notifier) ────────────────────
# Fires a macOS notification whenever a tmux command runs for longer than 5 s.
# Skips the notification when the tmux window is currently active (the user is
# already looking at the output).
###############################################################################
if command -v terminal-notifier &>/dev/null; then
  _notif_cmd_start=0
  _notif_cmd_name=""

  function _notif_preexec() {
    _notif_cmd_start=$EPOCHSECONDS
    _notif_cmd_name="${${1## }%% *}"   # first word of command, strip leading spaces
  }

  function _notif_precmd() {
    local _exit=$?
    [[ $_notif_cmd_start -eq 0 ]] && return
    local _elapsed=$(( EPOCHSECONDS - _notif_cmd_start ))
    _notif_cmd_start=0
    # Only care about tmux windows and commands that actually took a while.
    [[ -z "$TMUX" || $_elapsed -lt 5 ]] && return
    # Skip when the user is still looking at this window.
    local _active
    _active=$(tmux display-message -p '#{window_active}' 2>/dev/null) || return
    [[ "$_active" == "1" ]] && return

    local _win
    _win=$(tmux display-message -p '#W' 2>/dev/null) || _win="tmux"

    if [[ $_exit -eq 0 ]]; then
      terminal-notifier \
        -title "✅ ${_notif_cmd_name} (${_elapsed}s)" \
        -subtitle "$_win" \
        -message "Finished successfully" \
        -sound "default" \
        &>/dev/null &!
    else
      terminal-notifier \
        -title "❌ ${_notif_cmd_name} (${_elapsed}s)" \
        -subtitle "$_win" \
        -message "Exited ${_exit}" \
        -sound "Basso" \
        &>/dev/null &!
    fi
  }

  add-zsh-hook preexec _notif_preexec
  add-zsh-hook precmd _notif_precmd
fi
{{- end }}

# Inject psvar[24] into PROMPT before pure's exec-time segment (%(19V.)).
# Uses psvar[24] to avoid colliding with pure's psvar[12-23] range.
# psvar[24] = AWS profile (shown when typing aws/terraform/tf commands).
# Runs once after OMZ/pure have initialized PROMPT.
function _aws_prompt_setup() {
  # Replace all %~ with ${_pure_path} (expanded by PROMPT_SUBST at render time)
  local _path_var='${_pure_path}'
  PROMPT="${PROMPT//\%\~/$_path_var}"
  # Inject psvar[24] (AWS profile) before pure's exec-time segment
  local before="${PROMPT%%\%[(]19V.*}"
  local after="${PROMPT#*\%[(]19V.}"
  [[ "$before" != "$PROMPT" ]] && PROMPT="${before}%(24V. %F{yellow}%24v%f.)%(19V.${after}"
}
_aws_prompt_setup
unfunction _aws_prompt_setup

function _aws_profile_prompt() {
  local first_word="${${BUFFER##[[:space:]]#}%% *}"
  if [[ -n "$AWS_PROFILE" && "$first_word" == (aws|terraform|tfplan|tf) ]]; then
    psvar[24]="$AWS_PROFILE"
  else
    psvar[24]=""
  fi
}
add-zle-hook-widget zle-line-pre-redraw _aws_profile_prompt

