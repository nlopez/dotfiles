# Set personal aliases, overriding those provided by Oh My Zsh libs,
# plugins, and themes. Aliases can be placed here, though Oh My Zsh
# users are encouraged to define aliases within a top-level file in
# the $ZSH_CUSTOM folder, with .zsh extension. Examples:
# - $ZSH_CUSTOM/aliases.zsh
# - $ZSH_CUSTOM/macos.zsh
# For a full list of active aliases, run `alias`.
#
# Example aliases
# alias zshconfig="mate ~/.zshrc"
# alias ohmyzsh="mate ~/.oh-my-zsh"

function _source() {
  [[ -f $1 ]] && source "$@"
}

# Reload: re-source .zprofile (PATH/env) then .zshrc so any
# chezmoi apply changes take effect without restarting the terminal.
alias reload='_source ~/.zprofile; _source ~/.zshrc'

function _command() {
  command -v $1 >/dev/null 2>&1
}

# Cache the output of slow shell-init binaries; regenerate when the binary changes.
function _cached_eval() {
  local name="$1"; shift
  local cache="${XDG_CACHE_HOME:-$HOME/.cache}/zsh/${name}.zsh"
  local bin
  bin=$(command -v "$1" 2>/dev/null)
  if [[ -n "$bin" && (! -f "$cache" || "$bin" -nt "$cache") ]]; then
    mkdir -p "${cache:h}"
    "$@" > "$cache" 2>/dev/null
  fi
  [[ -f "$cache" ]] && source "$cache"
}

# PATH, brew shellenv, and shell-env exports live in ~/.zprofile so they're
# available to non-interactive subshells too.

# shellcheck source=~/.zshrc_local
_source ~/.zshrc_local

{{- if lookPath "zabrze" }}
_cached_eval zabrze zabrze init --bind-keys
{{- end }}
