# Prevent pasted newlines from ever executing a command.
# bracketed-paste-magic intercepts terminal paste events, converts embedded
# newlines to spaces, and strips any trailing newline so the Enter key must
# be pressed deliberately to run a command.
autoload -Uz bracketed-paste-magic
zle -N bracketed-paste bracketed-paste-magic

autoload -U edit-command-line
zle -N edit-command-line
function _edit_command_line() { EDITOR="vim" zle edit-command-line }
zle -N _edit_command_line
bindkey '^xe' _edit_command_line
bindkey '^x^e' _edit_command_line

###############################################################################
# ── Helper: reload Pi in the *current* tmux pane safely ──────────────────────
# Sends C-c + Enter first to clear any partial prompt, then /reload.
pi-reload() {
   [[ -n "$TMUX" ]] || { echo "pi-reload: not in tmux."; return 1; }
  local pane="$TMUX_PANE"
  echo "pi-reload: clearing buffer then reloading pane $pane."
  tmux send-keys -t "$pane" C-c
  tmux send-keys -t "$pane" Enter
  tmux send-keys -t "$pane" "/reload" Enter
  echo "pi-reload: done."
}

# ── Reloader: send /reload to *all* tmux panes running Pi ────────────────────
#   Clears buffer before /reload to avoid corrupting partial prompts.
pi-reload-all() {
   [[ -n "${TMUX:-}" ]] || { echo "pi-reload-all: not in tmux."; return 1; }
   local found=false
   while IFS=' ' read -r pane_id pane_pid; do
     if pgrep -P "$pane_pid" -f "^pi " >/dev/null 2>&1; then
       found=true
       echo "pi-reload-all: reloading pane $pane_id (pid $pane_pid)"
       tmux send-keys -t "$pane_id" C-c
       tmux send-keys -t "$pane_id" Enter
       tmux send-keys -t "$pane_id" "/reload" Enter
     fi
   done < <(tmux list-panes -a -F '#{pane_id} #{pane_pid}')
  $found || echo "pi-reload-all: no running pi sessions found."
}


