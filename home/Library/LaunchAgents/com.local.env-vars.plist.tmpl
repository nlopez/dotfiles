{{- if and (eq .chezmoi.os "darwin") (not .headless) -}}
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.local.env-vars</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>-c</string>
        <string>launchctl unsetenv CLAUDE_CONFIG_DIR &amp;&amp; launchctl setenv CODEX_HOME '{{ .chezmoi.homeDir }}/.config/codex' &amp;&amp; launchctl setenv ENGRAM_DATA_DIR '{{ .chezmoi.homeDir }}/.local/share/engram'</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>{{ .chezmoi.homeDir }}/.local/state/env-vars.log</string>
    <key>StandardErrorPath</key>
    <string>{{ .chezmoi.homeDir }}/.local/state/env-vars.log</string>
</dict>
</plist>
{{- end }}
