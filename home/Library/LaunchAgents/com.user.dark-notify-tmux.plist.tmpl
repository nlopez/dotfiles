<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.user.dark-notify-tmux</string>
	<key>ProgramArguments</key>
	<array>
		<string>/opt/homebrew/bin/dark-notify</string>
		<string>--exec</string>
		<string>{{ .chezmoi.homeDir }}/.config/tmux/scripts/set-theme.sh</string>
	</array>
	<key>RunAtLoad</key>
	<false/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/tmp/dark-notify-tmux.log</string>
	<key>StandardErrorPath</key>
	<string>/tmp/dark-notify-tmux.log</string>
</dict>
</plist>
