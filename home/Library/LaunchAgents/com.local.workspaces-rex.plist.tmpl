{{- if and .work (not .headless) -}}
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.local.workspaces-rex</string>
    <key>ProgramArguments</key>
    <array>
        <string>{{ .chezmoi.homeDir }}/.local/bin/workspaces-rex</string>
        <string>supervise</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>LANG</key>
        <string>en_US.UTF-8</string>
        <!-- uv runs the script; the tunnels' ssh runs the workspaces CLI's ProxyCommand,
             so its /opt/<package manager>/bin dir is found at apply time. -->
        <key>PATH</key>
        <string>{{ includeTemplate "nix-profile" . }}/bin:{{ range output "sh" "-c" "ls -d /opt/*/bin/workspaces 2>/dev/null || true" | splitList "\n" | compact }}{{ dir . }}:{{ end }}{{ .packages.darwin.brew_prefix }}/bin:{{ .chezmoi.homeDir }}/.local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>WorkingDirectory</key>
    <string>{{ .chezmoi.homeDir }}</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>30</integer>
    <key>StandardOutPath</key>
    <string>{{ .chezmoi.homeDir }}/.local/state/workspaces/rex/supervisor.log</string>
    <key>StandardErrorPath</key>
    <string>{{ .chezmoi.homeDir }}/.local/state/workspaces/rex/supervisor.log</string>
</dict>
</plist>
{{- end }}
