{{- /* zprofile runs once per login shell, before zshrc. PATH and env
       exports live here. Interactive-only setup (aliases, plugins,
       prompts, zle bindings) stays in zshrc. */ -}}

typeset -U path

export COLORTERM=truecolor

{{- if .work }}
export OP_ACCOUNT=datadog.1password.com
{{- else }}
export OP_ACCOUNT=my.1password.com
{{- end }}
{{- if .work }}

# Pi MCP adapter: Slack's pre-registered OAuth app expects callbacks on port
# 3118 (matching the Claude Code Slack app redirect URI).
export MCP_OAUTH_CALLBACK_PORT=3118
{{- end }}

{{- $brewPrefixes := list "/opt/homebrew" "/home/linuxbrew/.linuxbrew" "/usr/local" -}}
{{- $foundBrewPrefix := "" -}}
{{- range $brewPrefix := $brewPrefixes -}}
  {{- if and (not $foundBrewPrefix) (stat (printf "%s/bin/brew" $brewPrefix)) -}}
    {{- $foundBrewPrefix = $brewPrefix -}}
  {{- end -}}
{{- end }}
{{- if $foundBrewPrefix }}

fpath+=("{{ $foundBrewPrefix }}/share/zsh/site-functions")
eval "$({{ $foundBrewPrefix }}/bin/brew shellenv)"
{{ end }}
{{- if eq .chezmoi.os "darwin" }}
# Prepend GNU tool gnubin directories so GNU utils win over BSD/macOS system
# tools. Driven by the gnu_tools list in .chezmoidata/darwin/packages.yaml.
# HOMEBREW_PREFIX is set above by brew shellenv.
path=(
{{- range .packages.darwin.gnu_tools }}
    "${HOMEBREW_PREFIX}/opt/{{ . }}/libexec/gnubin"
{{- end }}
    $path
)
{{- end }}
{{- $homeDir := .chezmoi.homeDir }}

# Dynamic PATH additions — checked at every login/reload, so new tool
# installations (cargo, go, etc.) show up without needing chezmoi apply.
for _d in \
  "$HOME/go/bin" \
  "$HOME/.cargo/bin" \
{{- if .work }}
  "/opt/dogbrew/bin" \
{{- end }}
; do
  [[ -d "$_d" ]] && path=("$_d" $path)
done
unset _d

export XDG_DATA_HOME=$HOME/.local/share
export XDG_CONFIG_HOME=$HOME/.config
export XDG_STATE_HOME=$HOME/.local/state
export XDG_CACHE_HOME=$HOME/.cache

export HOMEBREW_NO_AUTO_UPDATE=1
export HOMEBREW_NO_ENV_HINTS=1
export HOMEBREW_AUTO_UPDATE_SECS=86400
export HOMEBREW_NO_ANALYTICS=1
export HOMEBREW_VERIFY_ATTESTATIONS=1
export HOMEBREW_NO_INSECURE_REDIRECT=1
export HOMEBREW_CASK_OPTS="--require-sha"

export GH_TELEMETRY=false
export GH_NO_UPDATE_NOTIFIER=1
export PI_SKIP_VERSION_CHECK=1
export PI_OFFLINE=1

# Supply-chain security: every shell starts with a fresh "N days ago" cutoff.
# npm/pnpm honor $npm_config_before; uv honors $UV_EXCLUDE_NEWER.
zmodload zsh/datetime
strftime -s _sc_cutoff '%Y-%m-%d' $(( EPOCHSECONDS - {{ .supplyChainDelayDays }} * 86400 ))
export npm_config_before="$_sc_cutoff"
export UV_EXCLUDE_NEWER="$_sc_cutoff"
unset _sc_cutoff

export LESS="-FRX"
export AWS_PAGER=""

export SSH_AUTH_SOCK="{{ .platform.ssh_auth_sock }}"

export PNPM_HOME="${XDG_DATA_HOME}/pnpm"
path=($PNPM_HOME/bin $path)

# Prepend ~/.local/bin last so shims here take priority over everything else.
path=({{ joinPath $homeDir ".local/bin" }} $path)
export TENV_AUTO_INSTALL=true
export TFENV_AUTO_INSTALL=true
export GOPATH="${XDG_DATA_HOME}/go"
export VISUAL="zed"
export EDITOR="vi"

{{- if .work }}
export AWS_VAULT_KEYCHAIN_NAME=login
{{- end }}

# Set on all machines — Automation vault (Kagi API)
export KAGI_API_KEY={{ onepasswordRead "op://evjh25ux2mnoufaut6qhvm2pdi/6neql3vd2izldv7jeosqaip7ci/credential" "my.1password.com" }}

