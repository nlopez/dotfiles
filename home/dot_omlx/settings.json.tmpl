{{/* omlx settings — dynamic values from chezmoi data + 1Password */}}
{
  "version": "1.0",
  "server": {
    "host": {{ .omlx.server.host | quote }},
    "port": {{ .omlx.server.port }},
    "log_level": {{ .omlx.server.log_level | quote }},
    "cors_origins": [
      "*"
    ],
    "server_aliases": [
      "localhost",
      "127.0.0.1",
      {{ .chezmoi.hostname | quote }},
      {{ printf "%s.local" .chezmoi.hostname | quote }},
      "192.0.0.2",
      "100.102.45.26"
    ]
  },
  "model": {
    "model_dirs": [
      {{ printf "%s/.omlx/models" .chezmoi.homeDir | quote }}
    ],
    "model_dir": {{ printf "%s/.omlx/models" .chezmoi.homeDir | quote }},
    "max_model_memory": "auto",
    "model_fallback": false
  },
  "memory": {
    "max_process_memory": "auto",
    "prefill_memory_guard": true
  },
  "scheduler": {
    "max_concurrent_requests": 8
  },
  "cache": {
    "enabled": true,
    "hot_cache_only": false,
    "ssd_cache_dir": null,
    "ssd_cache_max_size": "auto",
    "hot_cache_max_size": "0",
    "initial_cache_blocks": 256
  },
  "auth": {
    "api_key": {{ onepasswordRead "op://evjh25ux2mnoufaut6qhvm2pdi/6fg66ce5a7kqnwhyuwmichp7ry/api_key" "my.1password.com" | quote }},     {{/* oMLX */}}
    "secret_key": {{ onepasswordRead "op://evjh25ux2mnoufaut6qhvm2pdi/6fg66ce5a7kqnwhyuwmichp7ry/secret_key" "my.1password.com" | quote }}, {{/* oMLX */}}
    "skip_api_key_verification": false,
    "sub_keys": []
  },
  "mcp": {
    "config_path": null
  },
  "huggingface": {
    "endpoint": ""
  },
  "modelscope": {
    "endpoint": ""
  },
  "network": {
    "http_proxy": "",
    "https_proxy": "",
    "no_proxy": "",
    "ca_bundle": ""
  },
  "sampling": {
    "max_context_window": {{ .omlx.sampling.max_context_window }},
    "max_tokens": {{ .omlx.sampling.max_tokens }},
    "temperature": {{ .omlx.sampling.temperature }},
    "top_p": {{ .omlx.sampling.top_p }},
    "top_k": {{ .omlx.sampling.top_k }},
    "repetition_penalty": {{ .omlx.sampling.repetition_penalty }}
  },
  "logging": {
    "log_dir": null,
    "retention_days": 7
  },
  "claude_code": {
    "context_scaling_enabled": false,
    "target_context_size": 200000,
    "mode": "cloud",
    "opus_model": null,
    "sonnet_model": null,
    "haiku_model": null
  },
  "integrations": {
    "codex_model": null,
    "opencode_model": null,
    "openclaw_model": null,
    "pi_model": {{ .omlx.integrations.pi_model | quote }},
    "openclaw_tools_profile": {{ .omlx.integrations.openclaw_tools_profile | quote }}
  },
  "ui": {
    "language": "en"
  },
  "idle_timeout": {
    "idle_timeout_seconds": null
  }
}
