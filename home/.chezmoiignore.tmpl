!.oh-my-zsh/plugins
{{ range .zshPlugins }}
!.oh-my-zsh/plugins/{{ . }}
!.oh-my-zsh/plugins/{{ . }}/**
{{- end }}
.oh-my-zsh/cache/**
.oh-my-zsh/plugins/**
.oh-my-zsh/templates/**
.oh-my-zsh/custom/themes/powerlevel10k/**/*.zwc

# OMLX: ignore runtime-generated files (keep settings.json).
.omlx/cache/**
.omlx/logs/**
.omlx/models/**
.omlx/stats.json

# Ignore scripts for different operating systems.
{{ if ne .chezmoi.os "darwin" }}
.chezmoiscripts/darwin/**
Library/Application Support/espanso/**
{{ end }}

{{ if or (eq .chezmoi.os "darwin") (eq .chezmoi.os "aurora") }}
.chezmoiscripts/linux/**
{{ end }}

{{ if or (eq .chezmoi.os "darwin") (eq .chezmoi.os "linux") }}
.chezmoiscripts/aurora/**
{{ end }}


{{ if .headless }}
.config/zed
.config/ghostty
{{ end }}

{{ if not .work }}
.pi/agent/mcp.json
{{ end }}

{{ if not .personal }}
.config/rclone/rclone.conf
{{ end }}

# ---------------------------------------------------------------------------
# age encryption: exclude the other machine class's secrets directory so
# chezmoi never attempts to decrypt files it doesn't have the key for.
{{ if not .work -}}
.config/work-secrets
{{ end -}}
{{ if not .personal -}}
.config/personal-secrets
{{ end -}}

# Git bookkeeping files used to track empty source directories — never deployed.
**/.gitkeep
