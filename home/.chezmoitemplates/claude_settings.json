{
  "autoUpdatesChannel": "stable",
  "cleanupPeriodDays": 90,
  "effortLevel": "medium",
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/bash-regex-permission.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.message // \"Claude is waiting for your input\"' | { read -r msg; terminal-notifier -title \"Claude Code\" -subtitle \"Input Required\" -message \"$msg\" -sound default -timeout 10; } 2>/dev/null || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "terminal-notifier -title \"Claude Code\" -subtitle \"Session Complete\" -message \"Finished working in $(basename \"$PWD\")\" -sound default -timeout 10"
          }
        ]
      }
    ]
  },
  "permissions": {
    "defaultMode": "acceptEdits"
  },
  "skipAutoPermissionPrompt": true,
  "theme": "light"
}
