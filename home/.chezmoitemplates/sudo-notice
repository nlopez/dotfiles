{{- /* Shell line that says why the next sudo call is needed, printed only when
   sudo will prompt for a password. Usage: {{ template "sudo-notice" "<purpose>" }} */ -}}
sudo -n true 2>/dev/null || printf '\033[0;31m==>\033[0m sudo: %s\n' {{ quote . }} >&2
{{- /* trims the file's final newline */ -}}
