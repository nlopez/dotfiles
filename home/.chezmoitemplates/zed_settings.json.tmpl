// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "search": {
    "include_ignored": true
  },
  "cli_default_open_behavior": "new_window",
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "right"
  },
  "collaboration_panel": {
    "dock": "right"
  },
  "git_panel": {
    "dock": "left"
  },
  "format_on_save": "off",
  "session": {
    "trust_all_worktrees": true
  },
  "auto_update": false,
  "cursor_shape": "block",
  "agent_servers": {
    "claude-acp": {
      "type": "registry",
      "default_config_options": {
        "effort": "medium",
        "model": "default",
        "mode": "acceptEdits"
      }
    }
  },
  "edit_predictions": {
    "provider": "copilot"
  },
  "autosave": "on_focus_change",
  "agent": {
    "flexible": true,
    "notify_when_agent_waiting": "primary_screen",
    "dock": "right",
    "single_file_review": true,
    "profiles": {},
    "default_model": {
      "provider": "anthropic",
      "model": "claude-sonnet-4-6-latest",
      "enable_thinking": false
    },
    "favorite_models": [],
    "model_parameters": []
  },
  "ui_font_family": ".ZedSans",
  "buffer_font_family": "Iosevka Nerd Font",
  "terminal": {
    "font_family": "IosevkaTerm Nerd Font Propo"
  },
  "tab_size": 2,
  "ssh_connections": [
    {
      "host": "github.com",
      "args": [],
      "projects": []
    }
  ],
  "wsl_connections": [
    {
      "distro_name": "Ubuntu",
      "user": null,
      "projects": []
    }
  ],
  "ui_font_size": 16,
  "buffer_font_size": 16,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "One Dark"
  },
  "auto_install_extensions": {
    "csv": true,
    "dockerfile": true,
    "git-firefly": true,
    "make": true,
    "sql": true,
    "terraform": true,
    "toml": true,
    "xml": true
  },
  "file_types": {
    "TOML": ["*.toml.tmpl"]
  },
  "languages": {
    "Go": {
      "language_servers": ["!gopls"]
    },
    "Terraform": {
      "language_servers": ["!terraform-ls"]
    },
    "SQL": {
      "formatter": {
        "external": {
          "command": "sql-formatter",
          "arguments": ["--language", "mysql"]
        }
      }
    },
    "YAML": {
      "formatter": {
        "external": {
          "command": "yamlfmt",
          "arguments": ["-"]
        }
      }
    }
  }
}
