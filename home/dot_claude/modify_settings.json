{{- /* chezmoi:modify-template */ -}}
{{- $existing := .chezmoi.stdin | fromJson -}}
{{- $managed := include ".chezmoitemplates/claude_settings.json" | fromJson -}}
{{- /* Preserve runtime-configurable fields that /config may update */ -}}
{{- range list "model" "effortLevel" "theme" -}}
  {{- if hasKey $existing . -}}
    {{- $_ := set $managed . (get $existing .) -}}
  {{- end -}}
{{- end -}}
{{- if hasKey $existing "permissions" -}}
  {{- $existingPerms := get $existing "permissions" -}}
  {{- if hasKey $existingPerms "defaultMode" -}}
    {{- $managedPerms := get $managed "permissions" -}}
    {{- $_ := set $managedPerms "defaultMode" (get $existingPerms "defaultMode") -}}
  {{- end -}}
{{- end -}}
{{- if .work -}}
  {{- $plugins := get $managed "enabledPlugins" -}}
  {{- $_ := set $plugins "dual-agents-review@datadog-claude-plugins" true -}}
  {{- $marketplaces := get $managed "extraKnownMarketplaces" | default dict -}}
  {{- $_ := set $marketplaces "datadog-claude-plugins" (dict "source" (dict "source" "git" "url" "https://github.com/DataDog/claude-marketplace.git")) -}}
  {{- $_ := set $managed "extraKnownMarketplaces" $marketplaces -}}
  {{- $mcpServers := get $managed "mcpServers" | default dict -}}
  {{- $_ := set $mcpServers "datadog" (dict "type" "http" "url" "https://mcp.datadoghq.com/api/unstable/mcp-server/mcp") -}}
  {{- $_ := set $managed "mcpServers" $mcpServers -}}
{{- end -}}
{{- $managed | toPrettyJson -}}
